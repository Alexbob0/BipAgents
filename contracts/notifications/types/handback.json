{
  "$schema": "../schema.json",
  "type": "handback",
  "audit_row": 3,
  "summary": "A task's or sub-task's result handed back into the agent's Bot Chat.",
  "producers": [
    "handback.rs:645 -> notify_reply with run_id session:<request.session>"
  ],
  "policy": {
    "per_agent_switch": true
  },
  "v2": {
    "t": "reply",
    "c": "main or t_<thread>",
    "m": "m_<message id>",
    "loc_key": "notif.reply",
    "collapse": "n",
    "link": "bipagents://open?agent=vie&c=main&m=m_<message id>&t=reply",
    "notes": "Pointer shape: docs/conversations.md §9.3 (conv-core)."
  },
  "variants": [
    {
      "name": "default",
      "about": "Hand-back in Bot Chat.",
      "bridge": {
        "agent": "vie",
        "context": {
          "title": "Vie",
          "lang": "fr"
        },
        "input": {
          "fn": "notify_reply",
          "args": {
            "run_id": "session:sess_main",
            "text": "La tâche « Billets » est finie : 2 options trouvées.",
            "session_id": "sess_main"
          }
        },
        "pointer": {
          "n": "n_contract",
          "thread": "t_contract",
          "message": "m_contract",
          "badge": 1
        }
      },
      "payload": {
        "aps": {
          "alert": {
            "loc-key": "notif.reply",
            "body": "notif.reply"
          },
          "thread-id": "vie/t_contract",
          "mutable-content": 1,
          "category": "MESSAGE",
          "sound": "default",
          "badge": 1
        },
        "v": 2,
        "n": "n_contract",
        "t": "reply",
        "agent": "vie",
        "c": "t_contract",
        "m": "m_contract",
        "r": "session:sess_main"
      },
      "push": {
        "push_type": "alert",
        "priority": 10,
        "collapse_id": null
      }
    }
  ]
}
