          },
          "thread-id": "vie/t_contract",
          "mutable-content": 1,
          "category": "MESSAGE",
          "sound": "default",
          "badge": 1
        },
        "v": 2,
        "n": "n_contract",
        "t": "email_held",
        "agent": "vie",
        "c": "t_contract",
        "r": "held_1"
