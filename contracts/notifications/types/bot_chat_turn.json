{
  "$schema": "../schema.json",
  "type": "bot_chat_turn",
  "audit_row": 2,
  "summary": "An autonomous turn in the agent's main thread (Bot Chat), seen by the cron watcher.",
  "producers": [
    "cronwatch.rs poll_bot_chat (~762) -> notify_reply with run_id session:<sid>"
  ],
  "policy": {
    "per_agent_switch": true
  },
  "v2": {
    "t": "reply",
    "c": "main",
    "m": "<Hermes message id>",
    "loc_key": "notif.reply",
    "collapse": "n",
    "link": "bipagents://open?agent=vie&c=main&m=<id>&t=reply"
  },
  "known_bugs": [
    "Same collapse id (session:<sid>) and same Android notification id: each autonomous reply replaces the previous one.",
    "Duplicate with reply when the run was followed more than 600 s ago (followed_recently)."
  ],
  "variants": [
    {
      "name": "previews_off",
      "about": "Bot Chat turn, previews off.",
      "bridge": {
        "agent": "vie",
        "context": {
          "title": "Vie",
          "previews": false,
          "lang": "fr"
        },
        "input": {
          "fn": "notify_reply",
          "args": {
            "run_id": "session:sess_bot",
            "text": "Bonjour ! Ton point du matin est prêt.",
            "session_id": "sess_bot",
            "reply_id": "r4"
          }
        }
      },
      "payload_v1": null,
      "fcm_data": null,
      "push": null,
      "relay": {
        "body": "Ta réponse est prête."
      },
      "expect": {
        "screen": "conversation",
        "conversation": "sess_bot",
        "message": "focus by reply text / date",
        "ios": {
          "shared_agent": false,
          "needs_run_session": false,
          "route": {
            "route": "conversation",
            "session": "sess_bot",
            "focus": true
          },
          "nse_fetch": "reply",
          "presents_as_message": true
        },
        "android": {
          "kind": "agent",
          "open": {
            "page": "conversation",
            "session": "sess_bot",
            "focus": true
          },
          "channel": "messages",
          "notification_key": "session:sess_bot",
          "actions": [
            "reply"
          ],
          "missed_reply": true,
          "presents_as_message": true,
          "fetch": "reply"
        }
      }
    }
  ]
}
