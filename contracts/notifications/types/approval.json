{
  "$schema": "../schema.json",
  "type": "approval",
  "audit_row": 6,
  "summary": "Hermes waits for an approval (a command, a tool).",
  "producers": [
    "runs.rs push_unseen (~973), ~2060 -> notify_approval_values",
    "agent_shares.rs:1141 (agent shared by a relative)",
    "rooms.rs (room_id: a group discussion's turn)"
  ],
  "policy": {
    "per_agent_switch": false
  },
  "v2": {
    "t": "approval",
    "c": "s:<lineage root> | r:<room> | x:<shared conv>",
    "m": null,
    "loc_key": "notif.approval",
    "collapse": "request_id",
    "link": "bipagents://open?agent=vie&c=s:<root>&n=<journal id>&t=approval"
  },
  "known_bugs": [
    "Android: two approvals of one run share a notification id (hash of run_id): the second replaces the first.",
    "Nothing removes the notification when the approval is answered elsewhere."
  ],
