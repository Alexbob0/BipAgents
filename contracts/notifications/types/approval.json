{
  "$schema": "../schema.json",
  "type": "approval",
  "audit_row": 6,
  "summary": "Hermes waits for an approval (a command, a tool).",
  "producers": [
    "runs.rs push_unseen (~973), ~2060 -> notify_approval_values",
    "agent_shares.rs:1141 (agent shared by a relative)",
    "rooms.rs (room_id: a group discussion's turn)",
    "card_pay.rs urgent -> notify_payment_urgent (a turn nobody follows asks a card payment: urgent, « Payer »); urgent_pay.rs test_route (test)"
  ],
  "policy": {
    "per_agent_switch": false
  },
  "v2": {
    "t": "approval",
    "c": "t_<thread> | room:<id> | t_<thread> on the relative's bridge (agent <agent>__<household>)",
    "m": null,
    "loc_key": "notif.approval",
    "collapse": "request_id",
    "link": "bipagents://open?agent=vie&c=t_<thread>&n=<journal id>&t=approval",
    "notes": "Pointer shape: docs/conversations.md §9.3 (conv-core)."
  },
