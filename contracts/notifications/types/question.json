{
  "$schema": "../schema.json",
  "type": "question",
  "audit_row": 5,
  "summary": "The agent asks something mid-run (clarify) while nobody follows it.",
  "producers": [
    "runs.rs:~1929 -> notify_question"
  ],
  "policy": {
    "per_agent_switch": true
  },
  "v2": {
    "t": "question",
    "c": "s:<lineage root>",
    "m": "<Hermes message id of the question>",
    "loc_key": "notif.question",
    "collapse": "n",
    "link": "bipagents://open?agent=vie&c=s:<root>&m=<id>&t=question"
  },
  "known_bugs": [
    "The per-agent switch off silences questions: the agent waits unseen (policy decision for Alex)."
  ],
