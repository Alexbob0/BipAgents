{
  "$schema": "../schema.json",
  "type": "room_reply",
  "audit_row": 7,
  "summary": "An agent answered in a group discussion (« Discussion entre agents ») nobody looks at.",
  "producers": [
    "rooms.rs:~1959 -> notify_room"
  ],
  "policy": {
    "per_agent_switch": true
  },
  "v2": {
    "t": "room_reply",
    "c": "r:<room>",
    "m": "<room message id>",
    "loc_key": "notif.reply",
    "collapse": "n",
    "link": "bipagents://open?agent=vie&c=r:room_1&m=<id>&t=room_reply"
  },
  "known_bugs": [
    "Collapse per room: only the latest room reply is kept."
  ],
  "variants": [
    {
      "name": "previews_off",
      "about": "A room reply.",
      "bridge": {
        "agent": "vie",
        "context": {
          "title": "Vie",
          "previews": false,
          "lang": "fr"
        },
        "input": {
          "fn": "notify_room",
          "args": {
            "room_id": "room_1",
            "room_title": "Vacances",
            "text": "Je propose Lisbonne.",
            "reply_id": "r8"
          }
        }
      },
      "payload_v1": null,
      "fcm_data": null,
      "push": null,
      "relay": {
        "body": "Ta réponse est prête."
      },
      "expect": {
        "screen": "room",
        "conversation": "room_1",
        "message": "end of the room",
        "ios": {
          "shared_agent": false,
          "needs_run_session": false,
          "route": {
            "route": "room",
            "room": "room_1"
          },
          "nse_fetch": "reply",
          "presents_as_message": false
        },
        "android": {
          "kind": "agent",
          "open": {
            "page": "room",
            "room": "room_1"
          },
          "channel": "messages",
          "notification_key": "room:room_1",
          "actions": [],
          "missed_reply": false,
          "presents_as_message": false,
          "fetch": "reply"
        }
      }
    }
  ]
}
