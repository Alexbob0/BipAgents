          }
        },
        "pointer": {
          "n": "n_contract",
          "thread": "t_contract",
          "message": "m_contract",
          "badge": 1
        }
      },
      "payload": {},
      "push": {
        "push_type": "alert",
        "priority": 10,
        "collapse_id": "secret_request:card_2"
      }
    },
    {
