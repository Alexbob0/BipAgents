{
  "$schema": "../schema.json",
  "type": "card",
  "audit_row": 15,
  "summary": "A connector's, a secret's or a mail connector's card waits for the person's accord.",
  "producers": [
    "connectors.rs:595 (connector_request)",
    "connectors.rs:1236 (secret_request)",
    "agent_tools.rs:1428 (mail_request) -> notify_bridge_card"
  ],
  "policy": {
    "per_agent_switch": false
  },
  "v2": {
    "t": "connector | secret | mail_card",
    "c": "none",
    "m": null,
    "loc_key": "notif.card",
    "collapse": "n",
    "link": "bipagents://open?agent=vie&n=<journal id>&t=connector",
    "notes": "Pointer shape: docs/conversations.md §9.3 (conv-core)."
  },
  "variants": [
    {
      "name": "connector",
      "about": "A connector's approval card.",
      "bridge": {
        "agent": "vie",
        "context": {
          "title": "Vie",
          "lang": "fr"
        },
        "input": {
          "fn": "notify_bridge_card",
          "args": {
            "line": "Garmin veut se connecter",
            "key": "connector_request",
            "id": "card_1"
          }
        },
        "pointer": {
          "n": "n_contract",
          "thread": "t_contract",
          "message": "m_contract",
          "badge": 1
        }
      },
      "payload": {},
      "push": {
        "push_type": "alert",
        "priority": 10,
        "collapse_id": "connector_request:card_1"
      }
    },
    {
      "name": "secret",
      "about": "A secret card (previews on).",
