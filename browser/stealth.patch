+            await self._close_proxy_forwarder(instance_id)
+        except Exception:
+            pass
+        try:
+            uc.util.get_registered_instances().discard(browser)
+        except Exception:
+            pass
+        self._spawn_diagnostics.pop(instance_id, None)
+        self._bip_intercepted.discard(instance_id)
+        persistent_storage.remove_instance(instance_id)
+        return True
 
