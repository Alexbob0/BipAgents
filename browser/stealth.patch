+# ---- BipAgents patch (browser/stealth.patch): one browser per agent, in its own container ----
+# STEALTH_CDP_PORT: the first Chrome started listens on this DevTools port, so Hermes (browser.cdp_url) and its vault
+# fill drive the same browser. nodriver connects instead of launching when given a host and port, so only its choice
+# of a free port is replaced, for the time of the launch. Later instances (or a port already taken) keep a random one.
+_fixed_port_lock = asyncio.Lock()
+
+
+def _port_free(port: int) -> bool:
+    import socket
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        # As Chrome does when it listens: a port left in TIME_WAIT by the Chrome just closed (for about a minute)
+        # is free for it. Without this, a browser restarted within that minute got a random port Hermes did not
+        # know. A port another Chrome listens on is still refused.
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        try:
+            sock.bind(("127.0.0.1", port))
+            return True
+        except OSError:
+            return False
+
+
+def _patient_connection(config) -> None:
+    """STEALTH_CONNECT_SECONDS (default 45): how long nodriver waits for a starting Chrome's DevTools. Its own default,
+    10 tries 0.25 s apart, gives up after about 3 s: on a loaded server (several browsers starting, memory in swap) a
+    cold Chrome takes far longer, so the first spawn_browser failed and the agent tried again, each try another Chrome."""
+    raw = os.environ.get("STEALTH_CONNECT_SECONDS", "").strip()
+    seconds = float(raw) if raw.replace(".", "", 1).isdigit() else 45.0
+    if hasattr(config, "browser_connection_max_tries"):
+        config.browser_connection_timeout = 0.5
+        config.browser_connection_max_tries = max(1, int(seconds / 0.5))
+
+
+def _chrome_answers(port: int) -> bool:
+    import urllib.request
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=2) as response:
+            return response.status == 200
+    except OSError:
+        return False
+
+
+async def _start_on_fixed_port(config):
+    _patient_connection(config)
+    raw = os.environ.get("STEALTH_CDP_PORT", "").strip()
+    if not raw.isdigit():
+        return await uc.start(config=config)
+    port = int(raw)
+    async with _fixed_port_lock:
+        if not _port_free(port):
+            if _chrome_answers(port):
+                # A Chrome the person opened from the app (open_browser.sh) on this profile and port: connected to,
+                # never launched a second time (Chrome's singleton would hand the launch over to it, and exit).
+                config.host, config.port = "127.0.0.1", port
+                return await uc.start(config=config)
+            debug_logger.log_warning("browser_manager", "spawn_browser",
+                                     f"STEALTH_CDP_PORT {port} already in use: random debugging port for this instance")
+            return await uc.start(config=config)
+        from nodriver.core import util as nd_util
+        original = nd_util.free_port
+        nd_util.free_port = lambda: port
+        try:
+            return await uc.start(config=config)
+        finally:
+            nd_util.free_port = original
+
+
+def _apply_container_defaults(options) -> None:
+    """What the agent leaves out, from the container: its persistent profile (STEALTH_USER_DATA_DIR), launch flags
+    (STEALTH_BROWSER_ARGS, separated by « ; », added after the caller's) and time zone (STEALTH_TIMEZONE). An agent then
+    starts the right browser with spawn_browser() and no arguments. STEALTH_HEADFUL=1: the browser always shows on the
+    container's screen, where the person watches it, even when the agent asks for headless."""
+    if os.environ.get("STEALTH_HEADFUL") == "1":
+        options.headless = False
+    if not options.user_data_dir and os.environ.get("STEALTH_USER_DATA_DIR"):
+        options.user_data_dir = os.environ["STEALTH_USER_DATA_DIR"]
+    extra = [a.strip() for a in os.environ.get("STEALTH_BROWSER_ARGS", "").split(";") if a.strip()]
+    given = {a.split("=", 1)[0] for a in options.browser_args}
+    options.browser_args = list(options.browser_args) + [a for a in extra if a.split("=", 1)[0] not in given]
+    if not options.timezone_id and os.environ.get("STEALTH_TIMEZONE"):
+        options.timezone_id = os.environ["STEALTH_TIMEZONE"]
+
+
+def _without_dropped_args(args):
+    """STEALTH_DROP_ARGS (« ; »-separated): flags added for containers that this one does not need, e.g. --single-process
+    and --disable-gpu, which make Chrome fragile and easy to tell apart from a person's browser."""
+    dropped = {a.strip() for a in os.environ.get("STEALTH_DROP_ARGS", "").split(";") if a.strip()}
+    return [a for a in args if a not in dropped]
+
+
 class BrowserManager:
     """Manages multiple browser instances."""
 
