+        browser = data["browser"]
+        if not keep_pages and not _connection_lost(browser):
+            try:
+                blank = await asyncio.wait_for(browser.get("about:blank", new_tab=True), timeout=10)
+                await browser.update_targets()
+                for tab in list(browser.tabs):
+                    if self._get_tab_target_id(tab) != self._get_tab_target_id(blank):
+                        try:
+                            await tab.close()
+                        except Exception:
+                            pass
+                _write_state(tab=self._get_tab_target_id(blank))
+            except Exception as e:
+                debug_logger.log_warning("browser_manager", "release", f"pages not closed: {e}")
+        try:
+            await dynamic_hook_system.cleanup_instance(instance_id)
+        except Exception:
+            pass
+        for connection in [getattr(browser, "connection", None), *getattr(browser, "targets", [])]:
