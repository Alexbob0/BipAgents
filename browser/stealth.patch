+    async def _bip_attach(self, instance_id: str, options: Optional[BrowserOptions] = None) -> None:
+        """The agent's id from an earlier server (or a Chrome that closed since): connected to the container's
+        Chrome again, started if none runs, on the tab it last used."""
+        async with self._bip_attach_lock:
+            async with self._lock:
+                data = self._instances.get(instance_id)
+            if data is not None and not _connection_lost(data["browser"]):
+                return
+            if data is not None:
+                await self._bip_release(instance_id, keep_pages=True)
+            await self.spawn_browser(options or BrowserOptions(sandbox=False), instance_id=instance_id)
+
+    async def _bip_release(self, instance_id: str, keep_pages: bool) -> bool:
+        """An instance on the container's Chrome let go without quitting Chrome. keep_pages=False (the agent's
+        close_instance): its tabs closed, a blank one left (Chrome quits with its last tab). keep_pages=True (this
+        server ending, the idle reaper): only the connection goes; the next server finds the same pages."""
+        async with self._lock:
+            data = self._instances.pop(instance_id, None)
+        if data is None:
