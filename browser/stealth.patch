+# ---- BipAgents patch (browser/stealth.patch): one browser per agent, in its own container ----
+# STEALTH_CDP_PORT: the container's Chrome listens on this DevTools port, so Hermes (browser.cdp_url) and its vault
+# fill drive the same browser. nodriver connects instead of launching when given a host and port: spawn_browser
+# starts that Chrome apart (below) when none runs, then connects to it. A port taken by something else than a Chrome
+# falls back to nodriver's own launch on a random port.
+_fixed_port_lock = asyncio.Lock()
+
+
+def _port_free(port: int) -> bool:
+    import socket
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        # As Chrome does when it listens: a port left in TIME_WAIT by the Chrome just closed (for about a minute)
+        # is free for it. Without this, a browser restarted within that minute got a random port Hermes did not
+        # know. A port another Chrome listens on is still refused.
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        try:
+            sock.bind(("127.0.0.1", port))
+            return True
+        except OSError:
+            return False
+
+
+def _patient_connection(config) -> None:
+    """STEALTH_CONNECT_SECONDS (default 45): how long nodriver waits for a starting Chrome's DevTools. Its own default,
+    10 tries 0.25 s apart, gives up after about 3 s: on a loaded server (several browsers starting, memory in swap) a
+    cold Chrome takes far longer, so the first spawn_browser failed and the agent tried again, each try another Chrome."""
+    raw = os.environ.get("STEALTH_CONNECT_SECONDS", "").strip()
+    seconds = float(raw) if raw.replace(".", "", 1).isdigit() else 45.0
+    if hasattr(config, "browser_connection_max_tries"):
+        config.browser_connection_timeout = 0.5
+        config.browser_connection_max_tries = max(1, int(seconds / 0.5))
+
+
+def _chrome_answers(port: int) -> bool:
+    import urllib.request
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=2) as response:
+            return response.status == 200
+    except OSError:
+        return False
+
+
+OPEN_BROWSER = "/opt/stealth/open_browser.sh"
+# The agent's browser outlives this server: Hermes restarts its MCP servers (a gateway restart, a stdio reconnect, a
+# `hermes chat` that ends), and a Chrome started as this server's child died with it, the agent's page and instance
+# with it. So Chrome is started apart (open_browser.sh, detached: the container's first process adopts it), this
+# server only connects to it, and its instance keeps one id for the container's life (_STATE): after a restart, the
+# agent's next call with that id finds the same Chrome and the same page.
+_STATE = os.environ.get("STEALTH_STATE_FILE", "/tmp/bipagents-browser.json")
+_CHROME_LOCK = "/tmp/bipagents-chrome.lock"   # two servers (the gateway's, a `hermes chat`) never start two Chromes
+
+
+def _fixed_port() -> Optional[int]:
+    raw = os.environ.get("STEALTH_CDP_PORT", "").strip()
+    return int(raw) if raw.isdigit() else None
+
+
+def _read_state() -> dict:
+    try:
+        with open(_STATE) as handle:
+            state = json.load(handle)
+        return state if isinstance(state, dict) else {}
+    except (OSError, ValueError):
+        return {}
+
+
+def _write_state(**changes) -> None:
+    state = _read_state()
+    if all(state.get(key) == value for key, value in changes.items()):
+        return
+    state.update(changes)
+    try:
+        partial = f"{_STATE}.{os.getpid()}"
+        with open(partial, "w") as handle:
+            json.dump(state, handle)
+        os.replace(partial, _STATE)
+    except OSError as e:
+        debug_logger.log_warning("browser_manager", "state", f"instance state not saved: {e}")
+
+
+def _stable_instance_id() -> Optional[str]:
+    """The id the agent was given for this container's Chrome, if it was given one."""
+    if _fixed_port() is None:
+        return None
+    value = _read_state().get("instance_id")
+    return value if isinstance(value, str) and value else None
+
+
+def _shared_chrome(browser) -> bool:
+    """A Chrome this server connected to (on the fixed port) rather than launched: never quit with an instance."""
+    port = _fixed_port()
+    return (port is not None and getattr(browser, "_process", None) is None
+            and getattr(getattr(browser, "config", None), "port", None) == port)
+
+
+def _connection_lost(browser) -> bool:
+    websocket = getattr(getattr(browser, "connection", None), "websocket", None)
+    return websocket is not None and getattr(websocket, "close_code", None) is not None
+
+
+def _launch_detached(args) -> None:
+    """open_browser.sh with nodriver's own flags, in a session of its own and left behind at once: Chrome is never a
+    child of this server, so it stays when the server ends."""
+    import subprocess
+    subprocess.run(["sh", "-c", '"$0" "$@" </dev/null >/dev/null 2>&1 &', OPEN_BROWSER, *args],
+                   start_new_session=True, check=False, timeout=10)
+
+
+async def _wait_for_chrome(port: int, seconds: float) -> bool:
+    deadline = time.monotonic() + seconds
+    while time.monotonic() < deadline:
+        if await asyncio.to_thread(_chrome_answers, port):
+            return True
+        await asyncio.sleep(0.25)
+    return False
+
+
+class _FileLock:
+    def __init__(self, path: str):
+        self.path, self.handle = path, None
+
+    def __enter__(self):
+        import fcntl
+        self.handle = open(self.path, "a")
+        fcntl.flock(self.handle, fcntl.LOCK_EX)
+        return self
+
+    def __exit__(self, *exc):
+        import fcntl
+        fcntl.flock(self.handle, fcntl.LOCK_UN)
+        self.handle.close()
+
+
+async def _start_on_fixed_port(config):
+    _patient_connection(config)
+    port = _fixed_port()
+    if port is None:
+        return await uc.start(config=config)
+    raw = os.environ.get("STEALTH_CONNECT_SECONDS", "").strip()
+    seconds = float(raw) if raw.replace(".", "", 1).isdigit() else 45.0
+    async with _fixed_port_lock:
+        lock = _FileLock(_CHROME_LOCK)
+        await asyncio.to_thread(lock.__enter__)
+        try:
+            if not await asyncio.to_thread(_chrome_answers, port):
+                if not _port_free(port):
+                    debug_logger.log_warning("browser_manager", "spawn_browser",
+                                             f"STEALTH_CDP_PORT {port} already in use: random debugging port for this instance")
+                    return await uc.start(config=config)
+                # None runs yet: started apart with the flags nodriver would have used, then connected to like a
+                # Chrome the person opened from the app (open_browser.sh with no flags).
+                config.host, config.port = "127.0.0.1", port
+                _launch_detached(_without_dropped_args(config()))
+                if not await _wait_for_chrome(port, seconds):
+                    raise Exception(f"Chrome did not open its DevTools on port {port} within {seconds:.0f} s")
+            config.host, config.port = "127.0.0.1", port
+            return await uc.start(config=config)
+        finally:
+            lock.__exit__(None, None, None)
+
+
+def _apply_container_defaults(options) -> None:
+    """What the agent leaves out, from the container: its persistent profile (STEALTH_USER_DATA_DIR), launch flags
+    (STEALTH_BROWSER_ARGS, separated by « ; », added after the caller's) and time zone (STEALTH_TIMEZONE). An agent then
+    starts the right browser with spawn_browser() and no arguments. STEALTH_HEADFUL=1: the browser always shows on the
+    container's screen, where the person watches it, even when the agent asks for headless."""
+    if os.environ.get("STEALTH_HEADFUL") == "1":
+        options.headless = False
+    if not options.user_data_dir and os.environ.get("STEALTH_USER_DATA_DIR"):
+        options.user_data_dir = os.environ["STEALTH_USER_DATA_DIR"]
+    extra = [a.strip() for a in os.environ.get("STEALTH_BROWSER_ARGS", "").split(";") if a.strip()]
+    given = {a.split("=", 1)[0] for a in options.browser_args}
+    options.browser_args = list(options.browser_args) + [a for a in extra if a.split("=", 1)[0] not in given]
+    if not options.timezone_id and os.environ.get("STEALTH_TIMEZONE"):
+        options.timezone_id = os.environ["STEALTH_TIMEZONE"]
+
+
+def _without_dropped_args(args):
+    """STEALTH_DROP_ARGS (« ; »-separated): flags added for containers that this one does not need, e.g. --single-process
+    and --disable-gpu, which make Chrome fragile and easy to tell apart from a person's browser."""
+    dropped = {a.strip() for a in os.environ.get("STEALTH_DROP_ARGS", "").split(";") if a.strip()}
+    return [a for a in args if a not in dropped]
+
+
+async def _bip_last_tab(browser):
+    """In a Chrome connected to again, the tab the agent last used (its target id in _STATE), if it is still open."""
+    if not _shared_chrome(browser):
+        return None
+    wanted = _read_state().get("tab")
+    if not wanted:
+        return None
+    try:
+        await browser.update_targets()
+        for tab in browser.tabs:
+            if str(getattr(getattr(tab, "target", None), "target_id", "")) == wanted:
+                return tab
+    except Exception as e:
+        debug_logger.log_warning("browser_manager", "last_tab", f"tabs not listed: {e}")
+    return None
+
+
