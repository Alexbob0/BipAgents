    "« %@ »" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“"
          }
        }
      }
    },
    "« Intelligent » : l’agent répond en vocal à un message vocal si tu as des écouteurs ou es en voiture, ou si tu le demandes (« réponds-moi en vocal »). « Écouter » sous chaque réponse génère le vocal à la demande. Pour une conversation en direct, utilise « Live ». Les Bips babillent quand tu joues avec eux (sauf en mode silencieux)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Smart”: the agent replies to a voice message by voice if you’re wearing headphones or driving, or if you ask (“answer me out loud”). “Listen” under each reply generates the audio on demand. For a real-time conversation, use “Live”. Bips babble when you play with them (except in silent mode)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Inteligente»: el agente responde con voz a un mensaje de voz si llevas auriculares o vas en coche, o si se lo pides («respóndeme con voz»). «Escuchar» bajo cada respuesta genera el audio cuando quieras. Para una conversación en directo, usa «Live». Los Bips balbucean cuando juegas con ellos (salvo en modo silencio)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Smart“: Der Agent antwortet per Sprachnachricht auf eine Sprachnachricht, wenn du Kopfhörer trägst oder im Auto bist – oder wenn du darum bittest („antworte mir per Sprache“). „Anhören“ unter jeder Antwort erzeugt die Sprachversion auf Wunsch. Für ein Gespräch in Echtzeit nutze „Live“. Die Bips plappern, wenn du mit ihnen spielst (außer im Stumm-Modus)."
          }
        }
      }
    },
    "« caféine demi-vie sommeil »" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
