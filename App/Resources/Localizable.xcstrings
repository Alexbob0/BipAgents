    "%@ n’a pas encore de routine. Par exemple : « Chaque lundi à 8:00, fais le point sur ma semaine »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no routine yet. For example: “Every Monday at 8:00, review my week”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no tiene rutinas. Por ejemplo: «Cada lunes a las 8:00, haz el balance de mi semana»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
