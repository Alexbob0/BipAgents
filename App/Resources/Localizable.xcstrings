    "Les check-ins et rappels de tes agents arriveront ici, avec leur version audio, ainsi que les réponses terminées pendant que tu étais ailleurs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-ins and reminders from your agents will land here, with their audio version, along with replies that finished while you were away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los check-ins y recordatorios de tus agentes llegarán aquí, con su versión en audio, junto con las respuestas terminadas mientras estabas en otra parte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-ins und Erinnerungen deiner Agenten landen hier, samt Audioversion – ebenso Antworten, die fertig wurden, während du weg warst."
          }
        }
      }
    },
