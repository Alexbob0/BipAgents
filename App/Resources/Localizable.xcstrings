    "Serveur" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server"
          }
        }
      }
    },
    "Tes agents remplissent eux-mêmes le formulaire de connexion, seulement sur le site enregistré. Ils ne voient jamais le mot de passe, et l’app ne le réaffiche jamais : tu peux le remplacer ou le supprimer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your agents fill in the login form themselves, only on the saved website. They never see the password, and the app never shows it again: you can replace or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes rellenan ellos mismos el formulario de inicio de sesión, solo en el sitio guardado. Nunca ven la contraseña, y la app no la vuelve a mostrar: puedes cambiarla o eliminarla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten füllen das Anmeldeformular selbst aus, nur auf der gespeicherten Website. Sie sehen das Passwort nie, und die App zeigt es nie wieder an: Du kannst es ersetzen oder löschen."
          }
        }
      }
    },
    "Un agent ne reçoit des identifiants que s’il a son propre espace sur le serveur : un agent qui partage le sien pourrait lire ceux des autres." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An agent gets logins only if it has its own space on the server: an agent that shares its space could read the others’."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente solo recibe accesos si tiene su propio espacio en el servidor: un agente que comparte el suyo podría leer los de los demás."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent erhält Zugänge nur mit einem eigenen Bereich auf dem Server: Ein Agent, der seinen teilt, könnte die der anderen lesen."
          }
        }
      }
    },
    "%@ n’est pas encore branché au coffre sur le serveur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not connected to the vault on the server yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no está conectado a la caja fuerte en el servidor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf dem Server noch nicht mit dem Tresor verbunden."
          }
        }
      }
    },
    "%@ partage son espace avec d’autres agents : il lui faut d’abord le sien." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ shares its space with other agents: it first needs one of its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ comparte su espacio con otros agentes: primero necesita uno propio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ teilt seinen Bereich mit anderen Agenten: Es braucht zuerst einen eigenen."
          }
        }
      }
    },
    "Le serveur n’a pas de bac à sable (podman) : l’espace de %@ ne protège pas encore ses mots de passe des autres agents." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server has no sandbox (podman): %@’s space does not protect its passwords from the other agents yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no tiene entorno aislado (podman): el espacio de %@ aún no protege sus contraseñas de los demás agentes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat keine Sandbox (podman): Der Bereich von %@ schützt seine Passwörter noch nicht vor den anderen Agenten."
          }
        }
      }
    },
    "Lui donner son propre espace" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give it its own space"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darle su propio espacio"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihm einen eigenen Bereich geben"
          }
        }
      }
