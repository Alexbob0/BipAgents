      }
    },
    "Ses conversations, sa mémoire et ses routines sont effacées du serveur. C’est définitif." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its conversations, memory and routines are erased from the server. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus conversaciones, su memoria y sus rutinas se borran del servidor. Es definitivo."
