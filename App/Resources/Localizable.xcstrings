      }
    },
    "Le technicien passe jeudi entre 8 h et 12 h, pense à laisser l’accès au garage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The technician is coming Thursday between 8 am and noon, remember to leave the garage open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El técnico pasa el jueves entre las 8:00 y las 12:00, acuérdate de dejar libre el acceso al garaje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Techniker kommt Donnerstag zwischen 8 und 12 Uhr – denk daran, die Garage offen zu lassen."
          }
        }
      }
    },
