    "Le serveur n’a pas pu créer cet agent. Réessaie dans un instant." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server couldn't create this agent. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no pudo crear este agente. Inténtalo de nuevo en un momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte diesen Agenten nicht erstellen. Versuch es gleich noch einmal."
          }
