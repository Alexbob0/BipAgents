+def _make_clarify_callback(self, run: _RunLaunch, *, _api_server) -> Callable[[list], dict]:
+    """clarify bridge for ``/v1/runs`` (symmetric to ``_make_approval_notify``), honouring
+    ``tools.clarify_tool``'s contract ``callback(questions) -> {"answers", "outcome", "notice"?}``:
+    register every question in ``tools.clarify_gateway`` under one ``request_id``, emit
+    ``clarify.request`` on the run's SSE stream, park the run as ``waiting_for_input`` and block the
+    agent thread until ``POST /v1/runs/{id}/clarify`` answers, the run is stopped, or
+    ``agent.clarify_timeout`` elapses."""
+    run_id, loop = run.run_id, asyncio.get_running_loop()
+    redact = _api_server.redact_sensitive_text
+
+    def _clarify(questions) -> dict:
+        from tools import clarify_gateway as clarify_mod
+        from tools.clarify_tool import strip_recommended
+        request_id = f"clr_{uuid.uuid4().hex[:12]}"
+        ids: Dict[str, str] = {}
+        wire_questions = []
+        for index, entry in enumerate(questions or []):
+            qid = str(entry.get("qid") or f"q{index}")
+            # Bare labels on the wire: "(Recommended)" is presentation, the client renders choice 0 first.
+            bare = [strip_recommended(str(c)) for c in (entry.get("choices_offered") or entry.get("choices") or [])]
+            clarify_id = f"{request_id}:{qid}"
+            clarify_mod.register(
+                clarify_id, run.approval_session_key, str(entry.get("question") or ""), bare or None,
+                bool(entry.get("multi_select")))
+            ids[qid] = clarify_id
+            wire_questions.append({
+                "id": qid, "question": redact(str(entry.get("question") or ""), force=True),
+                "choices": [redact(c, force=True) for c in bare],
+                "multi_select": bool(entry.get("multi_select")), "allow_other": True})
+        state: Dict[str, Any] = {"ids": ids, "answered": False, "cancelled": False}
+        self._run_clarify_requests.setdefault(run_id, {})[request_id] = state
+        event = _run_event(
+            run_id, "clarify.request", type="clarify.request", request_id=request_id, questions=wire_questions)
+        self._set_run_status(run_id, CLARIFY_WAITING_STATUS, last_event="clarify.request", clarify=event)
+        with suppress(Exception):
+            loop.call_soon_threadsafe(run.put_event, event)
+        timeout = float(clarify_mod.get_clarify_timeout())
+        deadline = None if timeout <= 0 else time.monotonic() + timeout
+        reply: Dict[str, Any] = {"answers": {}, "outcome": "submitted"}
+        reason: Optional[str] = None
+        try:
+            for qid, clarify_id in ids.items():
+                remaining = 0.0 if deadline is None else max(deadline - time.monotonic(), 0.01)  # <= 0 = unlimited
+                response = clarify_mod.wait_for_response(clarify_id, remaining)
+                if response is None or response == clarify_mod.CANCELLED or response == "":
+                    if run_id in self._stopping_run_ids:
+                        reason = "stopped"
+                    elif state["cancelled"]:
+                        reason = "cancelled"
+                    else:
+                        reason = "timeout" if response is None else "stopped"
+                    break
+                reply["answers"][qid] = None if response == clarify_mod.SKIPPED else response
+        finally:
+            # Keep the resolved request (answered/cancelled flags) until the run retires so a repeated POST
+            # gets 409 "already resolved" rather than 404; the table is dropped by _retire_live_run.
+            state["cancelled" if reason is not None else "answered"] = True
+            self._set_run_status(
+                run_id, "running", last_event="clarify.cancelled" if reason is not None else "clarify.responded")
+        if reason is not None:
+            clarify_mod.clear_session(run.approval_session_key)  # questions not yet waited on
+            with suppress(Exception):
+                loop.call_soon_threadsafe(run.put_event, _run_event(
+                    run_id, "clarify.cancelled", type="clarify.cancelled", request_id=request_id, reason=reason))
+            if reason == "timeout":
+                reply.update(outcome="timed_out",
+                             notice=f"The user did not answer within {int(timeout // 60) or 1} minutes.")
+            else:
+                reply.update(outcome="cancelled",
+                             notice="The run was stopped." if reason == "stopped"
+                             else "The user dismissed the question without answering.")
+        return reply
+
+    return _clarify
