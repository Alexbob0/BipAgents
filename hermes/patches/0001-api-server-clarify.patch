+async def _handle_run_clarify(self, request: "web.Request", *, _api_server) -> "web.Response":
+    """POST /v1/runs/{run_id}/clarify — answer (``{"request_id", "answers": {qid: text|[texts]|null}}``,
+    null = skip that question) or cancel (``{"request_id", "cancel": true}``) the run's pending clarify
