+    def test_origin_read_attaches_to_the_configured_browser_without_a_supervisor(self):
+        """A configured browser (browser.cdp_url) whose supervisor is gone, e.g. one an MCP server drives
+        or one that restarted: the origin read attaches to it again instead of asking the local
+        agent-browser daemon (which knows no such browser) and failing with "Could not determine the
+        current page origin"."""
+        from tools import browser_vault_tool
+
+        class Supervisor:
+            def evaluate_runtime(self, expression):
+                return {"ok": True, "result": "https://example.com/login"}
+
+        with patch("tools.browser_supervisor.SUPERVISOR_REGISTRY") as reg, \
+             patch("tools.browser_tool_cdp._get_cdp_override_raw", return_value="http://127.0.0.1:9222"), \
+             patch("tools.browser_tool_cdp._get_cdp_override",
+                   return_value="ws://127.0.0.1:9222/devtools/browser/current"), \
+             patch("tools.browser_tool_session._run_browser_command") as run_cmd:
+            reg.get.return_value = None
+            reg.get_or_start.return_value = Supervisor()
+            assert browser_vault_tool._current_page_origin("task-1") == "https://example.com"
+        assert reg.get_or_start.call_args.kwargs["cdp_url"] == "ws://127.0.0.1:9222/devtools/browser/current"
+        run_cmd.assert_not_called()
+
+    def test_supervisor_reattaches_to_the_configured_browser_after_it_restarted(self):
+        """The supervisor gave up and left the registry when the configured browser went away: the
+        re-attach resolves the configured endpoint afresh (a restarted Chromium has a new browser id)."""
+        from tools import browser_vault_tool
+
+        fresh = object()
+        with patch("tools.browser_supervisor.SUPERVISOR_REGISTRY") as reg, \
+             patch("tools.browser_tool_cdp._get_cdp_override_raw", return_value="http://127.0.0.1:9222"), \
+             patch("tools.browser_tool_cdp._get_cdp_override",
+                   return_value="ws://127.0.0.1:9222/devtools/browser/after-restart"), \
+             patch("tools.browser_tool_session._run_browser_command") as run_cmd:
+            reg.get.return_value = None
+            reg.get_or_start.return_value = fresh
+            assert browser_vault_tool._ensure_supervisor("task-1") is fresh
+        assert reg.get_or_start.call_args.kwargs["cdp_url"] == "ws://127.0.0.1:9222/devtools/browser/after-restart"
+        run_cmd.assert_not_called()
+
+    def test_without_a_configured_browser_the_local_session_endpoint_is_used_as_before(self):
+        from tools import browser_vault_tool
+
+        with patch("tools.browser_supervisor.SUPERVISOR_REGISTRY") as reg, \
+             patch("tools.browser_tool_cdp._get_cdp_override_raw", return_value=""), \
+             patch("tools.browser_tool_cdp._resolve_cdp_override", side_effect=lambda url: url + "/resolved"), \
+             patch("tools.browser_tool_session._run_browser_command",
+                   return_value={"success": True, "data": {"cdpUrl": "http://127.0.0.1:9333"}}):
+            reg.get.return_value = None
+            browser_vault_tool._ensure_supervisor("task-1")
+            assert reg.get_or_start.call_args.kwargs["cdp_url"] == "http://127.0.0.1:9333/resolved"
+            reg.get_or_start.reset_mock()
+            with patch("tools.browser_tool_session._run_browser_command", return_value={"success": False}):
+                assert browser_vault_tool._ensure_supervisor("task-1") is None
+            reg.get_or_start.assert_not_called()
+
 
