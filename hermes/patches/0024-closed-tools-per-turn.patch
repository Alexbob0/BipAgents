diff --git a/agent/closed_tools.py b/agent/closed_tools.py
new file mode 100644
index 0000000000000000000000000000000000000000..d48342f9ae5289037e96e9fd091c19e729844b3d
--- /dev/null
+++ b/agent/closed_tools.py
@@ -0,0 +1,73 @@
+"""Tools refused for one turn of the agent's own person (BipAgents patch 0024).
+
+A client (BipAgents' bridge) names, in a turn's ``model_options``, tools that turn must not run:
+``"closed_tools": ["text_to_speech", "mcp__bipagents__create_audio", "mcp__stealth__*", ...]``. A voice call's turns
+close the tools that make media or long outputs (audio, images, pages, files, the browser): the person is waiting on
+the line, and what is to be made is made after the call. The dispatcher refuses them, ``tool_call``'s underlying tool
+included (``refusal``), with a reply that says what to do instead.
+
+The model is still offered every tool: the request's tool list stays the one the agent's conversations send, so the
+model server's prompt cache is shared (one prefix for every turn). Everything else is the person's usual turn too.
+``model_options`` already rides every path a turn takes (the session chat, its stream, ``/v1/runs``, the session
+authority's admission), and each turn sets the mark again (``apply``), so a cached agent's next turn runs them again.
+
+A name ending in ``*`` closes every tool it starts (an MCP server's: ``mcp__stealth__*``). A malformed value closes
+nothing (logged): the mark only spares a turn from waiting, it guards no data.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+KEY = "closed_tools"
+MAX_NAMES = 128
+MAX_NAME = 200
+REFUSAL = (
+    "This tool is closed during this voice call. Say it instead (pronounce or spell words, describe, explain), and "
+    "offer to make the audio, image, page or file after the call (note it with after_call when you have that tool)."
+)
+
+
+def parse(model_options: Any) -> Optional[tuple]:
+    """The closed names of a turn's ``model_options`` (``None``: nothing closed)."""
+    if not isinstance(model_options, dict) or model_options.get(KEY) is None:
+        return None
+    names = model_options.get(KEY)
+    if (not isinstance(names, list) or len(names) > MAX_NAMES
+            or not all(isinstance(n, str) and 0 < len(n) <= MAX_NAME and not any(c.isspace() for c in n)
+                       for n in names)):
+        logger.warning("closed_tools ignored: a list of at most %d tool names is expected", MAX_NAMES)
+        return None
+    return tuple(sorted(set(names))) or None
+
+
+def apply(agent: Any, model_options: Any) -> None:
+    """Mark ``agent`` for the turn about to run (cleared when ``model_options`` closes nothing)."""
+    closed = parse(model_options)
+    agent._closed_tools = closed
+    if closed:
+        logger.info("turn with closed tools: %s", ", ".join(closed))
+
+
+def is_closed(agent: Any, name: str) -> bool:
+    closed = getattr(agent, "_closed_tools", None)
+    if not isinstance(closed, tuple) or not name:
+        return False
+    return any(name.startswith(c[:-1]) if c.endswith("*") else name == c for c in closed)
+
+
+def refusal(agent: Any, name: str) -> Optional[str]:
+    """Why ``name`` can't run during this turn (``None``: it can)."""
+    if not is_closed(agent, name):
+        return None
+    logger.info("closed tool %s refused", name)
+    return REFUSAL
+
+
+def refusal_result(agent: Any, name: str) -> Optional[str]:
+    message = refusal(agent, name)
+    return None if message is None else json.dumps({"error": message}, ensure_ascii=False)
