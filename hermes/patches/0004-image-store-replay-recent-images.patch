+"""Local patch 0004: user images survive across runs (store on flush, re-attach on the wire)."""
+import base64
+import copy
+
+import pytest
+
+import agent.conversation_loop  # noqa: F401 -- imported at collection: its bootstrap reads the install manifest
+from agent import image_store
+from agent.session_persistence import _durable_content
+
+
+def _data_url(payload: bytes, mime: str = "image/png") -> str:
+    return f"data:{mime};base64,{base64.b64encode(payload).decode('ascii')}"
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    return tmp_path
+
+
+def _user(text, *payloads):
+    parts = [{"type": "text", "text": text}]
+    parts += [{"type": "image_url", "image_url": {"url": _data_url(p)}} for p in payloads]
+    return {"role": "user", "content": parts}
+
+
+def _stored_row(live):
+    """What a fresh run loads from the DB: text-only content + the row's message_uid."""
+    return {"role": "user", "content": _durable_content(live["content"]), "message_uid": live["message_uid"]}
+
+
+def test_persist_writes_file_and_sidecar_but_row_stays_text(home):
+    live = _user("Que vois-tu ?", b"img-A")
+    assert image_store.persist_message_images(live) == 1
+    files = sorted(p.name for p in (home / "image_store").iterdir() if p.is_file())
+    assert len(files) == 1 and files[0].endswith(".png")
+    assert (home / "image_store" / files[0]).read_bytes() == b"img-A"
+    assert image_store.load_refs(live["message_uid"]) == [{"file": files[0], "mime": "image/png"}]
+    # The DB projection (and so the session messages API) is unchanged: text only, no base64.
+    assert _durable_content(live["content"]) == "Que vois-tu ?\n[screenshot]"
+
+
+def test_rehydrate_restores_exact_live_parts(home):
+    live = _user("Que vois-tu ?", b"img-A")
+    image_store.persist_message_images(live)
+    row = _stored_row(live)
+    api = copy.deepcopy(row)
+    assert image_store.rehydrate_wire_images([(row, api)]) == 1
+    assert api["content"] == live["content"]  # byte-identical to what run 1 sent → prefix cache stays valid
+    assert row["content"] == "Que vois-tu ?\n[screenshot]"  # the source history is never modified
+
+
+def test_only_three_most_recent_images_are_reattached(home):
+    rows = []
+    for i in range(5):
+        live = _user(f"photo {i}", f"img-{i}".encode())
+        image_store.persist_message_images(live)
+        rows.append(_stored_row(live))
+        rows.append({"role": "assistant", "content": f"vu {i}"})
+    pairs = [(r, copy.deepcopy(r)) for r in rows]
+    assert image_store.rehydrate_wire_images(pairs) == 3
+    users = [api for src, api in pairs if src["role"] == "user"]
+    assert users[0]["content"] == "photo 0\n[image envoyée plus tôt]"
+    assert users[1]["content"] == "photo 1\n[image envoyée plus tôt]"
+    for api in users[2:]:
+        assert [p["type"] for p in api["content"]] == ["text", "image_url"]
+    # Deterministic: a second build of the same history yields the same bytes.
+    again = [(r, copy.deepcopy(r)) for r in rows]
+    image_store.rehydrate_wire_images(again)
+    assert [a for _, a in again] == [a for _, a in pairs]
+
+
+def test_live_images_count_toward_the_window(home):
+    old = _user("ancienne", b"img-old")
+    image_store.persist_message_images(old)
+    row = _stored_row(old)
+    current = _user("nouvelle", b"n1", b"n2", b"n3")
+    pairs = [(row, copy.deepcopy(row)), (current, copy.deepcopy(current))]
+    assert image_store.rehydrate_wire_images(pairs) == 0
+    assert pairs[0][1]["content"] == "ancienne\n[image envoyée plus tôt]"
+    assert pairs[1][1]["content"] == current["content"]
+
+
+def test_marker_without_ref_reads_as_older_image(home):
+    # A pre-patch row, or one whose ref was pruned/purged: same bytes either way (cache-stable).
+    row = {"role": "user", "content": "ancien message\n[screenshot]", "message_uid": "abc123"}
+    api = copy.deepcopy(row)
+    assert image_store.rehydrate_wire_images([(row, api)]) == 0
+    assert api["content"] == "ancien message\n[image envoyée plus tôt]"
+    assert row["content"] == "ancien message\n[screenshot]"
+
+
+# --- retention (patch 0004, second part) ---------------------------------------------------------
+
+@pytest.fixture
+def db(home):
+    from hermes_state import SessionDB
+
+    d = SessionDB(db_path=home / "state.db")
+    yield d
+    d.close()
+
+
+def _add(db, sid, payload, ts):
+    """One user turn with one image, written like the agent does: image store first, then the row."""
+    live = _user(f"photo {payload!r}", payload)
+    image_store.persist_message_images(live, session_id=sid, ts=ts)
+    db.ensure_session(sid, "api_server")
+    db.append_message(sid, "user", content=_durable_content(live["content"]),
+                      message_uid=live["message_uid"], timestamp=ts)
+    return live["message_uid"]
+
+
+def _files(home):
+    return sorted(p.name for p in (home / "image_store").iterdir() if p.is_file())
+
+
+def _sha_name(payload):
+    import hashlib
+    return f"{hashlib.sha256(payload).hexdigest()}.png"
+
+
+def test_window_keeps_three_newest_images_per_session(home, db):
+    uids = [_add(db, "S1", f"s1-{i}".encode(), 1000 + i) for i in range(5)]
+    other = _add(db, "S2", b"s2-0", 900)  # older than everything in S1, other session: untouched
+    assert [bool(image_store.load_refs(u)) for u in uids] == [False, False, True, True, True]
+    assert image_store.load_refs(other)
+    assert _files(home) == sorted([_sha_name(f"s1-{i}".encode()) for i in (2, 3, 4)] + [_sha_name(b"s2-0")])
+    # A pruned row then reads as an older image, the kept ones are re-attached.
+    rows = [{"role": "user", "content": f"photo {f's1-{i}'.encode()!r}\n[screenshot]", "message_uid": u}
+            for i, u in enumerate(uids)]
+    pairs = [(r, copy.deepcopy(r)) for r in rows]
+    assert image_store.rehydrate_wire_images(pairs) == 3
+    assert pairs[0][1]["content"].endswith("[image envoyée plus tôt]")
+
+
+def test_late_reflush_of_an_old_message_does_not_evict_newer_images(home, db):
+    for i in range(3):
+        _add(db, "S1", f"new-{i}".encode(), 2000 + i)
+    old = _user("vieille", b"old")
+    image_store.persist_message_images(old, session_id="S1", ts=1000)
+    assert not image_store.load_refs(old["message_uid"])
+    assert _sha_name(b"old") not in _files(home)
+
+
+def test_shared_file_survives_until_its_last_reference(home, db):
+    _add(db, "S1", b"shared", 1000)
+    _add(db, "S2", b"shared", 1001)
+    for i in range(3):  # pushes S1's copy out of S1's window
+        _add(db, "S1", f"s1-{i}".encode(), 1100 + i)
+    assert _sha_name(b"shared") in _files(home)  # still referenced by S2
+    assert db.delete_session("S2", sessions_dir=home / "sessions")
+    assert _sha_name(b"shared") not in _files(home)
+
+
+def test_delete_session_purges_its_refs_and_files(home, db):
+    keep = _add(db, "KEEP", b"keep", 1000)
+    gone = [_add(db, "GONE", f"g{i}".encode(), 1001 + i) for i in range(2)]
+    assert db.delete_session("GONE", sessions_dir=home / "sessions")
+    assert not any(image_store.load_refs(u) for u in gone)
+    assert _files(home) == [_sha_name(b"keep")] and image_store.load_refs(keep)
+
+
+def test_bulk_delete_sessions_purges_too(home, db):
+    a, b = _add(db, "A", b"a", 1000), _add(db, "B", b"b", 1001)
+    assert db.delete_sessions(["A", "B"], sessions_dir=home / "sessions") == 2
+    assert not image_store.load_refs(a) and not image_store.load_refs(b) and _files(home) == []
+
+
+def test_startup_gc_drops_refs_of_missing_or_compacted_messages(home, db):
+    import os
+    import time
+
+    live = _add(db, "S", b"live", 1000)
+    compacted = _add(db, "S", b"compacted", 999)
+    import sqlite3
+    conn = sqlite3.connect(home / "state.db")
+    conn.execute("UPDATE messages SET active = 0 WHERE message_uid = ?", (compacted,))
+    conn.commit()
+    conn.close()
+    never = _user("jamais en base", b"never")  # sidecar written, row never committed (crash)
+    image_store.persist_message_images(never, session_id="S", ts=998)
+    root = home / "image_store"
+    (root / ("0" * 64 + ".jpg")).write_bytes(b"orphan file")
+    tmp = root / ".x.jpg.1.tmp"
+    tmp.write_bytes(b"half written")
+    old = time.time() - 7200
+    os.utime(tmp, (old, old))
+    stats = image_store.gc_store(db)
+    assert stats["refs_removed"] == 2 and stats["files_removed"] == 4
+    assert image_store.load_refs(live) and _files(home) == [_sha_name(b"live")]
