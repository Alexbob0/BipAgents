diff --git a/tests/gateway/test_api_server_runs_todo.py b/tests/gateway/test_api_server_runs_todo.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb0fc6e72418366fa84ebc56c73a5c491afab6af
--- /dev/null
+++ b/tests/gateway/test_api_server_runs_todo.py
@@ -0,0 +1,98 @@
+"""``todo.updated`` on the Runs API: the agent's task list after each Todo tool call.
+
+A run-stream client saw ``tool.started`` / ``tool.completed`` for ``todo_list`` with no list (the canonical turn's
+completion carries no preview, the other path a 500-character cut of the JSON): it could not show the plan the agent
+keeps. After every Todo call that returns a list, the stream now carries ``todo.updated`` with the whole list as the
+call left it, right after the call's ``tool.completed``. ACP clients get the same list as a ``plan`` update.
+"""
+import asyncio
+import json
+
+import pytest
+
+from gateway.platforms.api_server_runs import _RunStream, _todo_updated_fields
+from tools.todo_tool import TodoStore, todo_tool
+
+from tests.gateway.test_api_server_runs import _make_adapter
+
+
+def _redact(text, force=False):
+    return text.replace("sk-abcdefghijklmnopqrstuvwxyz", "sk-***")
+
+
+def _list(*items, merge=False, store=None):
+    store = store or TodoStore()
+    return store, todo_tool(todos=list(items), merge=merge, store=store)
+
+
+async def _events(adapter, run_id, *calls):
+    loop = asyncio.get_running_loop()
+    adapter._run_streams[run_id] = _RunStream()
+    callback = adapter._make_run_event_callback(run_id, loop)
+    for args, kwargs in calls:
+        callback(*args, **kwargs)
+    await asyncio.sleep(0)  # the callback hops onto the loop via call_soon_threadsafe
+    return [event for _, event in adapter._run_streams[run_id].backlog]
+
+
+@pytest.mark.asyncio
+async def test_each_todo_call_is_followed_by_the_whole_list():
+    store, first = _list({"id": "1", "content": "Lire les e-mails", "status": "in_progress"},
+                         {"id": "2", "content": "Trier", "status": "pending"})
+    _, second = _list({"id": "1", "content": "Lire les e-mails", "status": "completed"},
+                      {"id": "2", "content": "Trier", "status": "in_progress"}, merge=True, store=store)
+    events = await _events(
+        _make_adapter(), "run_todo",
+        (("tool.completed", "todo_list"), {"duration": 0.01, "is_error": False, "result": first}),
+        (("tool.completed", "todo_list"), {"duration": 0.01, "is_error": False, "result": second}),
+    )
+    assert [e["event"] for e in events] == ["tool.completed", "todo.updated", "tool.completed", "todo.updated"]
+    assert events[1]["todos"] == [{"id": "1", "content": "Lire les e-mails", "status": "in_progress"},
+                                  {"id": "2", "content": "Trier", "status": "pending"}]
+    assert [t["status"] for t in events[3]["todos"]] == ["completed", "in_progress"]
+    assert events[3]["revision"] == 2
+    assert events[3]["summary"]["completed"] == 1 and events[3]["summary"]["total"] == 2
+    assert events[3]["run_id"] == "run_todo"
+
+
+@pytest.mark.asyncio
+async def test_the_canonical_turns_completion_carries_the_list_but_still_no_preview():
+    _, result = _list({"id": "a", "content": "Réserver le train", "status": "pending"})
+    events = await _events(
+        _make_adapter(), "run_canonical",
+        (("tool.completed", "todo_list", None, None), {"tool_call_id": "c1", "is_error": False, "raw_result": result}),
+    )
+    assert [e["event"] for e in events] == ["tool.completed", "todo.updated"]
+    assert events[0]["preview"] == ""
+    assert events[1]["todos"][0]["content"] == "Réserver le train"
+
+
+@pytest.mark.asyncio
+async def test_subtasks_keep_their_parent_and_secrets_are_redacted():
+    _, result = _list({"id": "p", "content": "Voyage", "status": "in_progress"},
+                      {"id": "c", "content": "Clé sk-abcdefghijklmnopqrstuvwxyz", "status": "pending", "parent": "p"})
+    fields = _todo_updated_fields("todo_list", result, _redact)
+    assert fields["todos"][1]["parent"] == "p"
+    assert "abcdefghijklmnopqrstuvwxyz" not in json.dumps(fields)
+
+
+@pytest.mark.asyncio
+async def test_other_tools_failed_writes_and_unparsable_results_send_nothing_more():
+    _, result = _list({"id": "1", "content": "x", "status": "pending"})
+    failed = todo_tool(todos=[{"id": "1", "content": "", "status": "pending"}], store=TodoStore())
+    events = await _events(
+        _make_adapter(), "run_other",
+        (("tool.completed", "read_file"), {"is_error": False, "result": result}),
+        (("tool.completed", "todo_list"), {"is_error": True, "result": failed}),
+        (("tool.completed", "todo_list"), {"is_error": False, "result": "not json"}),
+        (("tool.started", "todo_list", "planning 1 task(s)"), {}),
+    )
+    assert [e["event"] for e in events] == ["tool.completed"] * 3 + ["tool.started"]
+
+
+def test_the_legacy_name_and_a_dict_result_are_understood():
+    store = TodoStore()
+    store.write([{"id": "1", "content": "Étape", "status": "completed"}])
+    fields = _todo_updated_fields("todo", {"todos": store.read(), "revision": 1}, _redact)
+    assert fields == {"todos": [{"id": "1", "content": "Étape", "status": "completed"}], "revision": 1}
+    assert _todo_updated_fields("todo_list", None, _redact) is None
