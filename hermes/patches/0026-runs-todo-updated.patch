index 9bba11bf43c7a8efc289575dba9d580cd9779b89..a36b51deb74f24fbdf248438f79dc4066df546e2 100644
--- a/gateway/platforms/api_server_runs.py
+++ b/gateway/platforms/api_server_runs.py
@@ -157,6 +157,40 @@ def _tool_completed_preview(result: Any, redact_sensitive_text: Callable[..., st
     return preview if len(preview) <= limit else preview[: limit - 3] + "..."
 
 
+def _todo_updated_fields(tool_name: Any, result: Any, redact_sensitive_text: Callable[..., str]) -> Optional[dict[str, Any]]:
+    """``todo.updated`` payload after a Todo tool call: the whole list as the call left it (``todos``: ``id``,
+    ``content``, ``status``, ``parent``?), its ``revision`` and ``summary``, so a run-stream client can show the
+    agent's plan live (the ACP adapter's ``plan`` update, for Runs API clients). None for any other tool or a failed
+    write (an error result). Contents are model-written: secrets redacted."""
+    from tools.todo_tool import is_todo_tool_name
+    if not is_todo_tool_name(tool_name) or result is None:
+        return None
+    data = result
+    if isinstance(result, str):
+        try:
+            data = json.loads(result)
+        except (TypeError, ValueError):
+            return None
+    if not isinstance(data, dict) or not isinstance(data.get("todos"), list):
+        return None
+    todos = []
+    for item in data["todos"]:
+        if not isinstance(item, dict) or not str(item.get("content") or "").strip():
+            continue
+        entry = {"id": str(item.get("id") or ""),
+                 "content": redact_sensitive_text(str(item["content"]), force=True),
+                 "status": str(item.get("status") or "pending")}
+        if item.get("parent"):
+            entry["parent"] = str(item["parent"])
+        todos.append(entry)
+    fields: dict[str, Any] = {"todos": todos}
+    if isinstance(data.get("revision"), int):
+        fields["revision"] = data["revision"]
+    if isinstance(data.get("summary"), dict):
+        fields["summary"] = data["summary"]
+    return fields
+
+
 _RUN_STREAM_SUBSCRIBER_OVERFLOW = object()
 _RUN_STREAM_WRITE_TIMEOUT = 5.0
 
@@ -387,6 +421,11 @@ def _make_run_event_callback(self, run_id: str, loop: asyncio.AbstractEventLoop,
                 event_fields["preview"] = _tool_completed_preview(
                     kwargs.get("result"), redact_sensitive_text)
             _push(_run_event(run_id, event_type, **event_fields))
+            if event_type == "tool.completed":
+                todo = _todo_updated_fields(
+                    tool_name, kwargs.get("result", kwargs.get("raw_result")), redact_sensitive_text)
+                if todo is not None:
+                    _push(_run_event(run_id, "todo.updated", **todo))
         elif event_type == "model.usage":
             _push(_run_event(run_id, event_type, **kwargs["usage"]))
         elif event_type in {"subagent.start", "subagent.complete"}:
@@ -1164,7 +1203,9 @@ async def _execute_run(self, run: _RunLaunch, *, _api_server) -> None:
             def _tool_complete(call_id, name, args, result):
                 from agent.display import _detect_tool_failure
