diff --git a/agent/turn_empty_response.py b/agent/turn_empty_response.py
index 7a76d297cc..40eedece78 100644
--- a/agent/turn_empty_response.py
+++ b/agent/turn_empty_response.py
@@ -43,13 +43,144 @@ class EmptyResponseVerdict:
     api_call_count: int
 
 
+def _next_call_without_thinking(agent: Any, step: str) -> None:
+    """The next recovery call goes out with thinking off (one shot, as the thinking-only
+    truncation does). Resending the same request makes a model that spent its whole turn
+    thinking do it again: every retry ends the same way and the turn returns ``(empty)``."""
+    agent._ephemeral_reasoning_off = True
+    agent._thinking_off_recovery = True
+    logger.warning(
+        "Empty or thinking-only response — %s without thinking (model=%s provider=%s)",
+        step, agent.model, agent.provider,
+    )
+
+
+_ANSWER_NOW = (
+    "Answer the person now in plain text, or call one of the tools listed in this request "
+    "(a tool that is not listed: find it with tool_search, run it with tool_call)."
+)
+_ANSWER_NOW_NO_TOOLS = "Answer the person now, in plain text, with what you already have."
+
+
+def _change_the_request(agent: Any, messages: list, *, without_tools: bool) -> None:
+    """An empty retry never resends the request that came back empty: a deterministic
+    server (or a model whose output the server could not parse into content or tool calls)
+    returns the same thing to the token. Drop the trailing recovery rows (a thinking prefill
+    leaves the request ending on an assistant row), ask for the answer in plain text and,
+    on the last try, send it without tools."""
+    while messages and isinstance(messages[-1], dict) and (
+        messages[-1].get("_thinking_prefill") or messages[-1].get("_empty_recovery_synthetic")
+    ):
+        messages.pop()
+    last_role = messages[-1].get("role") if messages and isinstance(messages[-1], dict) else None
+    if last_role in ("tool", "user"):
+        # tool/user → assistant → user keeps the sequence valid (APIs reject tool → user and user → user);
+        # after the person's own message too, or the retry would be the request that came back empty.
+        append_message(messages, {"role": "assistant", "content": "(empty)", "_empty_recovery_synthetic": True})
+        last_role = "assistant"
+    if last_role == "assistant":
+        append_message(messages, {
+            "role": "user", "content": _ANSWER_NOW_NO_TOOLS if without_tools else _ANSWER_NOW,
+            "_empty_recovery_synthetic": True,
+        })
+    agent._session_messages = messages
+    agent._ephemeral_tools_off = without_tools
+
+
+def _markup_names(text: str) -> list:
+    """The tag names in a text (``<function_calls>``, ``<invoke``…), never what they hold."""
+    return sorted(set(re.findall(r"</?([A-Za-z_｜][\w:.|｜-]{0,40})", text or "")))[:8]
+
+
+def _sizes(obj: Any) -> dict:
+    """Every field of a response message (or stream delta) with the length of its value."""
+    fields = {}
+    if isinstance(obj, dict):
+        items = obj.items()
+    else:
+        raw = dict(getattr(obj, "__dict__", {}) or {})
+        raw.update(getattr(obj, "model_extra", None) or {})
+        items = raw.items()
+    for key, value in items:
+        if str(key).startswith("_") or value is None:
+            continue
+        fields[str(key)] = len(value) if isinstance(value, (str, list, tuple, dict)) else 1
+    return fields
+
+
+def log_empty_response_shape(agent: Any, response: Any, finish_reason: str, messages: list) -> None:
+    """What came back empty and what was asked — names and sizes, never content — so the
+    next occurrence tells which shape triggers it (a tool call the server could not parse,
+    markup the visible-text filter removed, a request ending on a recovery row…)."""
+    try:
+        roles = []
+        for m in messages[-6:]:
+            if not isinstance(m, dict):
+                continue
+            role = str(m.get("role"))
+            if m.get("tool_calls"):
+                role += "+tools"
+            if m.get("_thinking_prefill") or m.get("_empty_recovery_synthetic"):
+                role += "(recovery)"
+            roles.append(role)
+        last_tools = next(
+            ([((c.get("function") or {}).get("name") or "?") for c in m["tool_calls"] if isinstance(c, dict)]
+             for m in reversed(messages) if isinstance(m, dict) and m.get("role") == "assistant" and m.get("tool_calls")),
+            [],
+        )
+        choices = getattr(response, "choices", None) or []
+        message = getattr(choices[0], "message", None) if choices else None
+        content = getattr(message, "content", None)
+        content = content if isinstance(content, str) else ""
+        visible = agent._strip_think_blocks(content).strip() if content else ""
+        usage = getattr(response, "usage", None)
+        completion = getattr(usage, "completion_tokens", None)
+        details = getattr(usage, "completion_tokens_details", None)
+        wire = getattr(agent, "_wire_reasoning_config", None)
+        stream_fields = getattr(agent, "_last_stream_delta_fields", None)
+        logger.warning(
+            "Empty response shape: message_fields=%s stream_delta_fields=%s content_chars=%d visible_chars=%d "
+            "content_markup=%s prompt_tokens=%s completion_tokens=%s reasoning_tokens=%s finish_reason=%s "
+            "stream=%s thinking=%s messages=%d last_roles=%s last_tool_calls=%s tools_offered=%d "
+            "empty_retries=%d prefills=%d (model=%s provider=%s)",
+            _sizes(message) if message is not None else None,
+            dict(stream_fields) if isinstance(stream_fields, dict) else None,
+            len(content), len(visible), _markup_names(content),
+            getattr(usage, "prompt_tokens", None), completion, getattr(details, "reasoning_tokens", None),
+            finish_reason, not getattr(agent, "_disable_streaming", False),
+            ((wire.get("effort") if wire.get("enabled") is not False else "none") if isinstance(wire, dict) else "default"),
+            len(messages), roles, last_tools[:5], len(getattr(agent, "tools", None) or []),
+            getattr(agent, "_empty_content_retries", 0), getattr(agent, "_thinking_prefill_retries", 0),
+            agent.model, agent.provider,
+        )
+        reasoning = getattr(message, "reasoning_content", None) or getattr(message, "reasoning", None)
+        if isinstance(completion, int) and completion > 0 and not visible and not reasoning \
+                and not getattr(message, "tool_calls", None):
+            if isinstance(stream_fields, dict):
+                # Streamed: the next call goes without streaming, so text the server held back
+                # (a tool call it could not parse) arrives and can be read.
+                agent._ephemeral_no_stream = True
+            logger.warning(
+                "Tokens generated but not surfaced: %d completion tokens, no visible content, reasoning or tool "
+                "call (content_chars=%d, markup=%s) (model=%s provider=%s)",
+                completion, len(content), _markup_names(content), agent.model, agent.provider,
+            )
+    except Exception:
+        logger.debug("Empty response shape could not be logged", exc_info=True)
+
+
+# Each empty retry changes the request (see _change_the_request): with a hint, then without tools.
+_CHANGED_RETRIES = 2
+
