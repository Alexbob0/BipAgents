     api_kwargs["extra_headers"] = _xh
 
 
+def _template_thinking_off(agent: Any, api_kwargs: Any) -> None:
+    """A one-shot "answer without thinking" call to a custom OpenAI-compatible server: also turn
+    the chat template's thinking off. vLLM / SGLang serve Qwen and DeepSeek templates that read
+    ``chat_template_kwargs`` (``enable_thinking`` / ``thinking``) and may ignore a top-level
+    ``reasoning_effort: none``. Only on a local server (or one already sent template kwargs):
+    a hosted endpoint can reject the unknown field. Ollama has its own ``think`` flag."""
+    if agent.provider != "custom" or agent.api_mode != "chat_completions":
+        return
+    extra_body = dict(api_kwargs.get("extra_body") or {})
+    template = extra_body.get("chat_template_kwargs")
+    try:
+        from agent.model_metadata import is_local_endpoint
+        local = is_local_endpoint(agent.base_url or "")
+    except Exception:
+        local = False
+    if "think" in extra_body or not (local or isinstance(template, dict)):
+        return
+    extra_body["chat_template_kwargs"] = {
+        **(template if isinstance(template, dict) else {}), "enable_thinking": False, "thinking": False,
+    }
+    api_kwargs["extra_body"] = extra_body
+
+
+def apply_one_shot_changes(agent: Any, api_kwargs: Any, thinking_off_once: bool) -> None:
+    """The empty-response ladder's one-shot changes to this request: thinking off (the
+    reasoning config was overridden while building; the chat template follows) and, on its
+    last try, no tools so the model answers in plain text."""
+    _wire = getattr(agent, "_wire_reasoning_config", None)
+    if (
+        thinking_off_once and not getattr(agent, "_ephemeral_reasoning_off", False)
+        and isinstance(_wire, dict) and (_wire.get("enabled") is False or _wire.get("effort") == "none")
+    ):
+        _template_thinking_off(agent, api_kwargs)
+    if getattr(agent, "_ephemeral_tools_off", False):
+        agent._ephemeral_tools_off = False
+        if agent.api_mode == "chat_completions":
+            for key in ("tools", "tool_choice", "parallel_tool_calls"):
+                api_kwargs.pop(key, None)
+
+
