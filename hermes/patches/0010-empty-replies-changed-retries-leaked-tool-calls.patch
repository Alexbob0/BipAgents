diff --git a/agent/leaked_tool_calls.py b/agent/leaked_tool_calls.py
new file mode 100644
index 0000000000..7a21722cf1
--- /dev/null
+++ b/agent/leaked_tool_calls.py
@@ -0,0 +1,199 @@
+"""Tool calls a model wrote as text in its native format, turned back into real calls.
+
+An OpenAI-compatible server (vLLM, SGLang…) turns a model's native tool-call markup into
+``tool_calls`` only for the tools of the request. DeepSeek V4 on such a server, with a
+long history of direct calls to a tool that is now deferred behind ``tool_search``, keeps
+calling it directly: the markup comes back as ``content`` (non-streaming, or streaming
+with thinking on) or is swallowed (streaming without thinking: only "\\n\\n" arrives).
+Hermes then saw an empty answer and resent the same request — a deterministic server
+returns the same markup every time — until the turn ended "(empty)".
+
+Here such a reply becomes real calls, through the same dispatch, approvals and hooks as
+any other — but only where it was built for, and only when nothing else could be meant:
+
+- the provider or model is one known to need it (``RECOVERY_PROVIDERS`` /
+  ``RECOVERY_MODEL_MARKERS``: a custom OpenAI-compatible server, a DeepSeek model);
+- the model's own assistant message is ONLY call markup once ``<think>``/reasoning blocks
+  and whitespace are left out: no prose around it, no fence or quote, so markup the model
+  copies from a page, a file or a tool result is never run;
+- each name is exactly a tool offered in this request (direct, or deferred and reachable
+  through ``tool_call``). A suffix match or an unknown name is dropped, never dispatched;
+  when nothing is left the reply is empty and the empty-response ladder asks again.
+
+Formats: DeepSeek DSML (``<｜DSML｜invoke name=…>`` with ``<｜DSML｜parameter …>``),
+DeepSeek V3.x (``<｜tool▁call▁begin｜>name<｜tool▁sep｜>{json}<｜tool▁call▁end｜>``) and
+the Hermes/Qwen ``<tool_call>{"name": …, "arguments": …}</tool_call>`` block.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import uuid
+from typing import Any, Optional
+
+logger = logging.getLogger("agent.conversation_loop")
+
+# Where a leaked call is recovered at all: a custom OpenAI-compatible server (the person's own
+# vLLM/SGLang, where the DeepSeek case was measured) or a DeepSeek model on any provider.
+RECOVERY_PROVIDERS = frozenset({"custom"})
+RECOVERY_MODEL_MARKERS = ("deepseek",)
+
+_BAR = r"[｜|]"
+_DSML = rf"{_BAR}\s*DSML\s*{_BAR}\s*"
+_DSML_INVOKE = re.compile(
+    rf"<\s*{_DSML}invoke\s+name\s*=\s*\"([^\"]+)\"\s*>(.*?)<\s*/\s*{_DSML}invoke\s*>", re.DOTALL)
+_DSML_PARAM = re.compile(
+    rf"<\s*{_DSML}parameter\s+name\s*=\s*\"([^\"]+)\"(?:\s+string\s*=\s*\"(true|false)\")?\s*>(.*?)"
+    rf"<\s*/\s*{_DSML}parameter\s*>", re.DOTALL)
+_DSML_WRAPPER = re.compile(rf"<\s*/?\s*{_DSML}(?:function_)?calls\s*>")
+_V3_CALL = re.compile(
+    r"<｜tool▁call▁begin｜>(?:function<｜tool▁sep｜>)?([\w.:\-]+)\s*(?:<｜tool▁sep｜>)?\s*(.*?)<｜tool▁call▁end｜>",
+    re.DOTALL)
+_V3_WRAPPER = re.compile(r"<｜tool▁calls▁(?:begin|end)｜>")
+_XML_TOOL_CALL = re.compile(r"<tool_call>\s*(\{.*?\})\s*</tool_call>", re.DOTALL)
+_FENCE = re.compile(r"^```(?:json)?\s*|\s*```$")
+_THINK_BLOCK = re.compile(r"<(think|thinking|reasoning|REASONING_SCRATCHPAD)>.*?</\1>", re.DOTALL)
+_BLOCKS = (_DSML_WRAPPER, _V3_WRAPPER, _DSML_INVOKE, _V3_CALL, _XML_TOOL_CALL)
+
+
+def recovery_applies(agent: Any) -> bool:
+    """Whether this agent's provider or model is one the recovery is for."""
+    provider = str(getattr(agent, "provider", "") or "").strip().lower()
+    model = str(getattr(agent, "model", "") or "").strip().lower()
+    return provider in RECOVERY_PROVIDERS or any(marker in model for marker in RECOVERY_MODEL_MARKERS)
+
+
+def _json_args(text: str) -> Optional[dict]:
+    try:
+        value = json.loads(_FENCE.sub("", (text or "").strip()) or "{}")
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _call_of(pattern: re.Pattern, match: re.Match) -> Optional[tuple[str, dict]] | bool:
+    """The call one markup block holds; ``None`` for a wrapper; ``False`` when malformed."""
+    if pattern is _DSML_INVOKE:
+        name, body = match.group(1), match.group(2)
+        args: dict[str, Any] = {}
+        for key, is_string, value in _DSML_PARAM.findall(body):
+            if is_string == "false":
+                try:
+                    args[key] = json.loads(value)
+                    continue
+                except ValueError:
+                    pass
+            args[key] = value
+        return name.strip(), args
+    if pattern is _V3_CALL:
+        args = _json_args(match.group(2))
+        return (match.group(1).strip(), args) if args is not None else False
+    if pattern is _XML_TOOL_CALL:
+        block = _json_args(match.group(1))
+        if not block or not isinstance(block.get("name"), str):
+            return False
+        args = block.get("arguments")
+        if isinstance(args, str):
+            args = _json_args(args)
+        return block["name"].strip(), args if isinstance(args, dict) else {}
+    return None
+
+
+def parse_leaked_calls(content: str) -> list[tuple[str, dict]]:
+    """``[(name, arguments)…]`` when ``content`` is nothing but call markup (``<think>``/
+    reasoning blocks and whitespace aside); ``[]`` otherwise — any other character (prose,
+    a code fence, a quote mark) means the markup is not the model's own call."""
+    if not content or not any(marker in content for marker in ("DSML", "tool▁call", "<tool_call>")):
+        return []
+    text = _THINK_BLOCK.sub("", content)
+    calls: list[tuple[str, dict]] = []
+    pos, end = 0, len(text)
+    while True:
+        while pos < end and text[pos].isspace():
+            pos += 1
+        if pos >= end:
+            return calls
+        for pattern in _BLOCKS:
+            match = pattern.match(text, pos)
+            if match:
+                break
+        else:
+            return []
+        call = _call_of(pattern, match)
+        if call is False:
+            return []
+        if call:
+            calls.append(call)
+        pos = match.end()
+
+
+def _resolve(name: str, direct: set, deferred: frozenset) -> tuple[Optional[str], bool]:
+    """``(tool name, deferred?)`` for an exact name offered in this request; ``(None, False)``
+    otherwise (no suffix or prefix guessing)."""
+    if name in direct:
+        return name, False
+    if name in deferred:
+        return name, True
+    return None, False
+
+
+def recover_leaked_tool_calls(agent: Any, assistant_message: Any) -> bool:
+    """Turn the leaked calls of a reply without ``tool_calls`` into real ones (see the module
+    docstring for when). Returns True when the reply now carries tool calls; its content then
+    keeps only its ``<think>`` blocks. Calls to names not offered in this request are dropped;
+    when none is left the markup is cleared and False returned (an empty reply: Hermes' ladder
+    asks again, pointing at the listed tools and ``tool_search``)."""
+    if getattr(assistant_message, "tool_calls", None):
+        return False
+    if getattr(assistant_message, "role", None) not in (None, "assistant"):
+        return False
+    if not recovery_applies(agent):
+        return False
+    content = getattr(assistant_message, "content", None)
+    if not isinstance(content, str):
+        return False
+    calls = parse_leaked_calls(content)
+    if not calls:
+        return False
+    from agent.transports.types import ToolCall
+
+    direct = set(getattr(agent, "valid_tool_names", None) or ())
+    deferred: frozenset = frozenset()
+    if "tool_call" in direct:
+        try:
+            from agent.tool_executor import _tool_search_scoped_names
+            deferred = _tool_search_scoped_names(agent)
+        except Exception:
+            deferred = frozenset()
+    real: list = []
+    dropped = 0
+    for name, args in calls:
+        tool, is_deferred = _resolve(name, direct, deferred)
+        if tool is None:
+            dropped += 1
+            continue
+        if is_deferred:
+            name_sent, arguments = "tool_call", {"calls": [{"name": tool, "arguments": args}]}
+        else:
+            name_sent, arguments = tool, args
+        real.append(ToolCall(id=f"call_{uuid.uuid4().hex[:24]}", name=name_sent,
+                             arguments=json.dumps(arguments, ensure_ascii=False)))
+    assistant_message.content = "".join(m.group(0) for m in _THINK_BLOCK.finditer(content)).strip() or None
+    if dropped:
+        logger.warning(
+            "Tool call written as text dropped for %d name(s) not offered in this request (model=%s provider=%s)",
+            dropped, agent.model, agent.provider,
+        )
+    if not real:
+        return False
+    assistant_message.tool_calls = real
+    assistant_message.finish_reason = "tool_calls"
+    logger.warning(
+        "Tool call written as text turned into %d real call(s): %s (model=%s provider=%s)",
+        len(real), ", ".join(c.name if c.name != "tool_call" else "tool_call→" + json.loads(c.arguments)["calls"][0]["name"]
+                             for c in real),
+        agent.model, agent.provider,
+    )
+    return True
