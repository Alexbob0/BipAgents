diff --git a/tests/agent/test_empty_response_answers_without_thinking.py b/tests/agent/test_empty_response_answers_without_thinking.py
new file mode 100644
index 0000000000..1a59c488b7
--- /dev/null
+++ b/tests/agent/test_empty_response_answers_without_thinking.py
@@ -0,0 +1,266 @@
+"""An empty or thinking-only response is retried WITHOUT thinking, and never identically;
+a tool call the model wrote as text (and nothing else, on a custom server or a DeepSeek
+model) becomes a real call.
+
+DeepSeek-V4.1-Flash on a local OpenAI-compatible server (deterministic: the same request
+returns the same output to the token), with a history of direct calls to a tool now
+deferred behind tool_search, wrote that call in its native DSML markup. The server only
+parses calls to the request's tools: the markup came back as content (or, streamed without
+thinking, was swallowed: "\\n\\n" and 51 completion tokens). Hermes saw an empty answer,
+resent the same request six times and the turn returned "(empty)".
+"""
+import json
+import logging
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from agent import turn_empty_response as ter
+from agent.turn_api_request import _template_thinking_off, apply_one_shot_changes
+
+
+def _agent():
+    a = MagicMock()
+    a._current_streamed_assistant_text = ""
+    a._has_content_after_think_block.return_value = False
+    a._strip_think_blocks.side_effect = lambda t: t or ""
+    a._last_content_with_tools = None
+    a._last_content_tools_all_housekeeping = False
+    a._post_tool_empty_retried = False
+    a._thinking_prefill_retries = 0
+    a._empty_content_retries = 0
+    a._ephemeral_reasoning_off = False
+    a._thinking_off_recovery = False
+    a._fallback_chain = []
+    return a
+
+
+def _recover(agent, messages, reasoning=None):
+    msg = SimpleNamespace(reasoning=reasoning, reasoning_content=reasoning, reasoning_details=None, tool_calls=None)
+    return ter.recover_empty_response(
+        agent, msg, None, "stop", final_response="", messages=messages, api_messages=[],
+        conversation_history=[], active_system_prompt="sys", api_call_count=3,
+        turn_exit_reason=None, preflight_compression_blocked=False,
+    )
+
+
+def test_nudge_after_tool_calls_goes_without_thinking():
+    agent = _agent()
+    messages = [{"role": "user", "content": "météo ?"}, {"role": "tool", "content": "{}"}]
+    v = _recover(agent, messages)
+    assert v.action == "continue" and agent._post_tool_empty_retried is True
+    assert agent._ephemeral_reasoning_off is True and agent._thinking_off_recovery is True
+
+
+def test_thinking_only_prefill_goes_without_thinking():
+    agent = _agent()
+    v = _recover(agent, [{"role": "user", "content": "hi"}], reasoning="Let me think… " * 50)
+    assert v.action == "continue" and agent._thinking_prefill_retries == 1
+    assert agent._ephemeral_reasoning_off is True
+
+
+def _retry(agent, messages, budget=3, deterministic=True):
+    with patch.object(ter._empty_guard, "record_empty_attempt"), \
+            patch.object(ter._empty_guard, "empty_retry_budget", return_value=budget), \
+            patch.object(ter._empty_guard, "deterministic_empty", return_value=deterministic), \
+            patch.object(ter, "interruptible_backoff_sleep", return_value=None), \
+            patch("agent.retry_utils.jittered_backoff", return_value=0.0):
+        return ter._retry_empty(agent, None, "stop", True, messages=messages, conversation_history=[],
+                                api_call_count=3)
+
+
+def test_empty_retries_change_the_request_then_stop():
+    """Same empty twice (deterministic) still gets the two changed tries, then no more."""
+    agent = _agent()
+    messages = [{"role": "user", "content": "météo ?"},
+                {"role": "assistant", "content": "", "tool_calls": [{"function": {"name": "weather"}}]},
+                {"role": "tool", "content": "{}"}]
+    assert _retry(agent, messages)[0] == "continue"
+    assert agent._ephemeral_reasoning_off is True and agent._ephemeral_tools_off is False
+    assert [m["role"] for m in messages[-2:]] == ["assistant", "user"]
+    assert messages[-1]["content"] == ter._ANSWER_NOW and len(messages) == 5
+
+    agent._ephemeral_reasoning_off = False
+    assert _retry(agent, messages)[0] == "continue"
+    assert agent._ephemeral_reasoning_off is True and agent._ephemeral_tools_off is True
+    assert messages[-1]["content"] == ter._ANSWER_NOW_NO_TOOLS and len(messages) == 5   # replaced, not stacked
+
+    assert _retry(agent, messages)[0] is None   # no identical third try
+    assert agent._empty_content_retries == 2
+
+
+def test_reduced_budget_makes_the_one_retry_the_last():
+    agent = _agent()
+    messages = [{"role": "user", "content": "hi"}]
+    assert _retry(agent, messages, budget=1)[0] == "continue"
+    assert agent._ephemeral_tools_off is True
+    # after the person's own message too: user → assistant → user, never user → user nor the same request
+    assert [m["role"] for m in messages] == ["user", "assistant", "user"]
+    assert messages[-1]["content"] == ter._ANSWER_NOW_NO_TOOLS
+
+
+def test_prefill_row_is_dropped_before_the_retry():
+    agent = _agent()
+    messages = [{"role": "user", "content": "hi"}, {"role": "assistant", "content": "", "_thinking_prefill": True}]
+    _retry(agent, messages)
+    assert [m["role"] for m in messages] == ["user", "assistant", "user"]
+    assert not any(m.get("_thinking_prefill") for m in messages)
+
+
+def test_last_try_request_has_no_tools():
+    agent = SimpleNamespace(provider="custom", api_mode="chat_completions", base_url="https://api.eurouter.ai/v1",
+                            _ephemeral_tools_off=True, _wire_reasoning_config=None)
+    kwargs = {"tools": [{}], "tool_choice": "auto", "parallel_tool_calls": True, "messages": []}
+    apply_one_shot_changes(agent, kwargs, False)
+    assert kwargs == {"messages": []} and agent._ephemeral_tools_off is False
+
+
+def test_empty_shape_is_logged_without_content(caplog):
+    agent = _agent()
+    agent._strip_think_blocks.side_effect = lambda t: ""   # the markup filter removed everything
+    secret = "<function_calls><invoke name=\"notebook_read\">Camille</invoke></function_calls>"
+    message = SimpleNamespace(role="assistant", content=secret, tool_calls=None, reasoning_content=None)
+    response = SimpleNamespace(choices=[SimpleNamespace(message=message)],
+                               usage=SimpleNamespace(prompt_tokens=90000, completion_tokens=559))
+    agent._last_stream_delta_fields = {"role": 9, "content": len(secret)}
+    with caplog.at_level(logging.WARNING, logger="agent.conversation_loop"):
+        ter.log_empty_response_shape(agent, response, "stop", [{"role": "user", "content": "Camille ?"}])
+    text = caplog.text
+    assert "completion_tokens=559" in text and "Tokens generated but not surfaced" in text
+    assert "function_calls" in text and "invoke" in text and "'content': " in text
+    assert "Camille" not in text and "notebook_read" not in text
+
+
+def test_partial_stream_recovery_keeps_thinking():
+    agent = _agent()
+    agent._current_streamed_assistant_text = "Bonjour"
+    agent._has_content_after_think_block.return_value = True
+    v = _recover(agent, [{"role": "user", "content": "hi"}])
+    assert v.action == "break" and agent._ephemeral_reasoning_off is False
+
+
+def _custom(base_url, provider="custom"):
+    return SimpleNamespace(provider=provider, api_mode="chat_completions", base_url=base_url)
+
+
+def test_local_custom_server_gets_template_thinking_off():
+    kwargs = {"reasoning_effort": "none", "extra_body": {"top_k": 20}}
+    _template_thinking_off(_custom("http://192.168.1.123:8888/v1"), kwargs)
+    assert kwargs["extra_body"] == {"top_k": 20, "chat_template_kwargs": {"enable_thinking": False, "thinking": False}}
+
+
+def test_template_kwargs_already_sent_are_overridden_not_dropped():
+    kwargs = {"extra_body": {"chat_template_kwargs": {"enable_thinking": True, "custom": 1}}}
+    _template_thinking_off(_custom("https://llm.example.org/v1"), kwargs)
+    assert kwargs["extra_body"]["chat_template_kwargs"] == {"enable_thinking": False, "thinking": False, "custom": 1}
+
+
+def test_hosted_and_other_providers_are_left_alone():
+    for agent in (_custom("https://api.eurouter.ai/api/v1"), _custom("http://127.0.0.1:11434/v1", provider="openrouter")):
+        kwargs = {"reasoning_effort": "none"}
+        _template_thinking_off(agent, kwargs)
+        assert kwargs == {"reasoning_effort": "none"}
+    kwargs = {"extra_body": {"think": False}}   # Ollama: its own flag
+    _template_thinking_off(_custom("http://localhost:11434/v1"), kwargs)
+    assert kwargs == {"extra_body": {"think": False}}
+
+
+# -- tool calls written as text ------------------------------------------------------------
+
+_DSML = ("\n\n<｜DSML｜ calls>\n<｜DSML｜ invoke name=\"mcp__bipagents__health_summary\">\n"
+         "<｜DSML｜ parameter name=\"day\" string=\"true\">2026-10-26</｜DSML｜ parameter>\n"
+         "<｜DSML｜ parameter name=\"days\" string=\"false\">3</｜DSML｜ parameter>\n"
+         "</｜DSML｜ invoke>\n</｜DSML｜ calls>")
+_V3 = ('<｜tool▁calls▁begin｜><｜tool▁call▁begin｜>mcp__bipagents__weather<｜tool▁sep｜>{"city": "Lyon"}'
+       '<｜tool▁call▁end｜><｜tool▁calls▁end｜>')
+_XML = '<tool_call>{"name": "mcp__bipagents__weather", "arguments": {"city": "Lyon"}}</tool_call>'
+_HEALTH = frozenset({"mcp__bipagents__health_summary"})
+
+
+def _leaky_agent(provider="custom", model="dgx-spark"):
+    return SimpleNamespace(valid_tool_names={"tool_search", "tool_call", "mcp__bipagents__weather"},
+                           model=model, provider=provider)
+
+
+def _reply(content, role="assistant"):
+    return SimpleNamespace(role=role, content=content, tool_calls=None, finish_reason="stop")
+
+
+def _recover_leak(agent, reply, deferred=_HEALTH):
+    from agent.leaked_tool_calls import recover_leaked_tool_calls
+    with patch("agent.tool_executor._tool_search_scoped_names", return_value=deferred):
+        return recover_leaked_tool_calls(agent, reply)
+
+
+def test_dsml_call_to_a_deferred_tool_goes_through_tool_call():
+    """What DeepSeek V4 wrote for a tool its history called directly, once deferred."""
+    reply = _reply("<think>il faut la santé</think>" + _DSML)
+    assert _recover_leak(_leaky_agent(), reply) is True
+    (call,) = reply.tool_calls
+    assert call.function.name == "tool_call" and call.id
+    assert json.loads(call.function.arguments) == {
+        "calls": [{"name": "mcp__bipagents__health_summary", "arguments": {"day": "2026-10-26", "days": 3}}]}
+    assert reply.content == "<think>il faut la santé</think>" and reply.finish_reason == "tool_calls"
+
+
+def test_markup_alone_from_a_custom_server_or_a_deepseek_model_calls_the_direct_tool():
+    for agent in (_leaky_agent(), _leaky_agent(provider="openrouter", model="deepseek/deepseek-v4-flash")):
+        for text in (_V3, _XML, "\n" + _XML + "\n" + _XML + "\n"):
+            reply = _reply(text)
+            assert _recover_leak(agent, reply, frozenset()) is True
+            assert {c.function.name for c in reply.tool_calls} == {"mcp__bipagents__weather"}
+            assert json.loads(reply.tool_calls[0].function.arguments) == {"city": "Lyon"}
+            assert reply.content is None
+
+
+def test_markup_in_prose_fenced_or_quoted_is_never_run():
+    """A page or a file the agent read can hold call markup; the model quoting it is not a call."""
+    for text in ("Je regarde." + _DSML,
+                 "La page contient : " + _XML,
+                 _XML + "\nVoilà ce que j'ai trouvé.",
+                 "```\n" + _XML + "\n```",
+                 "> " + _XML,
+                 "Bonjour <tool_call> n'est pas un appel."):
+        reply = _reply(text)
+        assert _recover_leak(_leaky_agent(), reply) is False, text
+        assert reply.content == text and reply.tool_calls is None
+
+
+def test_markup_in_a_tool_result_is_never_run():
+    reply = _reply(_XML, role="tool")
+    assert _recover_leak(_leaky_agent(), reply) is False
+    assert reply.content == _XML and reply.tool_calls is None
+
+
+def test_other_providers_are_left_alone():
+    for provider, model in (("openrouter", "z-ai/glm-5.3-flash"), ("anthropic", "claude-sonnet"),
+                            ("eurouter", "qwen3-coder")):
+        reply = _reply(_XML)
+        assert _recover_leak(_leaky_agent(provider=provider, model=model), reply) is False
+        assert reply.content == _XML and reply.tool_calls is None
+
+
+def test_unknown_and_suffix_names_are_dropped_not_dispatched():
+    for name in ("weather", "terminal", "mcp__evil__weather"):
+        text = '<tool_call>{"name": "%s", "arguments": {"command": "id"}}</tool_call>' % name
+        reply = _reply(text)
+        assert _recover_leak(_leaky_agent(), reply, frozenset()) is False, name
+        assert reply.tool_calls is None and reply.content is None
+    # The deferred tool reached by a dropped server prefix is not guessed either.
+    reply = _reply(_DSML.replace("mcp__bipagents__health_summary", "health_summary"))
+    assert _recover_leak(_leaky_agent(), reply) is False and reply.tool_calls is None
+    # A known call next to an unknown one: only the known one goes out.
+    reply = _reply(_XML + '<tool_call>{"name": "terminal", "arguments": {}}</tool_call>')
+    assert _recover_leak(_leaky_agent(), reply, frozenset()) is True
+    assert [c.function.name for c in reply.tool_calls] == ["mcp__bipagents__weather"]
+
+
+def test_streamed_reply_whose_tokens_never_arrived_is_asked_again_without_streaming():
+    agent = _agent()
+    agent._strip_think_blocks.side_effect = lambda t: (t or "").strip()
+    agent._ephemeral_no_stream = False
+    agent._last_stream_delta_fields = {"role": 9, "content": 2}
+    message = SimpleNamespace(role="assistant", content="\n\n", tool_calls=None, reasoning_content=None)
+    response = SimpleNamespace(choices=[SimpleNamespace(message=message)],
+                               usage=SimpleNamespace(prompt_tokens=7517, completion_tokens=51))
+    ter.log_empty_response_shape(agent, response, "stop", [{"role": "user", "content": "nuit ?"}])
+    assert agent._ephemeral_no_stream is True
