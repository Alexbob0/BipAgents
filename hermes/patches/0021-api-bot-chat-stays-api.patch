+"""BipAgents patch 0021: an API client's own "Bot Chat" stays an API conversation under session authority.
+
+BipAgents' bridge makes each agent's main conversation with ``POST /api/sessions {"title": "Bot Chat"}`` and
+runs it through the Runs API (streamed text, tool events, ``model.usage``, approvals, clarify). Since session
+authority, any text turn into the canonical Bot Chat went to the FIFO (``admit_peer_turn``): the run's stream
+carried only ``run.completed``, a clarify had no way back, and the first such turn moved the conversation aside
+as ``Bot Chat (API <id>)`` with all its history, a new empty local Bot Chat taking its title. A Bot Chat made by
+a plain API create (``source`` ``api_server``) is now the client's: never moved aside, never handed to the FIFO,
+its turns (a peer's through the API doors too) run as API turns as before session authority. A peer's own create
+(``hermes peer dm`` names ``source: bot_peer_dm``) and every other Bot Chat keep upstream's behaviour.
+"""
+import pytest
+
+from tests.gateway.test_peer_dm_bot_chat_headless import AUTHOR, _api_admissions, _local_owner, _sessions, headless  # noqa: F401
+
+
+async def _client_bot_chat(headless, **extra):
+    created = await headless.cli.post("/api/sessions", json={"title": "Bot Chat", **extra})
+    assert created.status == 201, await created.text()
+    session_id = (await created.json())["session"]["id"]
+    row = headless.authority.db.get_session(session_id)
+    assert row['source'] == 'api_server' and not str(row.get('chat_id') or '').startswith('local-'), row
+    headless.authority.db.append_message(session_id, 'user', 'old history')
+    return session_id
+
+
+def _titles(db):
+    return sorted(r[0] for r in db._read_all("SELECT title FROM sessions WHERE title LIKE 'Bot Chat%'"))
+
+
+@pytest.mark.parametrize('extra', [{}, {'source': 'api_server'}])
+@pytest.mark.asyncio
+async def test_an_api_clients_bot_chat_create_makes_an_api_row(headless, extra):
+    await _client_bot_chat(headless, **extra)
+    assert len(_sessions(headless.authority)) == 1
+
+
+@pytest.mark.asyncio
+async def test_a_run_in_an_api_bot_chat_is_an_api_turn_and_nothing_moves(headless):
+    db = headless.authority.db
+    session_id = await _client_bot_chat(headless)
+    resp = await headless.cli.post("/v1/runs", json={"input": "hello", "session_id": session_id})
+    body = await resp.json()
+    assert resp.status == 202, body
+    assert _api_admissions(headless.authority), 'the turn was admitted as an API turn'
+    assert headless.executed == [], 'nothing went to the FIFO'
+    assert db.get_session_by_title('Bot Chat')['id'] == session_id and _titles(db) == ['Bot Chat']
+    assert [m['content'] for m in db.get_messages(session_id)][:1] == ['old history']
+
+
+@pytest.mark.asyncio
+async def test_a_peer_turn_into_an_api_bot_chat_is_left_to_the_api_doors(headless):
+    from gateway.platforms.api_server_bot_chat import admit_peer_turn
+    db = headless.authority.db
+    session_id = await _client_bot_chat(headless)
+    assert await admit_peer_turn(headless.authority.runner, session_id, 'ping', AUTHOR) is None
+    assert db.get_session_by_title('Bot Chat')['id'] == session_id and len(_sessions(headless.authority)) == 1
+    # a peer's create-if-missing finds the title taken, as for any existing Bot Chat
+    again = await headless.cli.post("/api/sessions", json={"title": "Bot Chat", "source": "bot_peer_dm"})
+    assert again.status == 400 and (await again.json())['error']['code'] == 'invalid_title'
+
+
+@pytest.mark.asyncio
+async def test_a_local_delivery_never_moves_an_api_bot_chat_aside(headless):
+    from pathlib import Path
+    from gateway.session_authorities import served_profile_name
+    from gateway.session_bot import deliver, displaceable_bot_chat
+    from hermes_state_runtime import RuntimeStoreError
+    db = headless.authority.db
+    session_id = await _client_bot_chat(headless)
+    assert displaceable_bot_chat(headless.authority, db.get_session(session_id)) is None
+    profile = served_profile_name(Path(db.db_path).parent.resolve())
+    with pytest.raises(RuntimeStoreError):
+        await deliver(_local_owner(headless.authority), dict(id='e' * 32, profile=profile, message='relayed', author=AUTHOR))
+    assert db.get_session_by_title('Bot Chat')['id'] == session_id and _titles(db) == ['Bot Chat']
+    assert headless.executed == []
+
+
+@pytest.mark.asyncio
+async def test_a_peers_own_create_still_mints_the_local_bot_chat(headless):
+    created = await headless.cli.post("/api/sessions", json={"title": "Bot Chat", "source": "bot_peer_dm"})
+    assert created.status == 201, await created.text()
+    row = headless.authority.db.get_session_by_title('Bot Chat')
+    assert str(row['chat_id']).startswith('local-'), row
