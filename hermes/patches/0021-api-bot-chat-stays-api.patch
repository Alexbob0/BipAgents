+def api_bot_chat(db, row):
+    """Whether the Bot Chat *row* is an API client's own conversation (BipAgents patch 0021): made with
+    a plain ``POST /api/sessions`` (``source`` ``api_server``) and run by that client through the Runs
+    API, its history the client's. No local chat in its lineage. Such a Bot Chat is never moved aside
+    and never handed to the FIFO: a turn into it (the client's own, or a peer's through the API doors)
+    runs as an API turn, as it did before session authority, with its events streamed to the caller."""
+    if row is None or str(row.get('chat_id') or '').startswith('local-'):
+        return False
+    tip = db.get_session(db.get_compression_tip(row['id']) or row['id']) or row
+    if str(tip.get('chat_id') or '').startswith('local-'):
+        return False
+    return 'api_server' in (str(row.get('source') or ''), str(tip.get('source') or ''))
+
