+def _is_mcp_message_agent(name: Any) -> bool:
+    """An MCP server's own ``message_agent`` (``mcp__<server>__message_agent``: BipAgents' bridge offers
+    one in every conversation, since the built-in reaches the Bot Chat only)."""
+    return isinstance(name, str) and name.startswith("mcp__") and name.endswith("__message_agent")
+
+
+def drop_mcp_message_agent(tools: Any, names: Optional[set] = None) -> None:
+    """Where the built-in ``message_agent`` is offered, an MCP server's tool of the same name goes from
+    the staged ``tools`` (and ``names``), so the model sees one way to write to an agent, not two.
+    Deterministic for the session, like the injection. Never raises."""
+    try:
+        if not isinstance(tools, list):
+            return
+        dropped = {
+            t.get("function", {}).get("name")
+            for t in tools
+            if isinstance(t, dict) and _is_mcp_message_agent(t.get("function", {}).get("name"))
+        }
+        if not dropped:
+            return
+        tools[:] = [t for t in tools if not (isinstance(t, dict) and t.get("function", {}).get("name") in dropped)]
+        if isinstance(names, set):
+            names.difference_update(dropped)
+    except Exception:  # pragma: no cover — must never break a turn
+        logger.debug("drop_mcp_message_agent failed", exc_info=True)
+
+
 def ensure_message_agent_tool(agent: Any) -> bool:
     """Inject the ``message_agent`` schema into a Bot Chat agent's tool list (once per turn).
     Idempotent and deterministic for the session's life (the gate is stable from the
@@ -161,6 +188,7 @@ def ensure_message_agent_tool(agent: Any) -> bool:
         valid = getattr(agent, "valid_tool_names", None)
         if isinstance(valid, set):
             valid.add(MESSAGE_AGENT_TOOL_NAME)
+        drop_mcp_message_agent(agent.tools, valid if isinstance(valid, set) else None)
         return True
     except Exception:  # pragma: no cover — must never break a turn
         logger.debug("ensure_message_agent_tool failed", exc_info=True)
