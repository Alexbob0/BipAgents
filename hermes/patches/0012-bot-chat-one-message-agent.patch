+"""BipAgents 0012: where the built-in ``message_agent`` is offered (a Bot Chat), an MCP server's tool of
+the same name (``mcp__bipagents__message_agent``, offered by BipAgents' bridge in every conversation) is
+taken out, so the model sees one way to write to an agent. Elsewhere the MCP one stays."""
+
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from tools import bot_mode_dm, bot_mode_probe
+from tools.mcp_tool_agent import _reinject_authorized_dynamic_tools
+
+BRIDGE = "mcp__bipagents__message_agent"
+
+
+@pytest.fixture(autouse=True)
+def _fresh_probe_cache():
+    bot_mode_probe._reset_cache_for_tests()
+    yield
+    bot_mode_probe._reset_cache_for_tests()
+
+
+def _managed_home(tmp_path) -> Path:
+    home = tmp_path / ".hermes"
+    d = home / "profiles" / "coach"
+    d.mkdir(parents=True)
+    (d / "profile.yaml").write_text(
+        textwrap.dedent(
+            """\
+            description: teammate
+            ui_meta:
+              hermes-bots:
+                shape: cloud
+            """
+        ),
+        encoding="utf-8",
+    )
+    return home
+
+
+class _FakeDB:
+    def __init__(self, home: Path, title: str):
+        self.db_path = str(home / "state.db")
+        self._title = title
+
+    def get_session_title(self, _sid):
+        return self._title
+
+
+class _FakeAgent:
+    def __init__(self, home: Path, title: str):
+        self._session_db = _FakeDB(home, title)
+        self.session_id = "sess-1"
+        self._session_title_hint = None
+        self._bot_mode_protocol = True
+        self.tools = [_schema(BRIDGE), _schema("mcp__bipagents__health")]
+        self.valid_tool_names = {BRIDGE, "mcp__bipagents__health"}
+
+
+def _schema(name: str) -> dict:
+    return {"type": "function", "function": {"name": name, "parameters": {"type": "object"}}}
+
+
+def _names(tools) -> list:
+    return [t["function"]["name"] for t in tools]
+
+
+def test_bot_chat_keeps_only_the_builtin(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat")
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is True
+    assert _names(agent.tools) == ["mcp__bipagents__health", bot_mode_dm.MESSAGE_AGENT_TOOL_NAME]
+    assert agent.valid_tool_names == {"mcp__bipagents__health", bot_mode_dm.MESSAGE_AGENT_TOOL_NAME}
+    # the next turn changes nothing (prompt-cache stable)
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is True
+    assert _names(agent.tools) == ["mcp__bipagents__health", bot_mode_dm.MESSAGE_AGENT_TOOL_NAME]
+
+
+def test_other_conversations_keep_the_mcp_one(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Courses de la semaine")
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == [BRIDGE, "mcp__bipagents__health"]
+    assert BRIDGE in agent.valid_tool_names
+
+
+def test_an_mcp_rebuild_in_the_bot_chat_drops_it_again(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat")
+    staged, names = [_schema(BRIDGE), _schema("mcp__bipagents__health")], {BRIDGE, "mcp__bipagents__health"}
+    _reinject_authorized_dynamic_tools(agent, staged, names)
+    assert _names(staged) == ["mcp__bipagents__health", bot_mode_dm.MESSAGE_AGENT_TOOL_NAME]
+    assert BRIDGE not in names
+
+
+def test_only_mcp_tools_named_message_agent_go():
+    tools = [_schema("mcp__x__message_agent"), _schema("message_agent_log"), _schema("mcp__x__message_agents")]
+    bot_mode_dm.drop_mcp_message_agent(tools)
+    assert _names(tools) == ["message_agent_log", "mcp__x__message_agents"]
