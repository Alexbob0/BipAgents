diff --git a/tests/tools/test_profile_timezone_followed.py b/tests/tools/test_profile_timezone_followed.py
new file mode 100644
index 0000000000000000000000000000000000000000..b48b52661d704935760409f64235b26a04866c87
--- /dev/null
+++ b/tests/tools/test_profile_timezone_followed.py
@@ -0,0 +1,39 @@
+"""The profile's ``timezone`` (BipAgents patch 0008): followed without a restart when the config is rewritten (the
+person's phone moved to another zone), and handed to terminal commands as ``TZ`` so ``date`` and scripts tell the
+person's time, not the server's."""
+
+import os
+
+import hermes_time
+
+
+def test_a_rewritten_timezone_is_read_without_a_restart(monkeypatch, tmp_path):
+    config = tmp_path / "config.yaml"
+    config.write_text("timezone: Europe/Paris\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_TIMEZONE", raising=False)
+    hermes_time.reset_cache()
+    try:
+        assert hermes_time.get_timezone_name() == "Europe/Paris"
+        config.write_text("timezone: Asia/Tokyo\n")
+        stat = config.stat()
+        os.utime(config, ns=(stat.st_atime_ns, stat.st_mtime_ns + 1_000_000))
+        assert hermes_time.get_timezone_name() == "Asia/Tokyo"
+        assert str(hermes_time.get_timezone()) == "Asia/Tokyo"
+    finally:
+        hermes_time.reset_cache()
+
+
+def test_terminal_commands_get_the_profile_zone(monkeypatch):
+    from tools.environments import base
+
+    monkeypatch.setenv("HERMES_TIMEZONE", "America/New_York")
+    hermes_time.reset_cache()
+    try:
+        assert base._with_profile_tz("date") == "export TZ=America/New_York\ndate"
+        monkeypatch.setenv("HERMES_TIMEZONE", "")
+        hermes_time.reset_cache()
+        monkeypatch.setattr(hermes_time, "get_timezone_name", lambda: "")
+        assert base._with_profile_tz("date") == "date"
+    finally:
+        hermes_time.reset_cache()
diff --git a/tools/environments/base.py b/tools/environments/base.py
index bcb2ba0ae8deb2ad3151ca3892015aacd807c828..cf242703017a594da1839d2f4d2ca51078b2fabf 100644
--- a/tools/environments/base.py
+++ b/tools/environments/base.py
@@ -260,6 +260,24 @@ def env_uses_host_filesystem(env: object) -> bool:
 # ---------------------------------------------------------------------------
 
 
+def _with_profile_tz(command: str) -> str:
+    """``command`` after an ``export TZ=`` of the active profile's configured zone, so ``date`` and
+    every program the agent runs (local, docker, ssh…) tell the person's time, as execute_code
+    already does. After the snapshot is sourced, so a zone changed mid-session is followed at the
+    next command; an inline ``TZ=… cmd`` still wins. Unconfigured, or on Windows: unchanged."""
+    if os.name == "nt":
+        return command
+    try:
+        from hermes_time import get_timezone_name
+
+        name = get_timezone_name()
+    except Exception:
+        return command
+    if not name:
+        return command
+    return f"export TZ={shlex.quote(name)}\n{command}"
+
+
