+def _config_identity() -> str:
+    """The config's path and version (the file backend's leads with its modification time): an app or
+    a bridge that rewrites ``timezone`` (the person flew to another zone) is followed at the next
+    call, without a gateway restart."""
+    path = get_config_path()
+    try:
+        from hermes_cli.config_backend import config_version_or_none
+        version = config_version_or_none(path)
+    except Exception:
+        try:
+            version = path.stat().st_mtime_ns
+        except OSError:
+            version = None
+    return f"{path}\0{version!r}"
