+    def test_checkout_contact_fields(self):
+        """An address item's name, phone and e-mail: by autocomplete, by type, by label (French accents too); a card
+        number in an <input type=tel> stays a card number."""
+        assert classify_checkout_control(_ctrl(autocomplete="name")).token == "name"
+        assert classify_checkout_control(_ctrl(autocomplete="shipping tel")).token == "tel"
+        assert classify_checkout_control(_ctrl(type="email")).token == "email"
+        assert classify_checkout_control(_ctrl(label="E-mail address")).token == "email"
+        assert classify_checkout_control(_ctrl(label="Téléphone")).token == "tel"
+        assert classify_checkout_control(_ctrl(label="Nom complet")).token == "name"
+        assert classify_checkout_control(_ctrl(type="tel", name="cardnumber")).token == "cc-number"
+        assert classify_checkout_control(_ctrl(type="tel")).token == "tel"
+        assert classify_checkout_control(_ctrl(type="password", autocomplete="")) is None
+        assert classify_checkout_control(_ctrl(label="Last name")) is None
+        fields = [classify_checkout_control(_ctrl(index=i, **kw)) for i, kw in enumerate(
+            [{"autocomplete": "name"}, {"type": "email"}, {"label": "Phone"}, {"autocomplete": "address-line1"}])]
+        secret = {"full_name": "Camille Example", "email": "camille@example.org", "phone": "0600000001",
+                  "address_line1": "1 Main St"}
+        fills = select_checkout_fills(fields, secret, ADDRESS_FIELDS)
+        assert sorted((f["index"], f["value"]) for f in fills) == [
