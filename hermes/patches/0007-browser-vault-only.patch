+def _browser_vault_only() -> bool:
+    """``browser.vault_only``: the profile browses with a browser of its own (an MCP server's tools); of the
+    ``browser`` toolset it keeps only the vault (``browser_vault_*``, which fills that same browser through
+    ``browser.cdp_url``)."""
+    try:
+        from hermes_cli.config import read_raw_config
+        browser_cfg = read_raw_config().get("browser", {})
+        return isinstance(browser_cfg, dict) and str(browser_cfg.get("vault_only", "")).strip().lower() in (
+            "true", "1", "yes", "on")
+    except Exception:
+        return False
+
