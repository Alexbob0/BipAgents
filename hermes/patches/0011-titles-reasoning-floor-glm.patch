+def test_glm_is_floored_up_front_because_it_answers_empty_when_disabled():
+    """GLM through an OpenAI-compatible relay (EUrouter) accepts reasoning disabled but answers empty, so
+    titles stayed empty: its thinking-off aux calls go out at the floor before any request; other models
+    and an enabled config (the agent's own level) are left alone."""
+    disabled = {"enabled": False}
+    base = "https://api.eurouter.ai/v1"
+    for model in ("glm-5.3-flash", "z-ai/GLM-5.3", "zai-org/glm-4.6"):
+        assert auxiliary_reasoning_floor.known_reasoning_floor(disabled, "custom", base, model, "title_generation") == {
+            "enabled": True, "effort": auxiliary_reasoning_floor.REASONING_FLOOR_EFFORT,
+        }
+    assert auxiliary_reasoning_floor.known_reasoning_floor(disabled, "custom", base, "deepseek-v3.2") == disabled
+    own = {"enabled": True, "effort": "medium"}
+    assert auxiliary_reasoning_floor.known_reasoning_floor(own, "custom", base, "glm-5.3-flash") == own
