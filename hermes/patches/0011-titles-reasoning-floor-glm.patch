+def _answers_empty_when_disabled(model: Optional[str]) -> bool:
+    """GLM (Z.ai) behind OpenAI-compatible relays (EUrouter) accepts a reasoning disable but answers with
+    empty content: no 400 to learn from, so titles stayed empty. Floored up front, by model name."""
+    name = str(model or "").strip().lower().rsplit("/", 1)[-1]
+    return name.startswith("glm")
