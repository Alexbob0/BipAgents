+def get_cron_timezone() -> Optional[ZoneInfo]:
+    """The zone cron schedules are read in: ``cron.timezone`` when set, else :func:`get_timezone`.
+
+    Apart from ``timezone`` so that someone who travels gets the time of where they are at once
+    (prompts, terminal) while their routines stay at home time until they choose to move them."""
