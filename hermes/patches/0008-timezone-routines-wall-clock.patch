--- /dev/null
+++ b/tests/cron/test_cron_wall_clock_once_and_zone.py
@@ -0,0 +1,130 @@
+"""A routine pinned to given hours runs once at each wall-clock time across the autumn fall-back,
+whatever recomputes its next run (the claim at the slot, the end of a long run, a recompute
+from "now"), and ``cron.timezone`` keeps routines on another zone than the profile's.
+
+Europe/Paris leaves summer time on Sunday 25 October 2026 (03:00 CEST → 02:00 CET): before,
+``30 2 * * *`` whose run ended in the repeated hour got 02:30 CET the same night (it ran twice),
+and ``59 2 * * *`` ran twice even with a one-minute run.
+"""
+
+from datetime import datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pytest
+
+pytest.importorskip("croniter")
+
+import hermes_time
+from cron import jobs
+from cron.jobs import compute_next_run
+
+PARIS = ZoneInfo("Europe/Paris")
+TOKYO = ZoneInfo("Asia/Tokyo")
+
+
+@pytest.fixture
+def paris(monkeypatch):
+    monkeypatch.setenv("HERMES_TIMEZONE", "Europe/Paris")
+    hermes_time.reset_cache()
+    yield
+    hermes_time.reset_cache()
+
+
+def _fires(monkeypatch, expr: str, start: datetime, hours: int, run_minutes: int) -> list[datetime]:
+    """Ticks every 30 s: the claim computes the next run from the fire time, the end of the run
+    from its end time (mark_job_run)."""
+    schedule = {"kind": "cron", "expr": expr}
+    start = start.astimezone(ZoneInfo("UTC"))  # ticks in real time, not wall time
+    clock = [start]
+    monkeypatch.setattr(jobs, "_hermes_now", lambda: clock[0])
+    nxt = compute_next_run(schedule)
+    fires, busy_until, t = [], None, start
+    while t < start + timedelta(hours=hours):
+        clock[0] = t
+        if busy_until and t >= busy_until:
+            nxt, busy_until = compute_next_run(schedule, t.isoformat()), None
+        if not busy_until and nxt and t >= datetime.fromisoformat(nxt):
+            fires.append(t)
+            nxt = compute_next_run(schedule, t.isoformat())
+            busy_until = t + timedelta(minutes=run_minutes)
+        t += timedelta(seconds=30)
+    return fires
+
+
+@pytest.mark.parametrize("expr", ["30 2 * * *", "0 2 * * *", "59 2 * * *", "15 2 * * *"])
+@pytest.mark.parametrize("run_minutes", [1, 45])
+def test_a_routine_in_the_repeated_hour_runs_once(paris, monkeypatch, expr, run_minutes):
+    start = datetime(2026, 10, 24, 20, 0, tzinfo=PARIS)
+    fires = _fires(monkeypatch, expr, start, hours=12, run_minutes=run_minutes)
+    assert len(fires) == 1, [f.isoformat() for f in fires]
+    wall = fires[0].astimezone(PARIS)
+    assert (wall.hour, wall.minute) == tuple(int(x) for x in reversed(expr.split()[:2]))
+    assert wall.utcoffset() == timedelta(hours=2)  # the first pass, summer time
+
+
+def test_a_base_in_the_second_pass_waits_for_the_next_day(paris):
+    base = datetime(2026, 10, 25, 2, 10, tzinfo=PARIS, fold=1)  # 02:10 CET, after 02:30 CEST ran
+    nxt = datetime.fromisoformat(compute_next_run({"kind": "cron", "expr": "30 2 * * *"}, base.isoformat()))
+    assert nxt.astimezone(PARIS).isoformat() == "2026-10-26T02:30:00+01:00"
+
+
+def test_an_hour_wildcard_job_keeps_running_in_the_second_pass(paris):
+    base = datetime(2026, 10, 25, 2, 10, tzinfo=PARIS, fold=1)
+    nxt = datetime.fromisoformat(compute_next_run({"kind": "cron", "expr": "*/15 * * * *"}, base.isoformat()))
+    assert nxt.astimezone(PARIS).isoformat() == "2026-10-25T02:15:00+01:00"
+
+
+def test_spring_forward_runs_once_after_the_gap(paris, monkeypatch):
+    start = datetime(2027, 3, 27, 20, 0, tzinfo=PARIS)
+    fires = _fires(monkeypatch, "30 2 * * *", start, hours=12, run_minutes=1)
+    assert [f.astimezone(PARIS).isoformat() for f in fires] == ["2027-03-28T03:30:00+02:00"]
+
+
+def test_cron_timezone_keeps_routines_on_another_zone(monkeypatch, tmp_path):
+    (tmp_path / "config.yaml").write_text("timezone: Asia/Tokyo\ncron:\n  timezone: Europe/Paris\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_TIMEZONE", raising=False)
+    hermes_time.reset_cache()
+    try:
+        assert hermes_time.get_timezone_name() == "Asia/Tokyo"
+        assert hermes_time.get_cron_timezone() == PARIS
+        base = datetime(2026, 10, 24, 12, 0, tzinfo=TOKYO)
+        nxt = datetime.fromisoformat(compute_next_run({"kind": "cron", "expr": "0 7 * * *"}, base.isoformat()))
+        assert nxt.astimezone(PARIS).isoformat() == "2026-10-24T07:00:00+02:00"  # 12:00 Tokyo = 05:00 Paris
+        assert jobs._cron_next_run_matches_expr({"kind": "cron", "expr": "0 7 * * *"}, nxt.astimezone(TOKYO))
+    finally:
+        hermes_time.reset_cache()
+
+
+def test_a_rewritten_timezone_is_read_without_a_restart(monkeypatch, tmp_path):
+    config = tmp_path / "config.yaml"
+    config.write_text("timezone: Europe/Paris\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_TIMEZONE", raising=False)
+    hermes_time.reset_cache()
+    try:
+        assert hermes_time.get_timezone_name() == "Europe/Paris"
+        config.write_text("timezone: Asia/Tokyo\n")
+        stat = config.stat()
+        import os
+
+        os.utime(config, ns=(stat.st_atime_ns, stat.st_mtime_ns + 1_000_000))
+        assert hermes_time.get_timezone_name() == "Asia/Tokyo"
+        assert hermes_time.get_cron_timezone() == TOKYO  # no cron.timezone: the profile's
+    finally:
+        hermes_time.reset_cache()
+
+
+def test_terminal_commands_get_the_profile_zone(monkeypatch):
+    from tools.environments import base
+
+    monkeypatch.setenv("HERMES_TIMEZONE", "America/New_York")
+    hermes_time.reset_cache()
+    try:
+        assert base._with_profile_tz("date") == "export TZ=America/New_York\ndate"
+        monkeypatch.setenv("HERMES_TIMEZONE", "")
+        hermes_time.reset_cache()
+        monkeypatch.setattr(hermes_time, "get_timezone_name", lambda: "")
+        assert base._with_profile_tz("date") == "date"
+    finally:
+        hermes_time.reset_cache()
