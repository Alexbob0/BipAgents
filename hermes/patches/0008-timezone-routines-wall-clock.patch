+def _with_profile_tz(command: str) -> str:
+    """``command`` after an ``export TZ=`` of the active profile's configured zone, so ``date`` and
+    every program the agent runs (local, docker, ssh…) tell the person's time, as execute_code
+    already does. After the snapshot is sourced, so a zone changed mid-session is followed at the
+    next command; an inline ``TZ=… cmd`` still wins. Unconfigured, or on Windows: unchanged."""
+    if os.name == "nt":
+        return command
+    try:
+        from hermes_time import get_timezone_name
 
+        name = get_timezone_name()
+    except Exception:
+        return command
+    if not name:
+        return command
+    return f"export TZ={shlex.quote(name)}\n{command}"
+
 
