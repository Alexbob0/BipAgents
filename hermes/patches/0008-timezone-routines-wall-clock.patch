+        section = _load_config().get("cron")
+        name = section.get("timezone", "") if isinstance(section, dict) else ""
+        name = name.strip() if isinstance(name, str) else ""
+        tz = None
+        if name:
+            try:
+                tz = ZoneInfo(name)
+            except Exception as exc:
+                logger.warning("Invalid cron.timezone '%s': %s. Using the profile timezone.", name, exc)
+        with _cache_lock:
