+"""An MCP tool's result never carries a vault password to the model (BipAgents patch 0013)."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tools import mcp_tool_handlers as handlers
+
+
+@pytest.fixture()
+def vault(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    handlers._VAULT_LOGINS_SEEN.clear()
+    from agent import redact
+    redact.clear_vault_redaction_values()
+    from agent.vault_store import VaultStore
+    store = VaultStore(base_dir=tmp_path / "vault")
+    monkeypatch.setattr("agent.vault_store.get_vault_store", lambda: store)
+    yield store
+    redact.clear_vault_redaction_values()
+
+
+def result_of(text):
+    return SimpleNamespace(content=[SimpleNamespace(type="text", text=text)], structuredContent=None, isError=False)
+
+
+def test_a_page_script_reading_a_filled_password_gets_it_redacted(vault):
+    vault.add_item("login", "Shop", {"identifier_type": "email", "identifier": "a@b.example",
+                                     "password": 'S3cr"et\\pw!é'}, origin="https://shop.example")
+    page = json.dumps({"result": 'S3cr"et\\pw!é', "other": "kept"})   # the server's JSON text block
+    out = handlers._scrub_vault_values(handlers._render_call_tool_result(result_of(page), "stealth"))
+    assert "S3cr" not in out and "redacted-vault-secret" in out and "kept" in out
+    assert handlers._scrub_vault_values("S3cr et pw") == "S3cr et pw"   # only the exact bytes
+
+
+def test_a_login_saved_later_is_scrubbed_too_and_text_without_one_is_untouched(vault):
+    assert handlers._scrub_vault_values("nothing secret here") == "nothing secret here"
+    vault.add_item("login", "Bank", {"identifier_type": "username", "identifier": "alex",
+                                     "password": "Tr0ub4dor&3-late"}, origin="https://bank.example")
+    import os
+    os.utime(vault._vault_path, ns=(1, 1))   # a new copy of the vault file (mtime changed)
+    assert handlers._scrub_vault_values("value=Tr0ub4dor&3-late") == "value=«redacted-vault-secret»"
+
+
+def test_the_tool_handler_scrubs_what_the_server_returned(vault, monkeypatch):
+    vault.add_item("login", "Shop", {"identifier_type": "email", "identifier": "a@b.example",
+                                     "password": "hunter2-hunter2"}, origin="https://shop.example")
+    seen = []
+
+    def dispatch(server_name, server, op, call, *args, **kwargs):
+        import asyncio
+        seen.append(asyncio.run(call()))
+        return seen[-1]
+
+    async def call_tool(server, server_name, tool_name, args):
+        return result_of("the field holds hunter2-hunter2")
+
+    class Lock:
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *exc):
+            return False
+
+    server = SimpleNamespace(_rpc_lock=Lock(), _pending_call_context=None)
+    monkeypatch.setattr(handlers, "_trust_gate_check", lambda *a: None)
+    monkeypatch.setattr(handlers, "_check_circuit_breaker", lambda *a: None)
+    monkeypatch.setattr(handlers, "_acquire_call_server", lambda *a: (server, None))
+    monkeypatch.setattr(handlers, "_tool_is_read_only", lambda *a: True)
+    monkeypatch.setattr(handlers, "_call_tool_racing_stdio_death", call_tool)
+    monkeypatch.setattr(handlers, "_dispatch", dispatch)
+
+    class Inflight:
+        def __init__(self, *a, **k):
+            pass
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *exc):
+            return False
+
+    monkeypatch.setattr(handlers, "_track_inflight_rpc", Inflight)
+    out = handlers._make_tool_handler("stealth", "execute_script", 30)({"script": "f.value"})
+    assert "hunter2-hunter2" not in out and "«redacted-vault-secret»" in out
