         return json.dumps({"result": text_result}, ensure_ascii=False)
 
 
+_VAULT_LOGINS_SEEN: dict = {}  # vault file -> mtime_ns of the copy whose passwords are registered
+
+
+def _escaped_forms(value: str) -> set:
+    """The password as it may sit in a rendered result: as is, JSON-escaped once or twice (a server's JSON text block,
+    then this handler's own JSON), with or without ``\\uXXXX`` for non-ASCII."""
+    forms = {value}
+    for _ in range(2):
+        forms |= {json.dumps(f, ensure_ascii=a)[1:-1] for f in list(forms) for a in (False, True)}
+    return forms
+
+
+def _register_vault_logins() -> None:
+    """Every login password of this profile's vault, registered with the vault redaction boundary
+    (agent/redact.py), read again only when the vault file changes. A password typed into a page by someone else
+    than ``browser_vault_fill`` in this process (an earlier run, the app's bridge creating an account) is covered too."""
+    try:
+        from agent.redact import register_vault_redaction_value
+        from agent.vault_store import get_vault_store
+        store = get_vault_store()
+        path = store._vault_path
+        try:
+            stamp = path.stat().st_mtime_ns
+        except FileNotFoundError:
+            return
+        if _VAULT_LOGINS_SEEN.get(str(path)) == stamp:
+            return
+        for meta in store.list_items():
+            if meta.kind != "login":
+                continue
+            password = str(store.resolve_secret(meta.id).get("password") or "")
+            for form in _escaped_forms(password) if password else ():
+                register_vault_redaction_value(form)
+        _VAULT_LOGINS_SEEN[str(path)] = stamp
+    except Exception:  # never let the scrub break a tool call; the fill-time registrations still apply
+        logger.debug("vault scrub: could not read the vault's logins", exc_info=True)
+
+
+def _scrub_vault_values(text: Any) -> Any:
+    """An MCP tool's result, as the model will see it, without any vault password (``«redacted-vault-secret»``).
+
+    Hermes scrubs its own ``browser_*`` results; an MCP server driving the same browser (a page script reading the
+    field the vault just filled) went to the model untouched."""
+    if not isinstance(text, str) or not text:
+        return text
+    _register_vault_logins()
+    from agent.redact import redact_registered_vault_values
+    return redact_registered_vault_values(text)
+
+
