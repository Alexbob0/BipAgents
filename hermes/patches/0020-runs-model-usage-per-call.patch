+def _usage_counters(agent) -> dict[str, int]:
+    """The agent's session counters in the terminal ``usage`` shape plus ``reasoning_tokens`` and ``call`` (its API
+    call count); a missing or non-numeric counter reads as ``0``."""
+    counters = _run_usage(agent)
+    for key, attr in (("reasoning_tokens", "session_reasoning_tokens"), ("call", "session_api_calls")):
+        value = getattr(agent, attr, 0)
+        counters[key] = int(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else 0
+    return counters
+
+
+def _model_usage_fields(usage: dict[str, Any], agent, base: Optional[dict[str, int]] = None) -> dict[str, Any]:
+    """``model.usage`` payload (BipAgents patch 0020): the call's number, its provider usage, then the run's totals
+    so far in the terminal ``usage`` shape plus reasoning. ``input_tokens`` is the whole prompt, cache reads
+    included, as in the terminal ``usage``. ``base``: the counters when the run's turn started (``_usage_counters``),
+    for an agent that lives across turns (the session authority's cached agent); without it they start at 0."""
+    def n(value: Any) -> int:
+        return int(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else 0
+
+    now = _usage_counters(agent)
+    totals = {key: max(0, value - (base or {}).get(key, 0)) for key, value in now.items()}
+    call = totals.pop("call")
+    return {"call": call,
+            "input_tokens": n(usage.get("prompt_tokens")), "output_tokens": n(usage.get("output_tokens")),
+            "cache_read_tokens": n(usage.get("cache_read_tokens")),
+            "cache_write_tokens": n(usage.get("cache_write_tokens")),
+            "reasoning_tokens": n(usage.get("reasoning_tokens")), "totals": totals}
+
