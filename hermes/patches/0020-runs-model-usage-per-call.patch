+def _report_call_usage(agent: Any, usage: Dict[str, int]) -> None:
+    """One call's provider usage, once the session counters hold it, to ``agent.call_usage_callback`` when one is
+    set (the Runs API's ``model.usage`` event, BipAgents patch 0020): a client capping a run's tokens sees each
+    call as it ends, not only the run's total at its end. A call without usage reports nothing. A failing
+    callback never touches the turn."""
+    callback = getattr(agent, "call_usage_callback", None)
+    if not callable(callback):
+        return
+    try:
+        callback(dict(usage))
+    except Exception as exc:
+        logger.debug("call_usage_callback failed: %s", exc)
+
