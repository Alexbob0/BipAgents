--- /dev/null
+++ b/tests/agent/test_now_line.py
@@ -0,0 +1,78 @@
+"""The current time comes with each message, never from the terminal: each routine run's prompt
+starts with a now line in the routines' zone (``cron.timezone``), right across clock changes, and
+the prompt no longer sends the model to ``date``; a session's preview skips the line."""
+
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+import pytest
+
+import hermes_time
+from cron import scheduler_prompt
+
+UTC = ZoneInfo("UTC")
+
+
+@pytest.fixture
+def zones(monkeypatch, tmp_path):
+    def use(profile: str, routines: str):
+        (tmp_path / "config.yaml").write_text(f"timezone: {profile}\ncron:\n  timezone: {routines}\n")
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        monkeypatch.delenv("HERMES_TIMEZONE", raising=False)
+        hermes_time.reset_cache()
+
+    yield use
+    hermes_time.reset_cache()
+
+
+def _prompt_at(monkeypatch, at: datetime) -> str:
+    monkeypatch.setattr(scheduler_prompt, "_hermes_now", lambda: at)
+    return scheduler_prompt._build_job_prompt({"id": "j1", "name": "Matin", "prompt": "Résume ma journée."})
+
+
+@pytest.mark.parametrize("at, line", [
+    # Europe/Paris, 2026-10-25: 03:00 CEST becomes 02:00 CET, the 02:xx hour is lived twice
+    (datetime(2026, 10, 25, 0, 30, tzinfo=UTC), "Sunday, October 25, 2026, 02:30, Europe/Paris (UTC+02:00)"),
+    (datetime(2026, 10, 25, 1, 30, tzinfo=UTC), "Sunday, October 25, 2026, 02:30, Europe/Paris (UTC+01:00)"),
+    (datetime(2026, 10, 25, 6, 0, tzinfo=UTC), "Sunday, October 25, 2026, 07:00, Europe/Paris (UTC+01:00)"),
+])
+def test_a_routine_run_gets_the_time_in_its_zone_across_autumn_change(zones, monkeypatch, at, line):
+    zones("Asia/Tokyo", "Europe/Paris")  # the person travels, the routines stay at home time
+    prompt = _prompt_at(monkeypatch, at)
+    assert f"<!--bip:now {line}-->\nRésume ma journée." in prompt
+    assert prompt.count("<!--bip:now ") == 1
+
+
+@pytest.mark.parametrize("at, line", [
+    # America/New_York, 2026-03-08: 02:00 EST jumps to 03:00 EDT
+    (datetime(2026, 3, 8, 6, 30, tzinfo=UTC), "Sunday, March 08, 2026, 01:30, America/New_York (UTC-05:00)"),
+    (datetime(2026, 3, 8, 7, 30, tzinfo=UTC), "Sunday, March 08, 2026, 03:30, America/New_York (UTC-04:00)"),
+])
+def test_a_routine_run_gets_the_time_in_its_zone_across_spring_change(zones, monkeypatch, at, line):
+    zones("America/New_York", "America/New_York")
+    assert f"<!--bip:now {line}-->" in _prompt_at(monkeypatch, at)
+
+
+def test_the_prompt_sends_nobody_to_the_terminal_for_the_time():
+    from agent.prompt_builder import OPENAI_MODEL_EXECUTION_GUIDANCE, execution_guidance_text
+    from agent.system_prompt import NOW_LINE_HINT
+
+    for text in (OPENAI_MODEL_EXECUTION_GUIDANCE, execution_guidance_text({"terminal", "execute_code"})):
+        assert "Current time, date, timezone" not in text
+        assert "run `date`" not in text
+        assert "use terminal" in text  # the other lines stay
+    assert "bip:now" in NOW_LINE_HINT and "don't check the clock" in NOW_LINE_HINT
+
+
+def test_a_session_preview_skips_the_now_line():
+    import sqlite3
+
+    from hermes_state_common import _PREVIEW_RAW_SELECT, _shape_preview
+
+    db = sqlite3.connect(":memory:")
+    db.execute("CREATE TABLE messages (content TEXT)")
+    now = "<!--bip:now Thursday, October 29, 2026, 08:40, Europe/Paris (UTC+01:00)-->"
+    for content in (f"{now}\nOn part à Lisbonne quand ?", "Sans heure", "<!--bip:now cut"):
+        db.execute("INSERT INTO messages VALUES (?)", (content,))
+    previews = [_shape_preview(raw) for (raw,) in db.execute(f"SELECT {_PREVIEW_RAW_SELECT} FROM messages m")]
+    assert previews == ["On part à Lisbonne quand ?", "Sans heure", "<!--bip:now cut"]
