diff --git a/tests/agent/test_closed_tools.py b/tests/agent/test_closed_tools.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a7664031fc1aea557d7afda043ed315d029ff6e
--- /dev/null
+++ b/tests/agent/test_closed_tools.py
@@ -0,0 +1,116 @@
+"""Tools closed for one turn of the person's own (BipAgents patch 0023): a voice call's turns leave out the tools that
+make media or long outputs, through ``model_options.closed_tools``."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent import closed_tools
+
+CLOSED = ["text_to_speech", "image_generate", "mcp__bipagents__create_audio", "mcp__stealth__*"]
+OPTIONS = {"reasoning": {"enabled": False}, "closed_tools": CLOSED}
+
+
+def _tool(name):
+    return {"type": "function", "function": {"name": name, "description": name, "parameters": {"type": "object"}}}
+
+
+def _agent():
+    return SimpleNamespace(tools=[_tool(n) for n in ("web_search", "text_to_speech", "mcp__bipagents__create_audio",
+                                                     "mcp__bipagents__calendar_list", "mcp__stealth__navigate")])
+
+
+def test_parse_reads_the_names_and_ignores_a_malformed_value():
+    assert closed_tools.parse(None) is None
+    assert closed_tools.parse({"reasoning": {"enabled": False}}) is None
+    assert closed_tools.parse({"closed_tools": []}) is None
+    assert closed_tools.parse(OPTIONS) == tuple(sorted(CLOSED))
+    for bad in ["text_to_speech", [1], ["a b"], [""], ["x"] * 129]:
+        assert closed_tools.parse({"closed_tools": bad}) is None
+
+
+def test_requests_leave_the_closed_tools_out():
+    agent = _agent()
+    closed_tools.apply(agent, OPTIONS)
+    sent = closed_tools.request_tools(agent, agent.tools)
+    assert [t["function"]["name"] for t in sent] == ["web_search", "mcp__bipagents__calendar_list"]
+    assert closed_tools.request_tools(agent, [_tool("image_generate")]) is None
+
+
+def test_the_next_turn_without_the_mark_gets_every_tool_back():
+    agent = _agent()
+    closed_tools.apply(agent, OPTIONS)
+    closed_tools.apply(agent, {"reasoning": {"enabled": False}})
+    assert closed_tools.request_tools(agent, agent.tools) is agent.tools
+    assert closed_tools.refusal(agent, "text_to_speech") is None
+    assert closed_tools.request_tools(_agent(), _agent().tools) is not None  # never marked: untouched
+
+
+def test_the_dispatcher_refuses_closed_tools_and_prefixes():
+    agent = _agent()
+    closed_tools.apply(agent, OPTIONS)
+    for name in ["text_to_speech", "mcp__bipagents__create_audio", "mcp__stealth__navigate", "mcp__stealth__click"]:
+        assert closed_tools.refusal(agent, name) == closed_tools.REFUSAL
+    for name in ["web_search", "mcp__bipagents__create_audio_x", "mcp__bipagents__calendar_list", "mcp__stealthy"]:
+        assert closed_tools.refusal(agent, name) is None
+
+
+def test_invoke_tool_returns_the_refusal_without_running_anything(monkeypatch):
+    from agent import agent_runtime_helpers
+    import model_tools
+    ran = []
+    monkeypatch.setattr(model_tools, "handle_function_call", lambda *a, **k: ran.append(a) or "{}")
+    agent = _agent()
+    closed_tools.apply(agent, OPTIONS)
+    result = agent_runtime_helpers.invoke_tool(agent, "text_to_speech", {"text": "bonjour"}, "task-1")
+    assert json.loads(result) == {"error": closed_tools.REFUSAL}
+    assert ran == []
+
+
+def test_the_policy_gate_blocks_the_underlying_tool_before_dispatch(monkeypatch):
+    from agent import tool_executor
+    agent = _agent()
+    closed_tools.apply(agent, OPTIONS)
+    agent._tool_guardrails = MagicMock()
+    hooks = []
+    monkeypatch.setattr(tool_executor, "_pre_tool_block", lambda *a: hooks.append(a) or (None, {}))
+    state = tool_executor._ManagedToolResult(result=None, args={}, middleware_trace=[], blocked=False,
+                                             dispatched=True)
+    ref = tool_executor._ToolCallRef("mcp__bipagents__create_audio", {"text": "x"}, "task-1", "call-1", [])
+    monkeypatch.setattr(ref, "emit_post", lambda *a, **k: None, raising=False)
+    executed = []
+    result = tool_executor._dispatch_authorized_once(
+        agent, state, ref, execute=lambda args: executed.append(args), scope_block=None, display_index=None,
+        begin_execution=None, authorization_gate=None)
+    assert json.loads(result) == {"error": closed_tools.REFUSAL}
+    assert state.blocked is True and executed == [] and hooks == []
+
+
+@pytest.mark.asyncio
+async def test_create_agent_marks_the_agent_from_its_model_options(monkeypatch):
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+    host = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+
+    class FakeAgent:
+        def __init__(self, **kwargs):
+            pass
+
+    import gateway.run as gateway_run
+    import run_agent
+    monkeypatch.setattr(run_agent, "AIAgent", FakeAgent)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: {"model": "m"})
+    monkeypatch.setattr(gateway_run, "_load_gateway_config", lambda: {})
+    monkeypatch.setattr(gateway_run, "_checkpoint_agent_kwargs", lambda cfg: {})
+    monkeypatch.setattr(gateway_run, "_current_max_iterations", lambda: 10)
+    monkeypatch.setattr(gateway_run.GatewayRunner, "_load_reasoning_config", staticmethod(lambda m: None))
+    monkeypatch.setattr(gateway_run.GatewayRunner, "_load_fallback_model", staticmethod(lambda: None))
+    monkeypatch.setattr(host, "_select_agent_runtime", lambda kw, model, **k: (model, False, None, None))
+    monkeypatch.setattr(host, "_ensure_session_db", lambda: None)
+    monkeypatch.setattr(host._memory_sessions, "checkout", MagicMock(return_value=None))
+    agent = host._create_agent(session_id="live-1", model_options=OPTIONS)
+    assert agent._closed_tools == tuple(sorted(CLOSED))
+    agent = host._create_agent(session_id="s-alex")
+    assert agent._closed_tools is None
