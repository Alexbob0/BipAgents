     return json.dumps(payload)
 
 
+_SYNC_PEER_TIMEOUT_S = 600
+_SYNC_PEER_HINT = ("\n\n[Synchronous link: answer right here in this turn, as text. Your answer is handed back to the "
+                   "sender automatically. Do not use message_agent to answer and do not wait for anything.]")
+
+
+def _deliver_peer_sync(argv: list[str], content: str, label: str, author: Optional[dict]) -> str:
+    """Run ``hermes peer dm`` inline and hand the peer's reply back as the tool result: a session without async
+    delivery (api_server) can't receive the reply later, and polling the runner while the peer answers into this
+    same busy session waits on itself until the timeouts."""
+    from tools.bot_relay import delivery_env
+    try:
+        proc = subprocess.run(
+            [*argv, "--json"], input=content, capture_output=True, text=True, timeout=_SYNC_PEER_TIMEOUT_S,
+            env=delivery_env(author, None))
+    except subprocess.TimeoutExpired:
+        return _err(f"No reply from {label} within {_SYNC_PEER_TIMEOUT_S}s. The message IS in its Bot Chat and "
+                    "will be answered there; do NOT resend. Tell the user the answer is pending.")
+    except Exception as exc:
+        return _err(f"Delivery to {label} could not be started: {exc}")
+    if proc.returncode != 0:
+        return _err(f"Delivery to {label} failed (exit {proc.returncode}): "
+                    f"{(proc.stderr or proc.stdout or '').strip()[-400:]}")
+    reply = ""
+    for line in reversed((proc.stdout or "").strip().splitlines()):
+        try:
+            data = json.loads(line)
+        except ValueError:
+            continue
+        if isinstance(data, dict):
+            reply = str(data.get("reply") or "")
+            break
+    return json.dumps({
+        "status": "delivered", "to": label, "reply": reply or "(no reply)",
+        "detail": (f"Delivered synchronously: the 'reply' field IS {label}'s answer. Relay it to the user now, "
+                   "attributed to that agent. Nothing to wait for — do not poll."),
+    }, ensure_ascii=False)
+
+
 def message_agent_tool(target: str = "", message: str = "", task_id: Optional[str] = None, agent: Any = None) -> str:
     """Deliver ``message`` to ``target``'s Bot Chat. Returns a JSON ack/error.
     ``agent`` is the calling AIAgent — used for the Bot Chat gate and sender identity."""
