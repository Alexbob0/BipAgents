+"""A peer message from a session without async delivery (api_server) waits for the peer's reply and returns it."""
+import json
+import subprocess
+
+from tools import bot_mode_dm
+
+
+def test_peer_reply_comes_back_as_the_tool_result(monkeypatch):
+    seen = {}
+
+    def run(argv, **kwargs):
+        seen["argv"], seen["input"] = argv, kwargs["input"]
+        return subprocess.CompletedProcess(argv, 0, stdout='progress\n{"reply": "Le train de 9 h."}\n', stderr="")
+
+    monkeypatch.setattr(bot_mode_dm.subprocess, "run", run)
+    result = json.loads(bot_mode_dm._deliver_peer_sync(["hermes", "peer", "dm", "bip/vie"], "Quel train ?", "@vie", None))
+    assert result["status"] == "delivered" and result["reply"] == "Le train de 9 h."
+    assert seen["argv"][-1] == "--json" and seen["input"] == "Quel train ?"
+
+
+def test_a_peer_that_does_not_answer_in_time_is_not_asked_again(monkeypatch):
+    def run(argv, **kwargs):
+        raise subprocess.TimeoutExpired(argv, 600)
+
+    monkeypatch.setattr(bot_mode_dm.subprocess, "run", run)
+    result = json.loads(bot_mode_dm._deliver_peer_sync(["hermes", "peer", "dm", "bip/vie"], "Quel train ?", "@vie", None))
+    assert "do NOT resend" in json.dumps(result)
