diff --git a/tests/agent/test_prompt_cache_stable.py b/tests/agent/test_prompt_cache_stable.py
new file mode 100644
index 0000000000000000000000000000000000000000..a23a3dc93662cb249d1ba44196034907f8fe5264
--- /dev/null
+++ b/tests/agent/test_prompt_cache_stable.py
@@ -0,0 +1,171 @@
+"""BipAgents 0023: a system prompt that stays the same across an agent's conversations (prefix cache).
+
+- the Bot Chat's own section comes after everything the Bot Chat shares with the agent's other conversations;
+- the memory blocks are the day's copy; what is written later reaches the model in a turn note, so an agent still
+  knows a fact it stored in an earlier conversation of the same day;
+- the Runs API's instructions come as a note on the turn's message, not at the end of the system prompt.
+"""
+
+from datetime import datetime
+from types import SimpleNamespace
+from unittest.mock import patch
+from zoneinfo import ZoneInfo
+
+import pytest
+
+from agent import prompt_cache_notes as notes
+from agent.system_prompt import build_system_prompt
+from tools.memory_tool_store import MemoryStore
+
+
+@pytest.fixture
+def memory_dir(tmp_path, monkeypatch):
+    monkeypatch.setattr("tools.memory_tool.get_memory_dir", lambda: tmp_path)
+    return tmp_path
+
+
+def _at(monkeypatch, day: int):
+    monkeypatch.setattr("hermes_time.now", lambda: datetime(2026, 11, day, 9, 0, tzinfo=ZoneInfo("Europe/Paris")))
+
+
+def _store(prompt_refresh="daily") -> MemoryStore:
+    store = MemoryStore(prompt_refresh=prompt_refresh)
+    store.load_from_disk()
+    return store
+
+
+def _agent(store, **extra):
+    base = dict(load_soul_identity=False, skip_context_files=True, valid_tool_names=[],
+                _task_completion_guidance=False, _tool_use_enforcement=False, _environment_probe=False,
+                _kanban_worker_guidance="", _memory_store=store, _memory_manager=None,
+                _memory_enabled=True, _user_profile_enabled=True, model="", provider="", platform="api_server",
+                pass_session_id=False, session_id="s1", _emit_status=lambda *a, **k: None)
+    base.update(extra)
+    return SimpleNamespace(**base)
+
+
+def _prompt(agent, bot_section=None):
+    with (patch("agent.prompt_builder.load_soul_md", return_value=""),
+          patch("agent.prompt_builder.build_environment_hints", return_value=""),
+          patch("agent.system_prompt._bot_mode_parts", return_value=[bot_section] if bot_section else [])):
+        return build_system_prompt(agent)
+
+
+def _sent(history, note):
+    """The turn's user message as the next turn replays it (the note in its API copy)."""
+    return [*history, {"role": "user", "content": "hello", "api_content": "hello\n\n" + note}]
+
+
+# -- Bot Chat section ------------------------------------------------------------------------------------------------
+
+def test_bot_chat_section_comes_after_the_shared_prompt(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    store = MemoryStore()
+    store.add("user", "Chat de l'utilisateur : Moustache.")
+    store = _store()
+    thread = _prompt(_agent(store))
+    bot_chat = _prompt(_agent(store), bot_section="## Messaging other agents\nroster")
+    cut = bot_chat.index("## Messaging other agents")
+    # memory and the profile line come before it: a thread and the Bot Chat share all of that
+    assert bot_chat.index("Moustache") < cut and bot_chat.index("Active Hermes profile") < cut
+    assert thread.startswith(bot_chat[:cut].rstrip())
+    assert bot_chat.index("Conversation started") > cut
+
+
+# -- memory: the day's copy --------------------------------------------------------------------------------------------
+
+def test_the_prompt_shows_the_days_copy_until_the_next_day(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    store = _store()
+    store.add("memory", "Vélo rouge.")            # written after the day's first load
+    later = _store()
+    assert later.format_for_system_prompt("memory") is None   # same day: the morning's copy (empty)
+    assert later.memory_entries == ["Vélo rouge."]             # the live entries are current
+    _at(monkeypatch, 4)
+    assert "Vélo rouge." in _store().format_for_system_prompt("memory")   # the night's refresh
+
+
+def test_session_refresh_keeps_upstream_behaviour(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    store = _store("session")
+    store.add("memory", "Vélo rouge.")
+    assert "Vélo rouge." in _store("session").format_for_system_prompt("memory")
+    assert not (memory_dir / ".prompt-day.json").exists()
+
+
+def test_an_agent_knows_a_fact_it_stored_in_an_earlier_conversation_today(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    first = _store()
+    first.add("user", "Déménage à Nantes le 12.")   # conversation 1 stores it
+    # conversation 2, same day: the prompt is the morning's (no fact) — the turn note brings it
+    agent = _agent(_store())
+    prompt = _prompt(agent)
+    assert "Nantes" not in prompt
+    assert notes.stage_memory_note(agent, prompt, []) is True
+    note = notes.consume_memory_note(agent)
+    assert "USER PROFILE: Déménage à Nantes le 12." in note
+    # the next turn replays that note: nothing new to tell
+    history = _sent([], note)
+    agent = _agent(_store())
+    assert notes.stage_memory_note(agent, prompt, history) is False
+    # removed later in the day: the note says so (full difference against the prompt)
+    _store().remove("user", "Nantes")
+    agent = _agent(_store())
+    assert notes.stage_memory_note(agent, prompt, history) is True
+    assert notes.consume_memory_note(agent) == notes.render_memory_note([], [])
+
+
+def test_entries_in_the_prompt_since_the_morning_and_removed_since(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    store = MemoryStore()
+    store.add("memory", "Aime le thé.")
+    store.add("memory", "Vélo rouge.")
+    agent = _agent(_store())
+    prompt = _prompt(agent)
+    assert notes.prompt_entries(prompt, "memory") == ["Aime le thé.", "Vélo rouge."]
+    assert notes.stage_memory_note(agent, prompt, []) is False      # nothing changed: no note
+    _store().remove("memory", "thé")
+    agent = _agent(_store())
+    assert notes.stage_memory_note(agent, prompt, []) is True
+    assert "No longer in your memory" in agent._memory_note and "MEMORY: Aime le thé." in agent._memory_note
+
+
+def test_no_memory_note_for_a_guest_turn(memory_dir, monkeypatch):
+    _at(monkeypatch, 3)
+    store = _store()
+    store.add("user", "Secret.")
+    agent = _agent(_store(), _guest_tools=frozenset())
+    assert notes.stage_memory_note(agent, _prompt(agent), []) is False
+
+
+# -- run instructions ------------------------------------------------------------------------------------------------
+
+def test_run_instructions_come_once_as_a_turn_note(memory_dir):
+    agent = _agent(None, ephemeral_system_prompt="Salon « Vacances » : réponds en deux phrases.")
+    assert notes.stage_instructions_note(agent, []) is True
+    assert agent.ephemeral_system_prompt is None              # never appended to the system prompt
+    note = notes.consume_instructions_note(agent)
+    assert note.startswith(notes.INSTRUCTIONS_NOTE_PREFIX) and "deux phrases" in note
+    history = _sent([], note)
+    # the next run with the same instructions (a cached agent keeps them on _run_instructions)
+    assert notes.stage_instructions_note(agent, history) is False
+    fresh = _agent(None, ephemeral_system_prompt="Salon « Vacances » : réponds en deux phrases.")
+    assert notes.stage_instructions_note(fresh, history) is False and fresh.ephemeral_system_prompt is None
+    # changed instructions (a hand-over in the room): told again
+    changed = _agent(None, ephemeral_system_prompt="Salon « Vacances » : Budget reprend la main.")
+    assert notes.stage_instructions_note(changed, history) is True
+
+
+def test_instructions_stay_in_the_system_prompt_off_the_api_server():
+    agent = _agent(None, platform="telegram", ephemeral_system_prompt="Channel rules.")
+    assert notes.stage_instructions_note(agent, []) is False
+    assert agent.ephemeral_system_prompt == "Channel rules."
+
+
+def test_the_notes_join_the_turns_message():
+    from agent.turn_context import _merge_gateway_notes
+    agent = SimpleNamespace(_instructions_note="[System: I]", _memory_note="[System: M]")
+    with patch("agent.turn_context.forward_lsp_verdicts"):
+        merged = _merge_gateway_notes(agent, [{"role": "user", "content": "hi"}], 0, "")
+    assert merged.index("[System: I]") < merged.index("[System: M]")
+    assert agent._instructions_note == "" and agent._memory_note == ""
