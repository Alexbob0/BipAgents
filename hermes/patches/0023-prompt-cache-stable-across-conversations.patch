diff --git a/agent/prompt_cache_notes.py b/agent/prompt_cache_notes.py
new file mode 100644
index 0000000000000000000000000000000000000000..918605650c79aa3de737489d551bea45c732fdf3
--- /dev/null
+++ b/agent/prompt_cache_notes.py
@@ -0,0 +1,184 @@
+"""BipAgents 0023: what changes during the day reaches the model in the turn's message, not in the system prompt.
+
+A provider's prefix cache only reuses the identical beginning of a request. The system prompt is that beginning for
+every conversation of an agent, so anything in it that moves between conversations (the memory an agent just wrote,
+a run's instructions) costs the cache of all that follows it, the tool schemas included on templates that put them
+after the system prompt (DeepSeek). Two per-turn notes, on the same channel as the skills-index note (a note joins
+the API copy of the turn's user message, persisted with it as its ``api_content``, so the next turn replays the same
+bytes):
+
+- **memory**: the system prompt carries the day's copy of MEMORY.md / USER.md (``memory.prompt_refresh: daily``,
+  tools/memory_tool_store.py); what was written since (by this agent, by another of the person's agents through
+  BipAgents' shared memory, by the person in the app) is told in a note: the entries added, the entries removed.
+  Each note states the full difference against the prompt, and a new note is sent only when that difference
+  changes, so an agent knows a fact it stored in an earlier conversation of the same day. The night's first
+  conversation takes the new copy into its prompt.
+- **run instructions**: the Runs API's ``instructions`` (a room's rules, a background task's brief, a Live call's
+  brief) used to be appended to the system prompt of each call. On ``api_server`` they now come as a note on the
+  turn's message, once, and again only when they change in that conversation.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+from agent.message_content import flatten_message_text
+
+logger = logging.getLogger("run_agent")
+
+_SEP = "═" * 46
+
+MEMORY_NOTE_PREFIX = "[System: Your memory changed after this conversation's system prompt was built (its copy there is refreshed each night)."
+_MEMORY_NOTE_END = "(end of memory note)]"
+_ADDED_HEAD = "Now in your memory too:"
+_REMOVED_HEAD = "No longer in your memory (disregard these entries of the system prompt):"
+_ACCURATE = " The memory in your system prompt is accurate again; earlier memory notes are superseded."
+_LABELS = {"memory": "MEMORY", "user": "USER PROFILE"}
+
+INSTRUCTIONS_NOTE_PREFIX = "[System: Instructions for this conversation, from the app (follow them like your system prompt):"
+_INSTRUCTIONS_NOTE_END = "(end of instructions)]"
+
+
+def _newest_note(history: Any, prefix: str, end: str) -> Optional[str]:
+    """The newest note starting with ``prefix`` in the transcript's user messages (API copy first), whole."""
+    for msg in reversed(history or []):
+        if not isinstance(msg, dict) or msg.get("role") != "user":
+            continue
+        sidecar = msg.get("api_content")
+        for text in ((sidecar if isinstance(sidecar, str) else ""), flatten_message_text(msg.get("content"))):
+            if prefix in text:
+                tail = text.rsplit(prefix, 1)[1]
+                cut = tail.find(end)
+                return prefix + (tail[:cut] + end if cut >= 0 else tail)
+    return None
+
+
+# -- memory ----------------------------------------------------------------------------------------------------------
+
+def prompt_entries(prompt: Any, target: str) -> list[str]:
+    """The entries of ``target``'s block (``memory`` / ``user``) in a system prompt; [] without one."""
+    from tools.memory_tool_store import ENTRY_DELIMITER, MEMORY_BLOCK_HEADERS
+    if not isinstance(prompt, str):
+        return []
+    head = f"{_SEP}\n{MEMORY_BLOCK_HEADERS[target]} ["
+    start = prompt.find(head)
+    if start < 0:
+        return []
+    body = prompt.find(f"\n{_SEP}\n", start + len(head))
+    if body < 0:
+        return []
+    rest = prompt[body + len(_SEP) + 2:]
+    # The block ends where the next part starts: the other memory block, or the profile line (agent/system_prompt.py
+    # puts plugin and provider blocks there too, each a paragraph of its own).
+    ends = [k for k in (rest.find("\n\n" + _SEP), rest.find("\n\nActive Hermes profile:")) if k >= 0]
+    rest = rest[:min(ends)] if ends else rest
+    entries = [e.strip() for e in rest.split(ENTRY_DELIMITER)]
+    if entries and "\n\n" in entries[-1]:
+        entries[-1] = entries[-1].split("\n\n", 1)[0].strip()
+    return [e for e in entries if e]
+
+
+def _live_entries(store: Any, target: str) -> list[str]:
+    """The entries on disk now (another process may have written them), threat-flagged ones left out."""
+    from tools.threat_patterns import scan_for_threats
+    entries = list(dict.fromkeys(store._read_file(store._path_for(target))))
+    return [e for e in entries if not scan_for_threats(e, scope="strict")]
+
+
+def render_memory_note(added: list[tuple[str, str]], removed: list[tuple[str, str]]) -> str:
+    if not added and not removed:
+        return f"{MEMORY_NOTE_PREFIX}{_ACCURATE} {_MEMORY_NOTE_END}"
+    lines = [MEMORY_NOTE_PREFIX]
+    if added:
+        lines += [_ADDED_HEAD, *(f"- {_LABELS[t]}: {e}" for t, e in added)]
+    if removed:
+        lines += [_REMOVED_HEAD, *(f"- {_LABELS[t]}: {e}" for t, e in removed)]
+    return "\n".join(lines) + "\n" + _MEMORY_NOTE_END
+
+
+def memory_difference(agent: Any, prompt: Any) -> Optional[tuple[list, list]]:
+    """(added, removed) between ``prompt``'s memory blocks and the memory on disk; None when not applicable."""
+    store = getattr(agent, "_memory_store", None)
+    if store is None or not isinstance(prompt, str) or not prompt:
+        return None
+    from agent.guest_turn import active as guest_turn
+    if guest_turn(agent):
+        return None
+    added: list[tuple[str, str]] = []
+    removed: list[tuple[str, str]] = []
+    for target, enabled in (("memory", getattr(agent, "_memory_enabled", False)),
+                            ("user", getattr(agent, "_user_profile_enabled", False))):
+        if not enabled:
+            continue
+        before = prompt_entries(prompt, target)
+        now = _live_entries(store, target)
+        added += [(target, e) for e in now if e not in before]
+        removed += [(target, e) for e in before if e not in now and not e.startswith("[BLOCKED:")]
+    return added, removed
+
+
+def stage_memory_note(agent: Any, prompt: Any, conversation_history: Any) -> bool:
+    """Stage the memory note when the difference against the prompt is not what the model was last told."""
+    if getattr(agent, "provider", None) == "moa" or getattr(agent, "api_mode", None) == "codex_app_server":
+        return False  # no api_content sidecar there: the note could not be read back (as the skills note)
+    try:
+        diff = memory_difference(agent, prompt)
+    except Exception:
+        logger.debug("memory note: difference unavailable", exc_info=True)
+        return False
+    if diff is None:
+        return False
+    told = getattr(agent, "_memory_note_told", None)
+    key = hash(prompt)
+    last = told[1] if isinstance(told, tuple) and told[0] == key else _newest_note(
+        conversation_history, MEMORY_NOTE_PREFIX, _MEMORY_NOTE_END)
+    added, removed = diff
+    if not added and not removed and (last is None or last == render_memory_note([], [])):
+        agent._memory_note_told = (key, last)
+        return False
+    note = render_memory_note(added, removed)
+    agent._memory_note_told = (key, note)
+    if note == last:
+        return False
+    agent._memory_note = note
+    logger.info("Session %s: memory changed (+%d/-%d) since the system prompt was built; told in a turn note.",
+                getattr(agent, "session_id", None), len(added), len(removed))
+    return True
+
+
+def consume_memory_note(agent: Any) -> str:
+    note = getattr(agent, "_memory_note", "") or ""
+    agent._memory_note = ""
+    return note if isinstance(note, str) else ""
+
+
+# -- run instructions ------------------------------------------------------------------------------------------------
+
+def render_instructions_note(text: str) -> str:
+    return f"{INSTRUCTIONS_NOTE_PREFIX}\n{text.strip()}\n{_INSTRUCTIONS_NOTE_END}"
+
+
+def stage_instructions_note(agent: Any, conversation_history: Any) -> bool:
+    """On ``api_server``, the run's instructions leave the system prompt for a note on the turn's message, sent when
+    they are not what the conversation was last told. The agent keeps them on ``_run_instructions`` (a cached agent
+    is reused only with the same instructions: they are part of its cache signature)."""
+    if (getattr(agent, "platform", None) or "") != "api_server":
+        return False
+    if getattr(agent, "provider", None) == "moa" or getattr(agent, "api_mode", None) == "codex_app_server":
+        return False
+    text = getattr(agent, "ephemeral_system_prompt", None) or getattr(agent, "_run_instructions", None)
+    if not isinstance(text, str) or not text.strip():
+        return False
+    agent._run_instructions = text
+    agent.ephemeral_system_prompt = None
+    note = render_instructions_note(text)
+    if _newest_note(conversation_history, INSTRUCTIONS_NOTE_PREFIX, _INSTRUCTIONS_NOTE_END) == note:
+        return False
+    agent._instructions_note = note
+    return True
+
+
+def consume_instructions_note(agent: Any) -> str:
+    note = getattr(agent, "_instructions_note", "") or ""
+    agent._instructions_note = ""
+    return note if isinstance(note, str) else ""
