+async def _handle_run_clarify(self, request: web.Request, *, _api_server) -> web.Response:
+    """POST /v1/runs/{run_id}/clarify — answer (``{"request_id", "answers": {qid: text|[texts]|null}}``,
+    null = skip that question) or dismiss (``{"request_id", "cancel": true}``) a pending clarify."""
+    _openai_error = _api_server._openai_error
+    run_id, _, _, _, err = _load_owned_run(
+        self, request, _api_server=_api_server, permission=None, active_fallback=False)
+    if err is not None:
+        return err
+    body, err = await self._read_json_body(request)
+    if err:
+        return err
+    pending = self._run_clarify_requests.get(run_id) or {}
+    raw_request_id = body.get("request_id")
+    request_id = raw_request_id.strip() if isinstance(raw_request_id, str) else ""
+    if not request_id and len(pending) == 1:
+        request_id = next(iter(pending))
+    state = pending.get(request_id)
+    if state is None:
+        return _json_error(
+            _openai_error, f"Run has no pending clarify request{' ' + request_id if request_id else ''}: {run_id}",
+            code="clarify_not_pending", status=404)
+    if state["answered"] or state["cancelled"]:
+        return _json_error(
+            _openai_error, f"Clarify request already resolved: {request_id}", code="clarify_already_resolved",
+            status=409)
+    from tools import clarify_gateway as clarify_mod
+    if _api_server._coerce_request_bool(body.get("cancel"), default=False):
+        state["cancelled"] = True
+        resolved = sum(clarify_mod.resolve_gateway_clarify(cid, clarify_mod.CANCELLED) for cid in state["ids"].values())
+        return web.json_response({
+            "object": "hermes.run.clarify_response", "run_id": run_id, "request_id": request_id,
+            "cancelled": True, "resolved": resolved})
+    answers = body.get("answers")
+    if not isinstance(answers, dict):
+        return _json_error(
+            _openai_error, "Missing 'answers' object ({question_id: answer}) or 'cancel': true.",
+            code="invalid_clarify_answers", status=400)
+    missing = [qid for qid in state["ids"] if qid not in answers]
+    if missing:
