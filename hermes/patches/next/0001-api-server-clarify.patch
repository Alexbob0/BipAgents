+def _register_clarify_questions(questions, request_id: str, session_key: str, redact) -> tuple[
+        dict[str, str], list[dict[str, Any]]]:
+    """Register each question in ``tools.clarify_gateway`` as ``<request_id>:<qid>``; returns
+    ``({qid: clarify_id}, wire questions)``. The wire carries bare labels: "(Recommended)" is
+    presentation, and clients render choice 0 first."""
+    from tools import clarify_gateway as clarify_mod
+    from tools.clarify_tool import strip_recommended
+    ids: dict[str, str] = {}
+    wire_questions: list[dict[str, Any]] = []
+    for index, entry in enumerate(questions or []):
+        qid = str(entry.get("qid") or f"q{index}")
+        question = str(entry.get("question") or "")
+        bare = [strip_recommended(str(c)) for c in (entry.get("choices_offered") or entry.get("choices") or [])]
+        multi_select = bool(entry.get("multi_select"))
+        ids[qid] = f"{request_id}:{qid}"
+        clarify_mod.register(ids[qid], session_key, question, bare or None, multi_select)
+        wire_questions.append({
+            "id": qid, "question": redact(question, force=True), "choices": [redact(c, force=True) for c in bare],
+            "multi_select": multi_select, "allow_other": True})
+    return ids, wire_questions
+
+
+def _clarify_cancel_reason(self, run_id: str, state: dict[str, Any], response: Optional[str]) -> Optional[str]:
+    """Why a clarify wait ended without an answer (``None`` when ``response`` is an answer)."""
+    from tools import clarify_gateway as clarify_mod
+    if response not in (None, "", clarify_mod.CANCELLED):
+        return None
+    if run_id in self._stopping_run_ids:
+        return "stopped"
+    if state["cancelled"]:
+        return "cancelled"
+    return "timeout" if response is None else "stopped"
+
+
+def _make_clarify_callback(self, run: _RunLaunch, *, _api_server) -> Callable[[list], dict]:
+    """``clarify`` bridge for ``/v1/runs`` (the approval bridge's twin), honouring
+    ``tools.clarify_tool``'s ``callback(questions) -> {"answers", "outcome", "notice"?}`` contract:
+    emit ``clarify.request``, park the run as ``waiting_for_input`` and block the agent thread until
+    ``POST /v1/runs/{id}/clarify`` answers or dismisses it, the run is stopped, or
+    ``agent.clarify_timeout`` elapses."""
+    run_id, loop = run.run_id, asyncio.get_running_loop()
+
+    def _clarify(questions) -> dict:
+        from tools import clarify_gateway as clarify_mod
+        request_id = f"clr_{uuid.uuid4().hex[:12]}"
+        ids, wire_questions = _register_clarify_questions(
+            questions, request_id, run.approval_session_key, _api_server.redact_sensitive_text)
+        state: dict[str, Any] = {"ids": ids, "answered": False, "cancelled": False}
+        self._run_clarify_requests.setdefault(run_id, {})[request_id] = state
+        event = _run_event(
+            run_id, "clarify.request", type="clarify.request", request_id=request_id, questions=wire_questions)
+        self._set_run_status(run_id, CLARIFY_WAITING_STATUS, last_event="clarify.request", clarify=event)
+        with suppress(RuntimeError):  # loop already closed (gateway shutdown)
+            loop.call_soon_threadsafe(run.put_event, event)
+        timeout = float(clarify_mod.get_clarify_timeout())
+        deadline = None if timeout <= 0 else time.monotonic() + timeout
+        reply: dict[str, Any] = {"answers": {}, "outcome": "submitted"}
+        reason: Optional[str] = None
+        try:
+            for qid, clarify_id in ids.items():
+                # wait_for_response treats <= 0 as unlimited, so a spent deadline still waits a tick.
+                remaining = 0.0 if deadline is None else max(deadline - time.monotonic(), 0.01)
+                response = clarify_mod.wait_for_response(clarify_id, remaining)
+                reason = _clarify_cancel_reason(self, run_id, state, response)
+                if reason is not None:
+                    break
+                reply["answers"][qid] = None if response == clarify_mod.SKIPPED else response
+        finally:
+            # The resolved request stays (flagged) until the run retires, so a repeated POST gets 409, not 404.
+            state["cancelled" if reason is not None else "answered"] = True
+            if self._run_statuses.get(run_id, {}).get("status") == CLARIFY_WAITING_STATUS:
+                self._set_run_status(
+                    run_id, "running", last_event="clarify.cancelled" if reason is not None else "clarify.responded")
+        if reason is None:
+            return reply
+        clarify_mod.clear_session(run.approval_session_key)  # questions of the batch not yet waited on
+        with suppress(RuntimeError):
+            loop.call_soon_threadsafe(run.put_event, _run_event(
+                run_id, "clarify.cancelled", type="clarify.cancelled", request_id=request_id, reason=reason))
+        if reason == "timeout":
+            return {**reply, "outcome": "timed_out",
+                    "notice": f"The user did not answer within {int(timeout // 60) or 1} minutes."}
+        return {**reply, "outcome": "cancelled", "notice": "The run was stopped." if reason == "stopped"
+                else "The user dismissed the question without answering."}
+
+    return _clarify
+
