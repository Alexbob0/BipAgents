+def _clarify_answer_text(value: Any) -> tuple[str, Any]:
+    """``(text handed to the agent, value echoed on the wire)`` for one answer: ``null`` or blank skips
+    the question, a list is a multi-select pick (JSON array string, decoded by ``tools.clarify_tool``)."""
+    from tools import clarify_gateway as clarify_mod
+    if isinstance(value, list):
+        items = [str(v).strip() for v in value if str(v).strip()]
+        return (json.dumps(items, ensure_ascii=False), items) if items else (clarify_mod.SKIPPED, None)
+    text = "" if value is None else str(value).strip()
+    return (text, text) if text else (clarify_mod.SKIPPED, None)
