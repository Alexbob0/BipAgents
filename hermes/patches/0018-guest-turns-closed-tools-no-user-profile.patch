+"""BipAgents patch 0018 under the session authority: a run's or a session chat's ``guest_turn`` mark rides the
+durable ``api_turn_v1`` admission to the TurnRunner, which builds that turn its own closed agent, never the
+session's cached one."""
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_api_turn import admit_api_turn, api_execution, prepare_api_execution
+from hermes_state_runtime import RuntimeStoreError
+
+GUESTS = frozenset({"mcp__bipagents__weather", "web_search"})
+
+
+def test_the_mark_rides_the_admission_and_stays_with_that_turn(api, owner):
+    authority, ref, row = admit_api_turn(api, session_id="shared", request_id="guest-1", user_message="Bonjour",
+                                         conversation_history=[], guest_tools=GUESTS)
+    data = row["payload"]["api_turn_v1"]
+    assert data["guest_turn"] == {"tools": sorted(GUESTS)}
+    assert "guest_tools" not in data["settings"] and "guest_turn" not in data["settings"]
+    assert prepare_api_execution(authority, ref, row["payload"])["guest_tools"] == GUESTS
+    # The person's next turn in the same session is theirs: the mark is per admission, never a session setting.
+    _, ref2, own = admit_api_turn(api, session_id=ref.session_id, request_id="own-1", user_message="Merci",
+                                  conversation_history=[])
+    assert "guest_turn" not in own["payload"]["api_turn_v1"]
+    assert prepare_api_execution(authority, ref2, own["payload"])["guest_tools"] is None
+    # A payload-less internal turn of that session is the person's too.
+    assert prepare_api_execution(authority, ref2, {"text": "wake"})["guest_tools"] is None
+
+
+def test_an_exact_retry_cannot_drop_or_change_the_mark(api, owner):
+    args = dict(session_id="retry", request_id="same-key", user_message="Salut", conversation_history=[])
+    admit_api_turn(api, guest_tools=GUESTS, **args)
+    with pytest.raises(RuntimeStoreError, match="admission_conflict"):
+        admit_api_turn(api, **args)
+    with pytest.raises(RuntimeStoreError, match="admission_conflict"):
+        admit_api_turn(api, guest_tools=frozenset({"web_search"}), **args)
+
+
+def test_a_malformed_stored_mark_never_runs(api, owner):
+    from gateway.session_api_turn import check_api_turn
+    _, ref, row = admit_api_turn(api, session_id="bad", user_message="x", conversation_history=[], guest_tools=GUESTS)
+    for bad in ({"tools": "web_search"}, {"tools": ["web_search"], "extra": 1}, ["web_search"]):
+        payload = {**row["payload"], "api_turn_v1": {**row["payload"]["api_turn_v1"], "guest_turn": bad}}
+        with pytest.raises(RuntimeStoreError, match="invalid_params"):
+            check_api_turn(owner, ref, payload)
+        with pytest.raises(RuntimeStoreError, match="invalid_params"):
+            prepare_api_execution(owner, ref, payload)
+
+
+def _turn(cache, built):
+    from gateway.run_turn_runner import TurnRunner
+    turn = object.__new__(TurnRunner)
+    turn._ctx = SimpleNamespace(session_key="agent:main:api_server:dm:shared", session_id="shared",
+                                user_config={}, source=SimpleNamespace(user_id="u", user_id_alt=None))
+    turn._runner = SimpleNamespace(_agent_cache=cache, _agent_cache_lock=__import__("threading").Lock(),
+                                   _agent_config_signature=lambda *a, **k: "sig")
+    turn._skip_context_files = lambda platform_key: False
+    turn._build_fresh_agent = lambda *a: built.append(SimpleNamespace(tools=[], valid_tool_names=set())) or built[-1]
+    return turn
+
+
+def test_a_guest_turn_gets_its_own_closed_agent_and_leaves_the_cached_one_alone(monkeypatch):
+    applied = []
+    monkeypatch.setattr("agent.guest_turn.apply", lambda agent, tools: applied.append((agent, tools)))
+    owners_agent = object()
+    cache = {"agent:main:api_server:dm:shared": (owners_agent, "sig", 3, "shared")}
+    built = []
+    turn = _turn(cache, built)
+    token = api_execution.set({"settings": {}, "guest_tools": GUESTS})
+    try:
+        agent, reused = turn._resolve_turn_agent({"model": "m", "runtime": {}}, "api_server", "", 10, None, {})
+    finally:
+        api_execution.reset(token)
+    assert agent is built[0] and agent is not owners_agent and reused is False
+    assert applied == [(agent, GUESTS)]
+    assert cache == {"agent:main:api_server:dm:shared": (owners_agent, "sig", 3, "shared")}   # untouched
+    assert turn._guest_agent is agent
+
+
+def test_the_guest_agent_is_released_after_the_turn(monkeypatch):
+    from gateway.run_turn_runner import TurnRunner
+    turn = object.__new__(TurnRunner)
+    turn._runner = SimpleNamespace()
+    turn._ctx = SimpleNamespace(source=None, session_id="shared")
+    guest = object()
+    released = []
+    monkeypatch.setattr("gateway.session_policy.policy_for_source", lambda runner, source: None)
+    monkeypatch.setattr("gateway.session_authorities.active_authority", lambda runner: None)
+    turn._release_evicted_agent = released.append
+
+    def run():
+        turn._guest_agent = guest
+        return {"final_response": "ok"}
+    turn._run_sync_scoped = run
+    assert turn.run_sync() == {"final_response": "ok"}
+    assert released == [guest] and "_guest_agent" not in turn.__dict__
