new file mode 100644
index 0000000000..bc4860215b
--- /dev/null
+++ b/agent/guest_turn.py
@@ -0,0 +1,139 @@
+"""Guest turns: someone other than the agent's person writes this turn (BipAgents patch 0018).
+
+A client (BipAgents' bridge) marks a run or a session chat with ``guest_turn: {"tools": [...]}`` when the words it
+carries are not the agent's person's: a relative talking to an agent shared with them, a family member talking to the
+family's agent, another household's agent, a relative's discussion. For that turn only:
+
+- the model is offered the listed MCP tools (``mcp__<server>__<tool>``, which the client already limits on its side)
+  and the listed Hermes tools of ``NATIVE_TOOLS`` (``web_search``: it reads nothing of anyone), each in view (never
+  behind the tool search), and nothing else: no terminal, files, browser or vault fill, code execution,
+  ``session_search`` (the person's past conversations), memory writes, routines, messages to other agents,
+  delegation, skills;
+- the dispatcher refuses any other tool a model names anyway (``refusal``), whatever added it to the list;
+- the system prompt leaves out the person's profile (USER.md) and the working directory's context files; MEMORY.md
+  (the agent's own notes) and SOUL.md (its personality) stay; it is built for the turn and never stored on the
+  session, so the person's own next turn gets their usual prompt back;
+- no memory or skill nudge, no background review, no external memory provider (nothing the guest says is written
+  into the agent's memory or skills).
+
+A malformed mark fails the request (400): a client that asks for a closed turn never gets an open one.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+FIELD = "guest_turn"
+# Hermes' own tools a guest turn may keep: they read nothing of the agent's person and act on nothing of theirs.
+NATIVE_TOOLS = frozenset({"web_search"})
+MAX_TOOLS = 64
+MAX_NAME = 200
+REFUSAL = (
+    "This tool is closed during this turn: someone other than your person is writing, and their turns only get the "
+    "tools listed for them. Answer with what you have, without your person's data."
+)
+
+
+class GuestTurnError(ValueError):
+    """A ``guest_turn`` mark is malformed."""
+
+
+def parse(value: Any) -> Optional[frozenset]:
+    """The tools a marked turn may use (``None``: not a guest turn). MCP names and ``NATIVE_TOOLS`` are kept, any
+    other Hermes tool is dropped (closed, never opened by a client's mistake)."""
+    if value is None:
+        return None
+    if not isinstance(value, dict) or set(value) - {"tools"} or not isinstance(value.get("tools"), list):
+        raise GuestTurnError("guest_turn must be an object {\"tools\": [names]}")
+    names = value["tools"]
+    if len(names) > MAX_TOOLS:
+        raise GuestTurnError(f"guest_turn lists more than {MAX_TOOLS} tools")
+    for name in names:
+        if not isinstance(name, str) or not 0 < len(name) <= MAX_NAME or any(c.isspace() for c in name):
+            raise GuestTurnError("guest_turn tools must be tool names")
+    return frozenset(n for n in names if n.startswith("mcp__") or n in NATIVE_TOOLS)
+
+
+def active(agent: Any) -> bool:
+    # Only a set ``apply`` made counts (an agent double whose attributes are all truthy is not a guest).
+    return isinstance(getattr(agent, "_guest_tools", None), frozenset)
+
+
+def _name(tool: Any) -> str:
+    try:
+        return str(tool["function"]["name"])
+    except Exception:
+        return ""
+
+
+def apply(agent: Any, allowed: frozenset) -> None:
+    """Close ``agent`` (freshly built for this turn) to ``allowed``."""
+    agent._guest_tools = frozenset(allowed)
+    defs: list = []
+    try:
+        import model_tools
+        # Raw schemas, every enabled tool: the allowed ones are put in view even when the tool search defers them.
+        defs = model_tools.get_tool_definitions(
+            enabled_toolsets=getattr(agent, "enabled_toolsets", None),
+            disabled_toolsets=getattr(agent, "disabled_toolsets", None),
+            quiet_mode=True, skip_tool_search_assembly=True) or []
+    except Exception:
+        logger.warning("guest turn: tool definitions unavailable, the turn gets no tools", exc_info=True)
+    seen: set = set()
+    kept = []
+    for tool in list(defs) + list(getattr(agent, "tools", None) or []):
+        name = _name(tool)
+        if name in agent._guest_tools and name not in seen:
+            seen.add(name)
+            kept.append(tool)
+    agent._guest_tool_defs = kept
+    narrow(agent)
+    # The person's profile stays out; MEMORY.md (the agent's notes) and the personality stay.
+    agent._user_profile_enabled = False
+    agent.skip_context_files = True
+    agent.load_soul_identity = True
+    # Nothing the guest says goes into memory or skills.
+    agent._memory_nudge_interval = 0
+    agent._skill_nudge_interval = 0
+    agent.skip_background_review = True
+    manager = getattr(agent, "_memory_manager", None)
+    agent._memory_manager = None
+    if manager is not None:
+        try:
+            manager.shutdown_all()
+        except Exception:
+            logger.debug("guest turn: memory provider shutdown failed", exc_info=True)
+    logger.info("guest turn: tools %s", sorted(seen))
+
+
+def narrow(agent: Any) -> None:
+    """Put the turn's tools back to the guest's (after anything that rebuilt or merged the list)."""
+    if not active(agent):
+        return
+    agent.tools = list(getattr(agent, "_guest_tool_defs", []))
+    agent.valid_tool_names = {_name(t) for t in agent.tools}
+
+
+def request_tools(agent: Any, tools: Optional[list]) -> Optional[list]:
+    """The tools a request of this turn sends to the model."""
+    if not active(agent) or tools is None:
+        return tools
+    kept = [t for t in tools if _name(t) in agent._guest_tools]
+    return kept or None
+
+
+def refusal(agent: Any, name: str) -> Optional[str]:
+    """Why ``name`` can't run during this turn (``None``: it can)."""
+    if not active(agent) or name in agent._guest_tools:
+        return None
+    logger.info("guest turn: tool %s refused", name)
+    return REFUSAL
+
+
+def refusal_result(agent: Any, name: str) -> Optional[str]:
+    message = refusal(agent, name)
+    return None if message is None else json.dumps({"error": message}, ensure_ascii=False)
