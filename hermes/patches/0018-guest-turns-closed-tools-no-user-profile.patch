+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    for name in CLOSED:
+        assert guest_turn.refusal(agent, name) == guest_turn.REFUSAL
+    for name in ALLOWED:
+        assert guest_turn.refusal(agent, name) is None
+    assert guest_turn.refusal(_agent(), "terminal") is None  # the person's own turn: untouched
