+"""The api_server takes a run's or a session chat's ``guest_turn`` mark (BipAgents patch 0018) to the agent it builds:
+someone other than the agent's person writes that turn."""
+
+import asyncio
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer, make_mocked_request
+
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+MARK = {"tools": ["mcp__bipagents__weather", "web_search", "terminal"]}
+
+
+def _app(adapter):
+    app = web.Application()
+    app["api_server_adapter"] = adapter
+    app.router.add_post("/v1/runs", adapter._handle_runs)
+    return app
+
+
+def _agent():
+    agent = MagicMock()
+    agent.run_conversation.return_value = {"final_response": "done"}
+    agent.session_prompt_tokens = agent.session_completion_tokens = agent.session_total_tokens = 0
+    return agent
+
+
+@pytest.mark.asyncio
+async def test_a_marked_run_builds_a_closed_agent_and_never_goes_to_a_live_owner():
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    async with TestClient(TestServer(_app(adapter))) as cli:
+        with patch.object(adapter, "_create_agent", return_value=_agent()) as create, \
+                patch.object(adapter, "_admit_to_live_bot_chat", new=AsyncMock(return_value=None)) as live:
+            resp = await cli.post("/v1/runs", json={"input": "Tu sais où est Alex ?", "session_id": "s-marie",
+                                                    "guest_turn": MARK})
+            assert resp.status == 202
+            for _ in range(40):
+                if create.call_args is not None:
+                    break
+                await asyncio.sleep(0.05)
+    assert create.call_args.kwargs["guest_tools"] == frozenset({"mcp__bipagents__weather", "web_search"})
+    live.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_an_unmarked_run_is_the_persons_own():
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    async with TestClient(TestServer(_app(adapter))) as cli:
+        with patch.object(adapter, "_create_agent", return_value=_agent()) as create:
+            resp = await cli.post("/v1/runs", json={"input": "hello"})
+            assert resp.status == 202
+            for _ in range(40):
+                if create.call_args is not None:
+                    break
+                await asyncio.sleep(0.05)
+    assert create.call_args.kwargs["guest_tools"] is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mark", [["web_search"], {"tools": "web_search"}, {"tools": [3]}, {"tools": [], "x": 1}])
+async def test_a_malformed_mark_fails_the_run(mark):
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    async with TestClient(TestServer(_app(adapter))) as cli:
+        with patch.object(adapter, "_create_agent") as create:
+            resp = await cli.post("/v1/runs", json={"input": "hello", "guest_turn": mark})
+            assert resp.status == 400
+            assert (await resp.json())["error"]["code"] == "invalid_guest_turn"
+    create.assert_not_called()
+    assert adapter._run_statuses == {}
+
+
+def _session_host(body):
+    host = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    host._get_existing_session_or_404 = AsyncMock(return_value=({"id": "bot-1"}, None))
+    host._read_json_body = AsyncMock(return_value=(body, None))
+    host._effective_session_runtime_request = MagicMock(return_value={})
+    host._runtime_lock_error = MagicMock(return_value=None)
+    host._persist_session_runtime_lock = MagicMock(return_value=True)
+    host._stored_session_model = MagicMock(return_value=None)
+    host._resolve_route = MagicMock(return_value=None)
+    host._request_route_conflict_error = MagicMock(return_value=None)
+    return host
+
+
+def _request():
+    return make_mocked_request("POST", "/api/sessions/bot-1/chat", match_info={"session_id": "bot-1"})
+
+
+@pytest.mark.asyncio
+async def test_a_marked_session_chat_carries_the_mark_and_stays_here():
+    host = _session_host({"message": "Message from Vie (Alex): bonjour", "guest_turn": MARK})
+    ctx, err = await host._prepare_session_chat(_request())
+    assert err is None
