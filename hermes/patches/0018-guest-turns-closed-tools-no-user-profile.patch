@@ -0,0 +1,172 @@
+"""Guest turns (BipAgents patch 0018): someone other than the agent's person writes the turn, which gets only its
+listed tools, no USER.md and no memory writes."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent import guest_turn
+
+
+def _tool(name):
+    return {"type": "function", "function": {"name": name, "description": name, "parameters": {"type": "object"}}}
+
+
+# Hermes' own tools that reach the person's data or act, and bridge tools reaching it.
+CLOSED = ["terminal", "read_file", "write_file", "patch", "search_files", "execute_code", "browser_navigate",
+          "browser_vault_fill", "session_search", "memory", "cronjob", "send_message", "message_agent",
+          "delegate_task", "skill_view", "skill_manage", "skills_list", "todo", "clarify", "tool_search", "tool_call",
+          "mcp__bipagents__mail_search", "mcp__bipagents__calendar_list", "mcp__bipagents__contacts_search"]
+ALLOWED = ["mcp__bipagents__knowledge_search", "mcp__bipagents__weather", "web_search"]
+MARK = {"tools": ALLOWED + ["mcp__bipagents__map_image"]}
+
+
+class _Store:
+    def format_for_system_prompt(self, kind):
+        return {"memory": "MEMORY BLOCK", "user": "USER PROFILE BLOCK"}[kind]
+
+
+def _agent(tools=None):
+    return SimpleNamespace(
+        tools=[_tool(n) for n in (tools or ["terminal", "memory", "session_search", "web_search",
+                                            "mcp__bipagents__weather", "mcp__bipagents__mail_search", "tool_search"])],
+        valid_tool_names=set(), enabled_toolsets=["terminal", "web", "memory", "mcp-bipagents"],
+        disabled_toolsets=None, _user_profile_enabled=True, _memory_enabled=True, _memory_store=_Store(),
+        _memory_manager=None, skip_context_files=False, load_soul_identity=False, _memory_nudge_interval=10,
+        _skill_nudge_interval=10, skip_background_review=False)
+
+
+@pytest.fixture
+def catalog(monkeypatch):
+    """The raw catalog: knowledge_search is deferred behind the tool search in the agent's own list."""
+    import model_tools
+    defs = [_tool(n) for n in CLOSED + ALLOWED]
+    monkeypatch.setattr(model_tools, "get_tool_definitions", lambda **kw: [dict(t) for t in defs])
+    return defs
+
+
+def test_parse_keeps_mcp_names_and_web_search_only():
+    assert guest_turn.parse(None) is None
+    allowed = guest_turn.parse({"tools": ["mcp__bipagents__weather", "web_search", "terminal", "session_search",
+                                          "memory", "tool_search"]})
+    assert allowed == frozenset({"mcp__bipagents__weather", "web_search"})
+    assert guest_turn.parse({"tools": []}) == frozenset()
+
+
+@pytest.mark.parametrize("value", ["web_search", ["web_search"], {"tools": "web_search"}, {"tools": [1]},
+                                   {"tools": ["web search"]}, {"tools": [""]}, {"tools": [], "open": True},
+                                   {"tools": ["mcp__x__y"] * 65}])
+def test_a_malformed_mark_is_refused(value):
+    with pytest.raises(guest_turn.GuestTurnError):
+        guest_turn.parse(value)
+
+
+def test_apply_keeps_only_the_listed_tools_in_view(catalog):
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    names = [t["function"]["name"] for t in agent.tools]
+    # knowledge_search was behind the tool search: in view now; map_image isn't enabled here: absent
+    assert sorted(names) == sorted(ALLOWED)
+    assert agent.valid_tool_names == set(ALLOWED)
+    for closed in CLOSED:
+        assert closed not in agent.valid_tool_names
+
+
+def test_apply_drops_the_profile_and_every_memory_write(catalog):
+    manager = MagicMock()
+    agent = _agent()
+    agent._memory_manager = manager
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    assert agent._user_profile_enabled is False and agent._memory_enabled is True
+    assert agent.skip_context_files is True and agent.load_soul_identity is True
+    assert agent._memory_nudge_interval == 0 and agent._skill_nudge_interval == 0
+    assert agent.skip_background_review is True
+    assert agent._memory_manager is None
+    manager.shutdown_all.assert_called_once()
+    from agent.system_prompt import _memory_parts
+    # MEMORY.md (the agent's notes) stays, USER.md (the person's profile) is out
+    assert _memory_parts(agent) == ["MEMORY BLOCK"]
+
+
+def test_the_owners_turn_keeps_the_profile():
+    from agent.system_prompt import _memory_parts
+    assert _memory_parts(_agent()) == ["MEMORY BLOCK", "USER PROFILE BLOCK"]
+
+
+def test_narrow_undoes_any_merge_and_requests_send_the_guests_tools_only(catalog):
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    agent.tools.append(_tool("message_agent"))  # e.g. a Bot Chat injection or a pinned tools[] merge
+    agent.valid_tool_names.add("message_agent")
+    sent = guest_turn.request_tools(agent, agent.tools)
+    assert [t["function"]["name"] for t in sent] == [t["function"]["name"] for t in agent.tools[:-1]]
+    guest_turn.narrow(agent)
+    assert "message_agent" not in agent.valid_tool_names
+    assert guest_turn.request_tools(agent, [_tool("terminal")]) is None
+    owner = _agent()
+    assert guest_turn.request_tools(owner, owner.tools) is owner.tools
+
+
+def test_the_dispatcher_refuses_any_other_tool(catalog):
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    for name in CLOSED:
+        assert guest_turn.refusal(agent, name) == guest_turn.REFUSAL
+    for name in ALLOWED:
+        assert guest_turn.refusal(agent, name) is None
+    assert guest_turn.refusal(_agent(), "terminal") is None  # the person's own turn: untouched
+
+
+def test_invoke_tool_returns_the_refusal_without_running_anything(catalog, monkeypatch):
+    from agent import agent_runtime_helpers
+    import model_tools
+    ran = []
+    monkeypatch.setattr(model_tools, "handle_function_call", lambda *a, **k: ran.append(a) or "{}")
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    result = agent_runtime_helpers.invoke_tool(agent, "terminal", {"command": "cat ~/.ssh/id_rsa"}, "task-1")
+    assert json.loads(result) == {"error": guest_turn.REFUSAL}
+    assert ran == []
+
+
+def test_the_policy_gate_blocks_before_plugins_and_dispatch(catalog, monkeypatch):
+    from agent import tool_executor
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    agent._tool_guardrails = MagicMock()
+    hooks = []
+    monkeypatch.setattr(tool_executor, "_pre_tool_block", lambda *a: hooks.append(a) or (None, {}))
+    state = tool_executor._ManagedToolResult(result=None, args={}, middleware_trace=[], blocked=False,
+                                             dispatched=True)
+    ref = tool_executor._ToolCallRef("session_search", {"query": "Alex"}, "task-1", "call-1", [])
+    monkeypatch.setattr(ref, "emit_post", lambda *a, **k: None, raising=False)
+    executed = []
+    result = tool_executor._dispatch_authorized_once(
+        agent, state, ref, execute=lambda args: executed.append(args), scope_block=None, display_index=None,
+        begin_execution=None, authorization_gate=None)
+    assert json.loads(result) == {"error": guest_turn.REFUSAL}
+    assert state.blocked is True and executed == [] and hooks == []
+
+
+def test_the_turns_prompt_is_built_fresh_and_never_stored(catalog):
+    from agent.conversation_loop import _restore_or_build_system_prompt
+    agent = _agent()
+    guest_turn.apply(agent, guest_turn.parse(MARK))
+    agent._session_db = MagicMock()
+    agent._session_db.get_session.return_value = {"system_prompt": "OWNER PROMPT WITH USER PROFILE BLOCK"}
+    agent.tools.append(_tool("terminal"))
+    seen = {}
+
+    def build(system_message):
+        seen["tools"] = set(agent.valid_tool_names)
+        return "GUEST PROMPT"
+
+    agent._build_system_prompt = build
+    agent._cached_system_prompt = None
+    _restore_or_build_system_prompt(agent, None, [{"role": "user", "content": "hi"}])
+    assert agent._cached_system_prompt == "GUEST PROMPT"
+    assert seen["tools"] == set(ALLOWED)  # the prompt describes the guest's tools only
+    agent._session_db.get_session.assert_not_called()
+    agent._session_db.update_system_prompt.assert_not_called()
