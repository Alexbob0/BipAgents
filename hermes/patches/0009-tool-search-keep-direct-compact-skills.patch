diff --git a/tests/agent/test_tool_search_keep_direct_compact_skills.py b/tests/agent/test_tool_search_keep_direct_compact_skills.py
new file mode 100644
index 0000000000000000000000000000000000000000..cadde375ff73f0dea1b7a7bda99a9c468945be52
--- /dev/null
+++ b/tests/agent/test_tool_search_keep_direct_compact_skills.py
@@ -0,0 +1,48 @@
+"""BipAgents patch 0009: ``!<name>`` in ``tools.tool_search.defer`` keeps a tool direct (an MCP tool
+included), and ``skills.compact_categories`` lists those categories by name only in the skills index."""
+
+import pytest
+
+from agent import prompt_builder
+from agent.prompt_builder import build_skills_system_prompt
+from tools import tool_search
+from tools.tool_search import is_deferrable_tool_name
+
+
+@pytest.fixture
+def mcp_tools(monkeypatch):
+    """Every ``mcp__<server>__<tool>`` name registered under its server's ``mcp-<server>`` toolset."""
+    monkeypatch.setattr(tool_search, "_registry_toolset",
+                        lambda name: "mcp-" + name.split("__")[1] if name.startswith("mcp__") else None)
+
+
+def test_bang_entry_keeps_an_mcp_tool_direct(mcp_tools):
+    name = "mcp__bipagents__notes_search"
+    assert is_deferrable_tool_name(name, frozenset()) is True   # an MCP tool defers by default
+    assert is_deferrable_tool_name(name, frozenset({"!" + name})) is False
+    # Only that tool: another MCP tool of the same server still defers.
+    assert is_deferrable_tool_name("mcp__bipagents__other", frozenset({"!" + name})) is True
+
+
+def test_a_list_without_bang_entries_behaves_as_before(mcp_tools):
+    assert is_deferrable_tool_name("mcp__x__y", frozenset({"web_search"})) is True
+    assert is_deferrable_tool_name("web_search", frozenset({"web_search"})) is True
+    assert is_deferrable_tool_name("web_search", frozenset({"!web_search"})) is False
+
+
+def test_configured_compact_categories_list_skills_by_name_only(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    for category, name, description in (("music", "song-maker", "Compose a song"),
+                                        ("notes", "note-taker", "Take careful notes")):
+        folder = tmp_path / "skills" / category / name
+        folder.mkdir(parents=True)
+        (folder / "SKILL.md").write_text(f"---\nname: {name}\ndescription: {description}\n---\n")
+    prompt_builder.clear_skills_system_prompt_cache(clear_snapshot=True)
+    full = build_skills_system_prompt()
+    assert "Compose a song" in full and "Take careful notes" in full
+
+    monkeypatch.setattr(prompt_builder, "_config_readonly",
+                        lambda what: {"skills": {"compact_categories": ["music"]}})
+    compact = build_skills_system_prompt()
+    assert "song-maker" in compact and "Compose a song" not in compact   # name only, still loadable
+    assert "Take careful notes" in compact                                # other categories whole
