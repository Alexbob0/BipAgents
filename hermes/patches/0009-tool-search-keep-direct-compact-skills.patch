+++ b/agent/prompt_builder.py
@@ -1364,10 +1364,24 @@ def _oneshot_prompt_variant() -> bool:
     return is_single_query_session()
 
 
+def _configured_compact_categories() -> frozenset:
+    """``skills.compact_categories`` of this profile's config (a list of top-level category names)."""
+    skills_cfg = _config_readonly("skills.compact_categories").get("skills")
+    raw = skills_cfg.get("compact_categories") if isinstance(skills_cfg, dict) else None
+    if not isinstance(raw, (list, tuple, set)):
+        return frozenset()
+    return frozenset(str(c).strip() for c in raw if str(c).strip())
+
+
 def _build_skills_system_prompt_inner(
     skills_dir: Path, extra_roots: list[tuple[int, Path]], available_tools: set[str] | None,
     available_toolsets: set[str] | None, compact_categories: frozenset[str] | None,
 ) -> str:
+    # ``skills.compact_categories`` (BipAgents): categories this profile rarely needs, listed by name only
+    # like the coding posture's — their skills still load with skill_view.
+    configured = _configured_compact_categories()
+    if configured:
+        compact_categories = frozenset(compact_categories or ()) | configured
     # The resolved platform is part of the key: per-platform disabled-skill lists need distinct cache entries.
     _platform_hint = _current_session_platform_hint()
     disabled = get_disabled_skill_names(_platform_hint or None)
diff --git a/tests/agent/test_tool_search_keep_direct_compact_skills.py b/tests/agent/test_tool_search_keep_direct_compact_skills.py
