+def _configured_compact_categories() -> frozenset:
+    """``skills.compact_categories`` of this profile's config (a list of top-level category names)."""
+    skills_cfg = _config_readonly("skills.compact_categories").get("skills")
+    raw = skills_cfg.get("compact_categories") if isinstance(skills_cfg, dict) else None
+    if not isinstance(raw, (list, tuple, set)):
+        return frozenset()
+    return frozenset(str(c).strip() for c in raw if str(c).strip())
