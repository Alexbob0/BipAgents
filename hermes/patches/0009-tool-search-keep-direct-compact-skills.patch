 def _build_skills_system_prompt_inner(
     skills_dir: Path, extra_roots: list[tuple[int, Path]], available_tools: set[str] | None,
     available_toolsets: set[str] | None, compact_categories: frozenset[str] | None,
 ) -> str:
+    # ``skills.compact_categories`` (BipAgents): categories this profile rarely needs, listed by name only
+    # like the coding posture's — their skills still load with skill_view.
+    configured = _configured_compact_categories()
+    if configured:
