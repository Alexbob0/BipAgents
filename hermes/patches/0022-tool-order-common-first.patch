index 0000000000000000000000000000000000000000..05affc1ec9fb0cda370c91fe67d918b64848d9ad
--- /dev/null
+++ b/tools/tool_order.py
@@ -0,0 +1,52 @@
+"""One canonical order for the model's tool list (BipAgents patch 0022).
+
+The tools are rendered ahead of the conversation, so a provider's prompt cache is shared only as far as two tool
+lists are byte-identical. ``tools.order_first`` (a list of tool names in config.yaml) puts those tools first, in
+that order; every other tool follows, sorted by name. A tool that arrives later in a live session is inserted at
+its canonical place, never appended: the session's list then stays the one every new session builds, so a new
+conversation (or another agent with the same common tools) reads the whole common prefix from the cache.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def configured_first() -> list[str]:
+    """``tools.order_first`` of this profile's config (empty on any failure)."""
+    try:
+        import hermes_cli.config as _cfg_mod
+        tools_cfg = (_cfg_mod.load_config_readonly() or {}).get("tools")
+        raw = tools_cfg.get("order_first") if isinstance(tools_cfg, dict) else None
+    except Exception:
+        return []
+    if not isinstance(raw, (list, tuple)):
+        return []
+    return [str(n).strip() for n in raw if str(n).strip()]
+
+
+def _name(entry: Any) -> str:
+    fn = entry.get("function") if isinstance(entry, dict) else None
+    return str((fn or {}).get("name") or "")
+
+
+def order_key(name: str, first: list[str]) -> tuple:
+    """Where ``name`` goes: by its place in ``first``, else after all of them, by name."""
+    return (0, first.index(name), "") if name in first else (1, 0, name)
+
+
+def ordered(tool_defs: list[dict[str, Any]], first: list[str] | None = None) -> list[dict[str, Any]]:
+    """``tool_defs`` in the canonical order (a stable sort: same names, same order)."""
+    first = configured_first() if first is None else first
+    return sorted(tool_defs, key=lambda t: order_key(_name(t), first))
+
+
+def insert_in_order(tool_defs: list, entry: dict[str, Any], first: list[str] | None = None) -> None:
+    """``entry`` inserted before the first tool that sorts after it (appended only when none does)."""
+    first = configured_first() if first is None else first
+    key = order_key(_name(entry), first)
+    for index, existing in enumerate(tool_defs):
+        if order_key(_name(existing), first) > key:
+            tool_defs.insert(index, entry)
+            return
+    tool_defs.append(entry)
