+"""BipAgents patch 0022: one canonical tool order (``tools.order_first``, then by name), kept by later arrivals."""
+
+from tools import tool_order
+from tools.tool_order import insert_in_order, ordered
+
+
+def _defs(*names):
+    return [{"type": "function", "function": {"name": n, "description": n}} for n in names]
+
+
+def _names(defs):
+    return [d["function"]["name"] for d in defs]
+
+
+FIRST = ["clarify", "mcp__bipagents__create_page", "memory", "tool_call"]
+
+
+def test_common_tools_first_then_by_name():
+    defs = _defs("web_search", "tool_call", "browser_vault", "memory", "clarify", "execute_code",
+                 "mcp__bipagents__create_page", "mcp__bipagents__health")
+    assert _names(ordered(defs, FIRST)) == [
+        "clarify", "mcp__bipagents__create_page", "memory", "tool_call",
+        "browser_vault", "execute_code", "mcp__bipagents__health", "web_search"]
+
+
+def test_two_agents_share_the_common_prefix_byte_for_byte():
+    one = ordered(_defs("memory", "clarify", "tool_call", "mcp__bipagents__health", "mcp__bipagents__create_page"), FIRST)
+    two = ordered(_defs("tool_call", "execute_code", "clarify", "memory", "mcp__bipagents__create_page"), FIRST)
+    assert repr(one[:4]) == repr(two[:4])
+    assert ordered(list(reversed(one)), FIRST) == one  # the same list from any order (two starts)
+
+
+def test_a_later_tool_takes_its_place_never_the_tail():
+    live = ordered(_defs("clarify", "memory", "tool_call", "execute_code", "web_search"), FIRST)
+    insert_in_order(live, _defs("mcp__bipagents__create_page")[0], FIRST)
+    insert_in_order(live, _defs("patch")[0], FIRST)
+    insert_in_order(live, _defs("zz_last")[0], FIRST)
+    assert _names(live) == _names(ordered(live, FIRST))
+    assert _names(live)[1] == "mcp__bipagents__create_page" and _names(live)[-1] == "zz_last"
+
+
+def test_without_a_list_plain_name_order(monkeypatch):
+    monkeypatch.setattr(tool_order, "configured_first", lambda: [])
+    assert _names(ordered(_defs("b", "a", "c"))) == ["a", "b", "c"]
