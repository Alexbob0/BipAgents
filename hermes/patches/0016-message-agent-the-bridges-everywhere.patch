+def has_mcp_message_agent(tools: Any) -> bool:
+    """Whether an MCP server offers its own ``message_agent`` among ``tools``. Never raises."""
+    try:
+        return isinstance(tools, list) and any(
+            isinstance(t, dict) and _is_mcp_message_agent(t.get("function", {}).get("name")) for t in tools
+        )
+    except Exception:  # pragma: no cover — must never break a turn
+        return False
+
