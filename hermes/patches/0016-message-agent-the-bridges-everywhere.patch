+"""BipAgents 0012 + 0016: where an MCP server offers its own ``message_agent`` (``mcp__bipagents__message_agent``,
+BipAgents' bridge, in every conversation: it answers in the two agents' own conversation, not in the
+target's Bot Chat), the built-in is not injected, even in a Bot Chat, so the model sees one way to write to
+an agent. Without such an MCP tool the built-in behaves as upstream."""
+
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from tools import bot_mode_dm, bot_mode_probe
+from tools.mcp_tool_agent import _reinject_authorized_dynamic_tools
+
+BRIDGE = "mcp__bipagents__message_agent"
+BUILTIN = bot_mode_dm.MESSAGE_AGENT_TOOL_NAME
+
+
+@pytest.fixture(autouse=True)
+def _fresh_probe_cache():
+    bot_mode_probe._reset_cache_for_tests()
+    yield
+    bot_mode_probe._reset_cache_for_tests()
+
+
+def _managed_home(tmp_path) -> Path:
+    home = tmp_path / ".hermes"
+    d = home / "profiles" / "coach"
+    d.mkdir(parents=True)
+    (d / "profile.yaml").write_text(
+        textwrap.dedent(
+            """\
+            description: teammate
+            ui_meta:
+              hermes-bots:
+                shape: cloud
+            """
+        ),
+        encoding="utf-8",
+    )
+    return home
+
+
+class _FakeDB:
+    def __init__(self, home: Path, title: str):
+        self.db_path = str(home / "state.db")
+        self._title = title
+
+    def get_session_title(self, _sid):
+        return self._title
+
+
+class _FakeAgent:
+    def __init__(self, home: Path, title: str, names=(BRIDGE, "mcp__bipagents__health")):
+        self._session_db = _FakeDB(home, title)
+        self.session_id = "sess-1"
+        self._session_title_hint = None
+        self._bot_mode_protocol = True
+        self.tools = [_schema(n) for n in names]
+        self.valid_tool_names = set(names)
+
+
+def _schema(name: str) -> dict:
+    return {"type": "function", "function": {"name": name, "parameters": {"type": "object"}}}
+
+
+def _names(tools) -> list:
+    return [t["function"]["name"] for t in tools]
+
+
+def test_bot_chat_keeps_only_the_bridges(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat")
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == [BRIDGE, "mcp__bipagents__health"]
+    assert BUILTIN not in agent.valid_tool_names
+    # the next turn changes nothing (prompt-cache stable)
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == [BRIDGE, "mcp__bipagents__health"]
+
+
+def test_a_stale_builtin_goes_once_the_bridges_is_listed(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat", names=(BUILTIN, BRIDGE))
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == [BRIDGE]
+    assert agent.valid_tool_names == {BRIDGE}
+
+
+def test_without_the_bridges_the_builtin_is_injected(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat", names=("mcp__bipagents__health",))
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is True
+    assert _names(agent.tools) == ["mcp__bipagents__health", BUILTIN]
+    assert BUILTIN in agent.valid_tool_names
+
+
+def test_other_conversations_keep_the_mcp_one(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Courses de la semaine")
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == [BRIDGE, "mcp__bipagents__health"]
+    assert BRIDGE in agent.valid_tool_names
+
+
+def test_an_mcp_rebuild_in_the_bot_chat_does_not_bring_the_builtin_back(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat")
+    staged, names = [_schema(BRIDGE), _schema("mcp__bipagents__health")], {BRIDGE, "mcp__bipagents__health"}
+    _reinject_authorized_dynamic_tools(agent, staged, names)
+    assert _names(staged) == [BRIDGE, "mcp__bipagents__health"]
+    assert BUILTIN not in names
+
+
+def test_an_mcp_rebuild_without_the_bridges_keeps_the_builtin(tmp_path):
+    agent = _FakeAgent(_managed_home(tmp_path), "Bot Chat")
+    staged, names = [_schema("mcp__bipagents__health")], {"mcp__bipagents__health"}
+    _reinject_authorized_dynamic_tools(agent, staged, names)
+    assert _names(staged) == ["mcp__bipagents__health", BUILTIN]
+
+
+def test_only_mcp_tools_named_message_agent_count():
+    assert bot_mode_dm.has_mcp_message_agent([_schema("mcp__x__message_agent")])
+    assert not bot_mode_dm.has_mcp_message_agent([_schema("message_agent_log"), _schema("mcp__x__message_agents")])
+    assert not bot_mode_dm.has_mcp_message_agent(None)
+
+
+def test_a_deferred_bridge_message_agent_keeps_the_builtin_out(tmp_path, monkeypatch):
+    """The bridge's message_agent behind the tool search (the 3 November lab: Prof's Bot Chat got the built-in,
+    its other conversations had none, 7.8k tokens of prompt cache lost between them): the Bot Chat gets the same
+    tool list as the agent's other conversations."""
+    from agent import tool_executor
+    monkeypatch.setattr(tool_executor, "_tool_search_scoped_names", lambda agent: frozenset({BRIDGE, "mcp__x__y"}))
+    home = _managed_home(tmp_path)
+    agent = _FakeAgent(home, "Bot Chat", names=("mcp__bipagents__health", "tool_call"))
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is False
+    assert _names(agent.tools) == ["mcp__bipagents__health", "tool_call"]
+    staged, names = [_schema("mcp__bipagents__health"), _schema("tool_call")], {"mcp__bipagents__health", "tool_call"}
+    _reinject_authorized_dynamic_tools(agent, staged, names)
+    assert BUILTIN not in names
+    # Without the tool search (no tool_call), the deferred set is not looked at.
+    monkeypatch.setattr(tool_executor, "_tool_search_scoped_names", lambda agent: frozenset())
+    agent = _FakeAgent(home, "Bot Chat", names=("mcp__bipagents__health", "tool_call"))
+    assert bot_mode_dm.ensure_message_agent_tool(agent) is True
