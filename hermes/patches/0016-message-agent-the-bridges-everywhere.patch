+def drop_builtin_message_agent(tools: Any, names: Optional[set] = None) -> None:
+    """Where an MCP server offers its own ``message_agent`` (BipAgents' bridge: it answers in the two
+    agents' own conversation, not in the target's Bot Chat), the built-in goes from ``tools`` (and
+    ``names``), so the model sees one way to write to an agent, not two. Never raises."""
+    try:
