+def _is_mcp_message_agent(name: Any) -> bool:
+    """An MCP server's own ``message_agent`` (``mcp__<server>__message_agent``: BipAgents' bridge offers
+    one in every conversation, since the built-in reaches the Bot Chat only)."""
+    return isinstance(name, str) and name.startswith("mcp__") and name.endswith("__message_agent")
+
+
+def has_mcp_message_agent(tools: Any) -> bool:
+    """Whether an MCP server offers its own ``message_agent`` among ``tools``. Never raises."""
+    try:
+        return isinstance(tools, list) and any(
+            isinstance(t, dict) and _is_mcp_message_agent(t.get("function", {}).get("name")) for t in tools
+        )
+    except Exception:  # pragma: no cover — must never break a turn
+        return False
+
+
+def mcp_message_agent_offered(agent: Any, tools: Any) -> bool:
+    """Whether an MCP server's own ``message_agent`` is in the session: in ``tools``, or behind the tool search
+    (deferred: reached with ``tool_call``). A deferred one counts too, so a Bot Chat whose bridge ``message_agent``
+    is deferred does not get the built-in that its other conversations lack (one tool list for every conversation
+    of an agent, so their prompt prefix is shared). Never raises."""
+    if has_mcp_message_agent(tools):
+        return True
+    try:
+        names = {t.get("function", {}).get("name") for t in tools if isinstance(t, dict)} if isinstance(tools, list) else set()
+        if "tool_call" not in names:
+            return False
+        from agent.tool_executor import _tool_search_scoped_names
+        return any(_is_mcp_message_agent(n) for n in _tool_search_scoped_names(agent))
+    except Exception:  # pragma: no cover — must never break a turn
+        return False
+
+
+def drop_builtin_message_agent(tools: Any, names: Optional[set] = None) -> None:
+    """Where an MCP server offers its own ``message_agent`` (BipAgents' bridge: it answers in the two
+    agents' own conversation, not in the target's Bot Chat), the built-in goes from ``tools`` (and
+    ``names``), so the model sees one way to write to an agent, not two. Never raises."""
+    try:
+        if isinstance(tools, list):
+            tools[:] = [
+                t for t in tools
+                if not (isinstance(t, dict) and t.get("function", {}).get("name") == MESSAGE_AGENT_TOOL_NAME)
+            ]
+        if isinstance(names, set):
+            names.discard(MESSAGE_AGENT_TOOL_NAME)
+    except Exception:  # pragma: no cover — must never break a turn
+        logger.debug("drop_builtin_message_agent failed", exc_info=True)
+
+
 def ensure_message_agent_tool(agent: Any) -> bool:
     """Inject the ``message_agent`` schema into a Bot Chat agent's tool list (once per turn).
     Idempotent and deterministic for the session's life (the gate is stable from the
@@ -149,6 +198,10 @@ def ensure_message_agent_tool(agent: Any) -> bool:
         if not getattr(agent, "_bot_mode_protocol", True):
             return False
         tools = getattr(agent, "tools", None)
+        if mcp_message_agent_offered(agent, tools):
+            # BipAgents 0016: the bridge's own message_agent stays, the built-in goes (stale copies too).
+            drop_builtin_message_agent(tools, getattr(agent, "valid_tool_names", None))
+            return False
         present = bool(tools) and any(
             isinstance(t, dict) and t.get("function", {}).get("name") == MESSAGE_AGENT_TOOL_NAME
             for t in tools
