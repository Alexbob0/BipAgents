+def _json_object(value: Any) -> Any:
+    """A JSON string decoded (a model may send ``calls`` or an entry's ``arguments`` as one), else the value."""
+    if isinstance(value, str) and value.strip()[:1] in ("{", "["):
+        try:
+            return json.loads(value)
+        except ValueError:
+            return value
+    return value
+
+
+def _call_entries(args: dict[str, Any]) -> list[Any]:
+    """The entries of a ``tool_call`` in every shape its dispatcher runs (``normalize_tool_call_entries``): a list, a
+    JSON string of one, a single object, or the legacy ``{name, arguments}``. Reading only the list labelled a call
+    sent as a string « Unnamed call » while it ran under its own name."""
+    entries = _json_object(args.get("calls"))
+    if isinstance(entries, dict):
+        entries = [entries]
+    return entries if isinstance(entries, list) else [args]
