diff --git a/tests/tools/test_cronjob_session_reports.py b/tests/tools/test_cronjob_session_reports.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff805b3871e703ac6433769fdcd65cfcece188af
--- /dev/null
+++ b/tests/tools/test_cronjob_session_reports.py
@@ -0,0 +1,156 @@
+"""A routine made in a Runs API conversation reports back to it (when the client says it shows reports there), its
+results read plainly by the model, its instructions as long as a real multi-step task, and the call's label names the
+tool even when the model sends ``calls`` as a JSON string.
+
+2026-10-31: « mets un schedule ce soir à 23h pour corriger tout le carnet » made a local-only job; the create result told
+the model to set ``deliver='telegram'`` or ``'all'``, which it did and narrated (« livraison locale uniquement »), and
+the app showed the call as « Unnamed call »."""
+
+import importlib
+import json
+
+import pytest
+
+from tools.cronjob_tools import cronjob
+
+_SESSION = "20261031_213955_a1b2c3"
+
+
+@pytest.fixture(autouse=True)
+def _cron_dir(tmp_path, monkeypatch):
+    monkeypatch.setattr("cron.jobs.CRON_DIR", tmp_path / "cron")
+    monkeypatch.setattr("cron.jobs.JOBS_FILE", tmp_path / "cron" / "jobs.json")
+    monkeypatch.setattr("cron.jobs.OUTPUT_DIR", tmp_path / "cron" / "output")
+    for var in ("HERMES_SESSION_PLATFORM", "HERMES_SESSION_CHAT_ID", "HERMES_SESSION_THREAD_ID",
+                "HERMES_SESSION_CHAT_NAME", "HERMES_CRON_SESSION"):
+        monkeypatch.delenv(var, raising=False)
+    import gateway.session_context as context
+
+    monkeypatch.setattr(context, "_session_context_engaged", False)
+    tokens = context.set_session_vars()
+    yield
+    context.clear_session_vars(tokens)
+    # cleared vars read "" and win over os.environ: unset them, as later tests read HERMES_CRON_SESSION from there
+    for var in (*context._VAR_MAP.values(), context._SESSION_ASYNC_DELIVERY, context._SESSION_HISTORY_DELIVERY):
+        var.set(context._UNSET)
+
+
+def _config(monkeypatch, session_reports):
+    cfg = {"cron": {"session_reports": True}} if session_reports else {}
+    # The module the code imports at call time (sys.modules), even if another test swapped it in.
+    monkeypatch.setattr(importlib.import_module("hermes_cli.config"), "load_config_readonly", lambda: cfg)
+
+
+def _in_runs_api_session(history=True):
+    """What /v1/runs binds for a turn with a session id (api_server_runs: no push, server history resumed)."""
+    from gateway.session_context import set_session_vars
+
+    set_session_vars(platform="api_server", chat_id=_SESSION, session_id=_SESSION, async_delivery=False,
+                     session_history_delivery="1" if history else "")
+
+
+def test_a_routine_made_in_the_conversation_reports_back_to_it(monkeypatch):
+    from cron.jobs import get_job
+
+    _config(monkeypatch, True)
+    _in_runs_api_session()
+    out = cronjob(action="create", prompt="Relis tout le Carnet et corrige chaque fiche.", schedule="0 23 * * *",
+                  name="Réparer le Carnet")
+    created = json.loads(out)
+    assert created["success"], created
+    job = get_job(created["job_id"])
+    assert job["origin_session_id"] == _SESSION
+    assert job["deliver"] == "local"  # Hermes itself posts nothing: the client takes the report from the run
+    # what the model reads: where it goes, in plain words, and nothing to change
+    assert created["deliver"] == "this conversation"
+    assert created["job"]["deliver"] == "this conversation"
+    assert "comes back to this conversation" in created["message"]
+    for jargon in ("local-only", "telegram", "deliver=", "stateless"):
+        assert jargon not in out
+    listed = json.loads(cronjob(action="list"))
+    assert [j["deliver"] for j in listed["jobs"]] == ["this conversation"]
+
+
+def test_origin_asked_explicitly_is_the_same(monkeypatch):
+    from cron.jobs import get_job
+
+    _config(monkeypatch, True)
+    _in_runs_api_session()
+    created = json.loads(cronjob(action="create", prompt="x", schedule="every 2h", deliver="origin"))
+    assert get_job(created["job_id"])["origin_session_id"] == _SESSION
+    assert get_job(created["job_id"])["deliver"] == "local"
+
+
+def test_asking_for_origin_again_keeps_it_reporting_here(monkeypatch):
+    from cron.jobs import get_job
+
+    _config(monkeypatch, True)
+    _in_runs_api_session()
+    created = json.loads(cronjob(action="create", prompt="x", schedule="every 2h"))
+    updated = json.loads(cronjob(action="update", job_id=created["job_id"], deliver="origin"))
+    assert updated["success"], updated
+    assert get_job(created["job_id"])["deliver"] == "local"
+    assert updated["job"]["deliver"] == "this conversation"
+
+
+def test_another_target_is_left_alone(monkeypatch):
+    from cron.jobs import get_job
+
+    _config(monkeypatch, True)
+    _in_runs_api_session()
+    created = json.loads(cronjob(action="create", prompt="x", schedule="every 2h", deliver="local"))
+    assert "origin_session_id" not in get_job(created["job_id"])
+    assert created["deliver"] == "local"
+
+
+@pytest.mark.parametrize("session_reports,history", [(False, True), (True, False)])
+def test_without_the_clients_word_nothing_changes(monkeypatch, session_reports, history):
+    from cron.jobs import get_job
+
+    _config(monkeypatch, session_reports)
+    _in_runs_api_session(history)
+    created = json.loads(cronjob(action="create", prompt="x", schedule="every 2h"))
+    assert "origin_session_id" not in get_job(created["job_id"])
+    assert created["deliver"] == "local"
+    assert "comes back to this conversation" not in created["message"]
+
+
+def test_instructions_as_long_as_a_real_task_fit_a_pasted_document_does_not(monkeypatch):
+    from cron.jobs import MAX_PROMPT_CHARS, get_job, list_jobs
+
+    _config(monkeypatch, False)
+    step = "Étape : ouvre la fiche suivante du Carnet, vérifie les dates, les noms et les liens, corrige ce qui cloche. "
+    long = (step * (MAX_PROMPT_CHARS // len(step) + 1))[:MAX_PROMPT_CHARS].strip()
+    created = json.loads(cronjob(action="create", prompt=long, schedule="0 23 * * *", name="Carnet"))
+    assert created["success"], created
+    assert get_job(created["job_id"])["prompt"] == long
+
+    refused = json.loads(cronjob(action="create", prompt=long + " " + step, schedule="0 23 * * *"))
+    assert refused["success"] is False
+    assert "too long for a scheduled task" in refused["error"] and "Nothing was saved" in refused["error"]
+    assert len(list_jobs(include_disabled=True)) == 1
+
+    refused = json.loads(cronjob(action="update", job_id=created["job_id"], prompt=long + " " + step))
+    assert refused["success"] is False and "too long" in refused["error"]
+    assert get_job(created["job_id"])["prompt"] == long
+
+
+@pytest.mark.parametrize("args", [
+    {"calls": [{"name": "cronjob_manage", "arguments": {"action": "create"}}]},
+    {"calls": json.dumps([{"name": "cronjob_manage", "arguments": {"action": "create"}}])},
+    {"calls": {"name": "cronjob_manage", "arguments": json.dumps({"action": "create"})}},
+    {"name": "cronjob_manage", "arguments": {"action": "create"}},
+])
+def test_a_tool_call_is_labelled_by_its_tool_in_every_shape_it_runs(args):
+    from tools.tool_labels import labels_for_call
+
+    labels = labels_for_call("tool_call", args)
+    assert [label.name for label in labels] == ["cronjob_manage"]
+    assert "Unnamed" not in labels[0].text
+
+
+def test_a_call_without_a_name_stays_unnamed():
+    from tools.tool_labels import labels_for_call
+
+    assert [label.text for label in labels_for_call("tool_call", {"calls": [{"arguments": {}}]})] == ["Unnamed call"]
+    assert labels_for_call("tool_call", {"calls": []}) == []
