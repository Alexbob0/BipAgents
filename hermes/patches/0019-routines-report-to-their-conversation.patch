+def _origin_session_from_env() -> str:
+    """The Runs API conversation a job is created from, when its client reads the job's reports there; else "".
+
+    An api_server session has no push channel (``_origin_from_env`` drops it), so an omitted ``deliver`` makes a
+    local-only job. A client that resumes the session's server history (``session_history_delivery_supported``, the
+    same declaration async ``delegate_task`` results rely on) and says it shows routine reports in the conversation
+    they came from (``cron.session_reports: true``) gets the session id stamped on the job (``origin_session_id``)."""
+    try:
+        from gateway.session_context import get_session_env, session_history_delivery_supported
+        from hermes_cli.config import cfg_get, load_config_readonly
+        if get_session_env("HERMES_SESSION_PLATFORM", "") != "api_server" or not session_history_delivery_supported():
+            return ""
+        if cfg_get(load_config_readonly(), "cron", "session_reports", default=False) is not True:
+            return ""
+        return str(get_session_env("HERMES_SESSION_CHAT_ID", "") or "").strip()
+    except Exception:
+        logger.debug("cron origin session not read", exc_info=True)
+        return ""
+
+
+# What a job reporting to its conversation shows as its delivery (``deliver`` stays "local": Hermes posts nothing).
+SESSION_REPORT_DELIVERY = "this conversation"
+
+
+def _shown_deliver(job: dict[str, Any]) -> Any:
+    """``deliver`` as the model reads it: a job reporting to the conversation it came from says so, never "local"."""
+    deliver = job.get("deliver", "local")
+    if job.get("origin_session_id") and (not deliver or deliver == "local"):
+        return SESSION_REPORT_DELIVERY
+    return deliver
+
+
