+# A job's instructions at most, in characters (the cronjob tool and the Jobs API). A long multi-step instruction (what
+# to go through, the rules, what to check, how to report) is 2 000 to 8 000; 20 000 (about 5 000 tokens) leaves room
+# for that and more while a pasted document, which belongs in a file or a skill the job reads, is still refused.
+MAX_PROMPT_CHARS = 20_000
+
+
+def prompt_length_error(prompt: str) -> str:
+    """Why a job's instructions are too long, in words a model can act on without narrating it; "" when they fit."""
+    if len(prompt) <= MAX_PROMPT_CHARS:
+        return ""
+    return (f"These instructions are too long for a scheduled task ({len(prompt):,} characters, at most "
+            f"{MAX_PROMPT_CHARS:,}). Keep the goal, the steps and what to check; put long reference material in a file "
+            "the task reads, then try again. Nothing was saved.")
+
 
