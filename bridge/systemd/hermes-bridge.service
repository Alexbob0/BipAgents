# ~/.config/systemd/user/hermes-bridge.service  (systemd --user, aibox user)
# Installation: see bridge/README.md. Code in ~/hermes-bridge (copy of bridge/), venv in ~/hermes-bridge/.venv
[Unit]
Description=BipAgents bridge (per-sentence TTS, voice WS, files, APNs push, ntfy outbox) on 127.0.0.1:8643
After=network-online.target kyutai-tts.service ntfy.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hermes-bridge
Environment=BRIDGE_CONFIG=%h/.config/hermes-ios/bridge.toml
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Paris
ExecStartPre=%h/hermes-bridge/.venv/bin/python -m bipbridge check
ExecStart=%h/hermes-bridge/.venv/bin/python -m bipbridge serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
# Created files: base 027; uploads explicitly get upload_file_mode (640 by default).
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=default.target
