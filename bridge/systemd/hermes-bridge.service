# ~/.config/systemd/user/hermes-bridge.service  (systemd --user)
# Installation: see bridge/README.md. The bridge binary (a release's bipbridge, or cargo build --release in
# bridge-rs/) in ~/.local/bin.
[Unit]
Description=BipAgents bridge (per-sentence TTS, voice WS, files, APNs push, ntfy outbox) on 127.0.0.1:8643
After=network-online.target kyutai-tts.service ntfy.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=BRIDGE_CONFIG=%h/.config/hermes-ios/bridge.toml
Environment=TZ=Europe/Paris
ExecStartPre=%h/.local/bin/bipbridge check
ExecStart=%h/.local/bin/bipbridge serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
# Created files: base 027; uploads explicitly get upload_file_mode (640 by default).
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=default.target
